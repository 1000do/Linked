DB_HOST=db
DB_PORT=5432
DB_NAME=linked
DB_USER=postgres
DB_PASSWORD=your_db_password

JWT_KEY=your_jwt_secret_key
JWT_ISSUER=CourseMarketplaceBE
JWT_AUDIENCE=CourseMarketplaceUser
JWT_DURATION=1440

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=course_marketplace_preset

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_ENABLESSL=true
EMAIL_EMAIL=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

FRONTEND_BASE_URL=http://localhost:5208
ALLOWED_ORIGINS=http://localhost:5208,http://localhost:5207
ASPNETCORE_ENVIRONMENT=Development
NGROK_TOKEN=your_ngrok_token

STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_CONNECT_WEBHOOK_SECRET=your_stripe_webhook_secret

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# AI Moderation Service Configuration

# Server
AI_DEBUG=false
AI_HOST=0.0.0.0
AI_PORT=8000
AI_LOG_LEVEL=INFO
HF_TOKEN=your_huggingface_token

# Models - HARDCODE VALUE - DO NOT CHANGE
SPAM_MODEL_PATH=ki4n-4nt/spam_text_classifier
TOXIC_MODEL_PATH=ki4n-4nt/toxic_text_classifier
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
TEXT_EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
WHISPER_MODEL_NAME=small

# Embeddings - HARDCODE VALUE - DO NOT CHANGE
MEDIA_EMBEDDING_DIM=512
TEXT_EMBEDDING_DIM=384

# Timeouts (seconds)
REQUEST_TIMEOUT=1800

# Device (cpu, cuda)
DEVICE=cpu
