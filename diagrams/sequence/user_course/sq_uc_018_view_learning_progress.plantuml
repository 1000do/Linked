@startuml
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300

        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox
mainframe View Learning Progress

actor User as act
participant "CourseLearnSidebar" as view
participant "LoginPage" as login_view
participant "ErrorPage" as error_view
participant "CourseController" as fe_ctrl <<frontend controller>>
participant "EnrollmentController" as be_ctrl <<backend controller>>
participant ":EnrollmentService" as sv
participant ":ProgressResponse" as res
participant ":IEnrollmentRepository" as repo
participant ":ICourseRepository" as course_repo
participant ":AppDbContext" as ctx
database Database as db

act ++
act -> view++: View learning progress
view -> fe_ctrl++: GET /Course/Learn/{id}

fe_ctrl -> fe_ctrl++: Validate actor's authentication and authorization
fe_ctrl--

alt Session Invalid
    fe_ctrl -->> login_view: Redirect to LoginPage
    activate login_view
    login_view -->> act: Display login form
else Unauthorized Access
    fe_ctrl -->> error_view: Redirect to ErrorPage
    activate error_view
    error_view -->> act: Display error message
else Valid actor's authentication and authorization
    fe_ctrl -> be_ctrl++: GET /api/enrollment/progress/{courseId}
    be_ctrl -> sv++: Call GetProgressAsync(userId, courseId)

sv -> repo++: Call GetEnrollmentAsync(userId, courseId)
repo -> ctx++: Query data from DbSet
ctx -> db++: Execute query
db -->> ctx--: Return query results
ctx -->> repo--: Return enrollment entity
repo -->> sv--: Return enrollment entity


sv -> sv++: Check condition: Enrollment == null
sv--

alt Enrollment == null
    sv -> sv++: Check Instructor Bypass
    sv--
    alt Is Instructor
        sv -> course_repo++: Call GetCourseStatsAsync(courseId)
        course_repo -> ctx++: Query data from DbSet
        ctx -> db++: Execute query
        db -->> ctx--: Return query results
        ctx -->> course_repo--: Return course stats
        course_repo -->> sv--: Return course stats
        
        sv -> res++: Call ProgressResponse()
        res -->> sv--: Return ProgressResponse object (mocked full progress)
        sv -->> be_ctrl: Return ProgressResponse object
    else Not Instructor
        sv -->> be_ctrl: Return null
    end
else Enrollment != null
    sv -> course_repo++: Call GetCourseStatsAsync(courseId)
    course_repo -> ctx++: Query data from DbSet
    ctx -> db++: Execute query
    db -->> ctx--: Return query results
    ctx -->> course_repo--: Return course stats
    course_repo -->> sv--: Return course stats

    sv -> repo++: Call GetCompletedMaterialCountAsync(enrollmentId)
    repo -> ctx++: Query data from DbSet
    ctx -> db++: Execute query
    db -->> ctx--: Return query results
    ctx -->> repo--: Return completed count
    repo -->> sv--: Return completed count
    
    sv -> repo++: Call GetCompletedMaterialIdsAsync(enrollmentId)
    repo -> ctx++: Query data from DbSet
    ctx -> db++: Execute query
    db -->> ctx--: Return query results
    ctx -->> repo--: Return completed ids
    repo -->> sv--: Return completed material ids
    
    sv -> res++: Call ProgressResponse()
    res -->> sv--: Return ProgressResponse object
    sv -->> be_ctrl--: Return ProgressResponse object
end

be_ctrl -> be_ctrl++: Check condition: Progress == null
be_ctrl--

alt Progress == null
    be_ctrl -->> fe_ctrl: Return statusCode 404
    fe_ctrl -->> view: Return JSON (success=false)
    view -->> act: Display error message
else Progress != null
    be_ctrl -->> fe_ctrl--: Return statusCode 200
    fe_ctrl -->> view--: Return JSON (success=true)
    view -->> act--: Display learning progress
end

end
