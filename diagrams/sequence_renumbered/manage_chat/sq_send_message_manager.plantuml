@startuml
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300

        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox

mainframe Send Messages (Manager)

actor Staff as act
participant "ChatIndexPage" as view
participant "LoginPage" as login_view
participant "ErrorPage" as error_page
participant "ChatController" as fe_ctrl <<frontend controller>>
participant "ChatController" as be_ctrl <<backend controller>>
participant "ChatAttachmentController" as be_att_ctrl <<backend controller>>
participant ":ICloudinaryUploadService" as upload_sv
participant "ChatHub" as hub
participant ":IChatService" as sv
participant ":Message" as msg_ett
participant ":MessageAttachment" as msg_att_ett
participant ":MessageDto" as msg_dto
participant ":IChatRepository" as repo
participant ":IUserRepository" as user_repo
participant ":IRedisService" as redis
participant ":AppDbContext" as ctx
database Database as db

act++

act->view++:1. Enter message text
act->view:2. Select files (Optional)
act->view:3. Click "Send" button (or press Enter)

view -> view++:4. Check attachment selection
view--

opt With Attachments
loop for each selected file f
        view->fe_ctrl++:4.1. POST /Chat/UploadAttachment
        
        fe_ctrl -> fe_ctrl++:4.1.1. Validate attachment upload
        fe_ctrl--
        
alt Session Invalid
            fe_ctrl -->> login_view:4.1.1.1. Redirect to LoginPage
            activate login_view
            login_view -->> act--:4.1.1.1.1. Display login form
else Unauthorized Access
            fe_ctrl -->> error_page:4.1.1.2. Redirect to ErrorPage
            activate error_page
            error_page -->> act--:4.1.1.2.1. Display error message
else File size > 10MB
            fe_ctrl->be_att_ctrl++:4.1.1.3. POST /api/ChatAttachment/upload
            be_att_ctrl-->>fe_ctrl--:4.1.1.3.1. Return statusCode 400 (BadRequest)
            fe_ctrl-->>view:4.1.1.3.2. Return BadRequest
            view-->>act:4.1.1.3.3. Display file size validation error
else File size <= 10MB
            fe_ctrl->be_att_ctrl++:4.1.1.4. POST /api/ChatAttachment/upload
            
            be_att_ctrl->upload_sv++:4.1.1.4.1. Call UploadImageAsync() / UploadVideoAsync() / UploadFileAsync()
            upload_sv->upload_sv++:4.1.1.4.2. Upload to Cloudinary
            upload_sv--
            upload_sv-->>be_att_ctrl--:4.1.1.4.3. Return SecureUrl
            
            be_att_ctrl-->>fe_ctrl--:4.1.1.4.4. Return statusCode 200 (Ok) with metadata
            fe_ctrl-->>view--:4.1.1.4.5. Return JSON with attachment metadata
            view-->>act:4.1.1.4.6. Display uploaded file in UI
end
end
end

view->view++:5. sendMsg()
view--

view->hub++:6. Invoke SendMessage(dto) via SignalR
hub->hub++:7. GetAccountId()
hub--

hub->sv++:8. Call SaveMessageAsync(senderId, dto)
    sv->sv++:9. Call ValidateMessageSendingAccessAsync(senderId, dto.ChatId)
    sv--

alt isParticipant == false && hasActiveReport == false
    sv-->>hub:9.1. Throw UnauthorizedAccessException
    hub->hub++:9.1.1. Send error message to Caller
    hub--
    hub-->>view:9.1.2. Send error event via SignalR
    view-->>act:9.1.3. Display permission error message
else Valid Permissions
    sv->msg_ett++:9.2. Call Message(dto)
    msg_ett-->>sv--:9.2.1. Return Message object

    sv -> sv++:9.2.2. Check attachment option and content
    sv--

opt EnableAttachments == true && dto.Attachments is not empty
        sv->msg_att_ett++:9.2.2.2. Call MessageAttachment()
        msg_att_ett-->>sv--:9.2.2.2.1. Return MessageAttachments list
end
    
    sv->repo++:9.2.3. Call AddMessageAsync(message)
    repo->ctx++:9.2.4. Call AddAsync(message)
    ctx-->>repo--:9.2.5. Return success
    repo-->>sv--:9.2.6. Return success
    
    sv->sv++:9.2.7. Call UpdateChatAndNotifyRecipientsAsync(senderId, dto.ChatId, message.SentAt)
    sv->redis++:9.2.8. Call IncrementUnreadCountAsync(accountId, chatId)
    redis-->>sv--:9.2.9. Return
    sv--
    
    sv->repo++:9.2.10. Call SaveChangesAsync()
    repo->ctx++:9.2.11. Call SaveChangesAsync()
    ctx->db++:9.2.12. Save changes (Execute INSERT & UPDATE statements)
    
    db -> db++:9.2.13. Check database save status
    db--
    
alt Database Save Failure
        db-->>ctx:9.2.13.1. Throw DbUpdateException
        ctx-->>repo:9.2.13.1.1. Throw DbUpdateException
        repo-->>sv:9.2.13.1.2. Throw DbUpdateException
        sv-->>hub:9.2.13.1.3. Throw DbUpdateException
        hub->hub++:9.2.13.1.4. Send error message to Caller
        hub--
        hub-->>view:9.2.13.1.5. Send error event via SignalR
        view-->>act:9.2.13.1.6. Display database error message
else Database Save Success
        db-->>ctx--:9.2.13.2. Return result
        ctx-->>repo--:9.2.13.2.1. Return result
        repo-->>sv--:9.2.13.2.2. Return result
        
        sv->user_repo++:9.2.13.2.3. Call GetByIdAsync(senderId)
        user_repo->ctx++:9.2.13.2.4. Call GetByIdAsync(senderId)
        ctx->db++:9.2.13.2.5. Execute SELECT query
        db-->>ctx--:9.2.13.2.6. Return User
        ctx-->>user_repo--:9.2.13.2.7. Return User
        user_repo-->>sv--:9.2.13.2.8. Return User
        
        sv->msg_dto++:9.2.13.2.9. Call MessageDto()
        msg_dto-->>sv--:9.2.13.2.10. Return MessageDto object
        
        sv-->>hub--:9.2.13.2.11. Return MessageDto
        
        hub->hub++:9.2.13.2.12. Broadcast ReceiveMessage to Group Chat ("Chat_{chatId}")
        hub--
        hub-->>view--:9.2.13.2.13. Broadcast message via SignalR Group
        
        view->view++:9.2.13.2.14. appendMessage(msg)
        view--
        view->view++:9.2.13.2.15. scrollToBottom()
        view--
        view-->>act--:9.2.13.2.16. Display sent message on UI
end

@enduml
