@startuml
<style>
    sequenceDiagram{
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox

mainframe Change Password
actor User as act

participant "ChangePasswordView" as view
participant "LoginView" as r_view
participant "AccountController" as fe_ctrl <<frontend controller>>
participant ":ChangePasswordRequestDTO" as be_req
participant "ProfileController" as be_ctrl <<backend controller>>
participant ":IUserProfileService" as sv
participant ":IUserRepository" as repo
participant ":AppDbContext" as ctx
database Database as db

act++
act->view++:1. Enter current, new, confirm passwords & click "Change Password"

view->view++:2. Validate input
view--

view->fe_ctrl++:3. POST /Account/ChangePassword

fe_ctrl->fe_ctrl++:4. Check AccessToken cookie
fe_ctrl--

fe_ctrl->be_req++:5. Call ChangePasswordRequestDTO()
be_req-->>fe_ctrl--:6. Return ChangePasswordRequestDTO object

fe_ctrl->be_ctrl++:7. POST /api/Profile/change-password

be_ctrl->be_ctrl++:8. Validate ModelState & login session
be_ctrl--

be_ctrl->sv++:9. Call ChangePasswordAsync(userId, req.CurrentPassword, req.NewPassword)

sv->repo++:10. Call GetUserByIdAsync(userId)
repo->ctx++:11. Query User joined with navigation details
ctx->db++:12. Execute query
db-->>ctx--:13. Return result
ctx-->>repo--:14. Return User entity
repo-->>sv--:15. Return User entity

sv->sv++:16. Verify User, Account, and Current Password
sv--

sv->sv++:17. Hash newPassword and update Account properties
sv--

sv->repo++:18. Call UpdateAccountAsync(account)
repo->ctx++:19. Mark Account as modified
ctx->db++:20. Execute query
db-->>ctx--:21. Return result
ctx-->>repo--:22. Return result

repo->ctx++:23. Call SaveChangesAsync()
ctx->db++:24. Save changes to database

db->db++:25. Execute query
db--

alt Database save failed
    db-->>ctx:25.1. throw DbUpdateException
    ctx-->>repo:25.1.1. throw DbUpdateException
    repo-->>sv:25.1.2. throw DatabaseException
    sv-->>be_ctrl:25.1.3. throw InvalidOperationException
    be_ctrl-->>fe_ctrl:25.1.4. Return statusCode 400
    fe_ctrl-->>view:25.1.5. Return statusCode 400
    view-->>act:25.1.6. Display error toast message
else Save successful
    db-->>ctx--:25.2. Return result
    ctx-->>repo--:25.2.1. Return numberOfRowsAffected
    
    repo->repo++:25.2.2. Check numberOfRowsAffected
    repo--
    
    repo-->>sv--:25.2.3. Return true
    sv-->>be_ctrl--:25.2.4. Return (true, success message)
    be_ctrl-->>fe_ctrl--:25.2.5. Return statusCode 200
    
    fe_ctrl->be_ctrl++:25.2.6. POST /api/Auth/logout
    be_ctrl-->>fe_ctrl--:25.2.7. Return statusCode 200
    
    fe_ctrl->fe_ctrl++:25.2.8. Delete authentication cookies
    fe_ctrl--
    
    fe_ctrl-->>view--:25.2.9. Return statusCode 302
    view-->>act--:25.2.10. Redirect to Login page
    act->r_view++:25.2.11. Access Login page
    r_view-->>act--:25.2.12. Display login page with success message
end
@enduml
