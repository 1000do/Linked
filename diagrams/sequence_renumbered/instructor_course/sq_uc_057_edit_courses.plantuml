@startuml
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300

        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox
mainframe Edit Courses

actor Instructor as act
participant "CourseEditPage" as view
participant "InstructorCourseController" as fe_ctrl <<frontend controller>>
participant "CourseController" as be_ctrl <<backend controller>>
participant ":CourseCommandService" as sv
participant ":IRedisService" as redis
participant ":IFileUploadService" as storage_sv
participant ":ICourseRepository" as repo
participant ":AppDbContext" as ctx
database Database as db

act ++
act -> view++:1. Modify course info and click Save
view -> fe_ctrl++:2. POST /InstructorCourse/UpdateDetails (UpdateCourseDetailsViewModel)
fe_ctrl -> be_ctrl++:3. PUT /api/courses/{id}

be_ctrl -> sv++:4. Call UpdateCourseAsync(courseId, request, instructorId)

sv -> repo++:5. Call GetByIdAsync(courseId)
repo -> ctx++:6. Query data from DbSet
ctx -> db++:7. Execute query
db -->> ctx--:8. Return query results
ctx -->> repo--:9. Return course entity
repo -->> sv--:10. Return course entity


sv -> sv++:11. Check condition: Course Not Found
sv--

alt Course Not Found
    sv -->> be_ctrl:11.1. throw Exception
    be_ctrl -->> fe_ctrl:11.1.1. Return statusCode 404
    fe_ctrl -->> view:11.1.2. Return JSON (success=false)
    view -->> act:11.1.3. Display course not found message
else Course Found
    sv -> sv++:11.2. Check condition: Not Course Owner
    sv--
alt Not Course Owner
        sv -->> be_ctrl:11.2.1. throw UnauthorizedAccessException
        be_ctrl -->> fe_ctrl:11.2.1.1. Return statusCode 403
        fe_ctrl -->> view:11.2.1.2. Return JSON (success=false)
        view -->> act:11.2.1.3. Display unauthorized message
else Is Course Owner
        sv -> sv++:11.2.2. Check Active Lockout
        sv--
        
alt Account is locked out
            sv -->> be_ctrl:11.2.2.1. throw BadRequestException
            be_ctrl -->> fe_ctrl:11.2.2.1.1. Return statusCode 400
            fe_ctrl -->> view:11.2.2.1.2. Return JSON (success=false)
            view -->> act:11.2.2.1.3. Display lockout restriction message
else Account is active
            sv -> sv++:11.2.2.2. Check condition: Archived and Flagged >= 3
            sv--
alt Archived and Flagged >= 3
                sv -->> be_ctrl:11.2.2.2.1. throw BadRequestException
                be_ctrl -->> fe_ctrl:11.2.2.2.1.1. Return statusCode 400
                fe_ctrl -->> view:11.2.2.2.1.2. Return JSON (success=false)
                view -->> act:11.2.2.2.1.3. Display permanently discontinued message
else Pending Review
                sv -->> be_ctrl:11.2.2.2.2. throw InvalidOperationException
                be_ctrl -->> fe_ctrl:11.2.2.2.2.1. Return statusCode 400
                fe_ctrl -->> view:11.2.2.2.2.2. Return JSON (success=false)
                view -->> act:11.2.2.2.2.3. Display pending review message
else Can Edit
                sv -> sv++:11.2.2.2.3. Check condition: Has New Thumbnail File
                sv--
opt Has New Thumbnail File
                    sv -> storage_sv++:11.2.2.2.3.1. Call UploadImageAsync(ThumbnailFile)
                    storage_sv -->> sv--:11.2.2.2.3.1.1. Return thumbnailUrl
end
                
                sv -> sv++:11.2.2.2.4. Sanitize HTML Description
                sv--
                
                sv -> sv++:11.2.2.2.5. Update course properties and set Status=Draft if Published
                sv--
                
                sv -> sv++:11.2.2.2.6. Update Course Fingerprint
                sv--
                
                sv -> repo++:11.2.2.2.7. Call Update(course)
                repo -> ctx++:11.2.2.2.8. Update entity state
                ctx -->> repo--:11.2.2.2.9. Return
                repo -->> sv--:11.2.2.2.10. Return
                
                sv -> repo++:11.2.2.2.11. Call SaveChangesAsync()
                repo -> ctx++:11.2.2.2.12. Call SaveChangesAsync()
                ctx -> db++:11.2.2.2.13. Save changes to database
                

                db -> db++:11.2.2.2.14. Check condition: Database Save Failure
        db--

alt Database Save Failure
                    db -->> ctx:11.2.2.2.14.1. throw DbUpdateException
                    ctx -->> repo:11.2.2.2.14.1.1. throw DbUpdateException
                    repo -->> sv:11.2.2.2.14.1.2. throw DbUpdateException
                    sv -->> be_ctrl:11.2.2.2.14.1.3. throw DbUpdateException
                    be_ctrl -->> fe_ctrl:11.2.2.2.14.1.4. Return statusCode 500
                    fe_ctrl -->> view:11.2.2.2.14.1.5. Return JSON (success=false)
                    view -->> act:11.2.2.2.14.1.6. Display server error message
else Database Save Success
                    db -->> ctx--:11.2.2.2.14.2. Return returnCode
                    ctx -->> repo--:11.2.2.2.14.2.1. Return numberOfRowsAffected
                    repo -->> sv--:11.2.2.2.14.2.2. Return numberOfRowsAffected
                    
                    sv -> redis++:11.2.2.2.14.2.3. Call RemoveCacheAsync(cacheKey)
                    redis -->> sv--:11.2.2.2.14.2.4. Return
                    
                    sv -->> be_ctrl--:11.2.2.2.14.2.5. Return CourseResponse object
                    be_ctrl -->> fe_ctrl--:11.2.2.2.14.2.6. Return statusCode 200
                    fe_ctrl -->> view--:11.2.2.2.14.2.7. Return JSON (success=true)
                    view -->> act--:11.2.2.2.14.2.8. Display course updated successfully and redirect
end
end
end
end
end
