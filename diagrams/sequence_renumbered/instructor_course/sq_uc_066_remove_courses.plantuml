@startuml
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300

        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox
mainframe Remove Courses

actor Instructor as act
participant "InstructorDashboardPage" as view
participant "InstructorCourseController" as fe_ctrl <<frontend controller>>
participant "CourseController" as be_ctrl <<backend controller>>
participant ":CourseCommandService" as sv
participant ":ICourseRepository" as repo
participant ":AppDbContext" as ctx
database Database as db

act ++
act -> view++:1. Click Delete Course
view -> fe_ctrl++:2. POST /InstructorCourse/Delete/{id}
fe_ctrl -> be_ctrl++:3. DELETE /api/courses/{id}

be_ctrl -> sv++:4. Call DeleteCourseAsync(id, instructorId)

sv -> repo++:5. Call GetByIdAsync(id)
repo -> ctx++:6. Query data from DbSet
ctx -> db++:7. Execute query
db -->> ctx--:8. Return query results
ctx -->> repo--:9. Return course entity
repo -->> sv--:10. Return course entity


sv -> sv++:11. Check condition: Course Not Found
sv--

alt Course Not Found
    sv -->> be_ctrl:11.1. throw Exception
    be_ctrl -->> fe_ctrl:11.1.1. Return statusCode 404
    fe_ctrl -->> view:11.1.2. Return JSON (success=false)
    view -->> act:11.1.3. Display course not found message
else Course Found
    sv -> sv++:11.2. Validate Instructor State (e.g., Owner, Lockout status)
    sv--
    
alt Validation Failed (e.g., Not Owner, Locked out)
        sv -->> be_ctrl:11.2.1. throw Exception
        be_ctrl -->> fe_ctrl:11.2.1.1. Return error status
        fe_ctrl -->> view:11.2.1.2. Return JSON (success=false)
        view -->> act:11.2.1.3. Display error message
else Instructor Valid
        sv -> sv++:11.2.2. Validate Course State (e.g., Pending review, Archived, Has enrollments)
        sv--
        
alt Validation Failed
            sv -->> be_ctrl:11.2.2.1. throw Exception
            be_ctrl -->> fe_ctrl:11.2.2.1.1. Return error status
            fe_ctrl -->> view:11.2.2.1.2. Return JSON (success=false)
            view -->> act:11.2.2.1.3. Display course state error message
else Can Delete
            sv -> sv++:11.2.2.2. Soft delete course, cascade to lessons and materials
            sv--
            
            sv -> repo++:11.2.2.2.1. Call Update(course)
            repo -> ctx++:11.2.2.2.2. Update entity state
            ctx -->> repo--:11.2.2.2.3. Return
            repo -->> sv--:11.2.2.2.4. Return
            
            sv -> repo++:11.2.2.2.5. Call SaveChangesAsync()
            repo -> ctx++:11.2.2.2.6. Call SaveChangesAsync()
            ctx -> db++:11.2.2.2.7. Save changes to database
            

            db -> db++:11.2.2.2.8. Check condition: Database Save Failure
        db--

alt Database Save Failure
                db -->> ctx:11.2.2.2.8.1. throw DbUpdateException
                ctx -->> repo:11.2.2.2.8.1.1. throw DbUpdateException
                repo -->> sv:11.2.2.2.8.1.2. throw DbUpdateException
                sv -->> be_ctrl:11.2.2.2.8.1.3. throw DbUpdateException
                be_ctrl -->> fe_ctrl:11.2.2.2.8.1.4. Return statusCode 500
                fe_ctrl -->> view:11.2.2.2.8.1.5. Return JSON (success=false)
                view -->> act:11.2.2.2.8.1.6. Display server error message
else Database Save Success
                db -->> ctx--:11.2.2.2.8.2. Return returnCode
                ctx -->> repo--:11.2.2.2.8.2.1. Return numberOfRowsAffected
                repo -->> sv--:11.2.2.2.8.2.2. Return numberOfRowsAffected
                
                sv -->> be_ctrl--:11.2.2.2.8.2.3. Return success
                be_ctrl -->> fe_ctrl--:11.2.2.2.8.2.4. Return statusCode 200
                fe_ctrl -->> view--:11.2.2.2.8.2.5. Return JSON (success=true)
                view -->> act--:11.2.2.2.8.2.6. Display course deleted successfully
end
end
end
end
