@startuml
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300

        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox
mainframe Delete Question

actor Instructor as act
participant "QuestionBankPage" as view
participant "LoginPage" as login_view
participant "ErrorPage" as error_view
participant "QuestionBankController" as fe_ctrl <<frontend controller>>
participant "QuestionBankController" as be_ctrl <<backend controller>>
participant ":QuestionBankService" as sv
participant ":IQuestionBankRepository" as repo
participant ":ICourseRepository" as course_repo
participant ":AppDbContext" as ctx
database Database as db

act ++
act -> view++:1. Confirm delete question
view -> fe_ctrl++:2. DELETE /QuestionBank/DeleteQuestion?qId={qId}

fe_ctrl -> fe_ctrl++:3. Validate actor's authentication and authorization
fe_ctrl--

alt Session Invalid
    fe_ctrl -->> login_view:3.1. Redirect to LoginPage
    activate login_view
    login_view -->> act--:3.1.1. Display login form
else Unauthorized Access
    fe_ctrl -->> error_view:3.2. Redirect to ErrorPage
    activate error_view
    error_view -->> act--:3.2.1. Display error message
else Valid actor's authentication and authorization
    fe_ctrl -> be_ctrl++:3.3. DELETE /api/QuestionBank/questions/{questionId}
    
    be_ctrl -> sv++:3.3.1. Call DeleteQuestionAsync(questionId, instructorId)
    
    sv -> repo++:3.3.2. Call GetQuestionByIdAsync(questionId)
    repo -> ctx++:3.3.3. Query question from DbSet
    ctx -> db++:3.3.4. Execute query
    db -->> ctx--:3.3.5. Return question data
    ctx -->> repo--:3.3.6. Return QuizQuestion entity
    repo -->> sv--:3.3.7. Return QuizQuestion entity
    
    sv -> sv++:3.3.8. Check if question exists
    sv--
    
alt Question Not Found
        sv -->> be_ctrl:3.3.8.1. throw KeyNotFoundException
        be_ctrl -->> fe_ctrl:3.3.8.1.1. Return statusCode 404
        fe_ctrl -->> view:3.3.8.1.2. Return JSON (success=false)
        view -->> act:3.3.8.1.3. Display not found error message
else Question Found
        sv -> course_repo++:3.3.8.2. Call GetByIdAsync(courseId)
        course_repo -> ctx++:3.3.8.2.1. Query course from DbSet
        ctx -> db++:3.3.8.2.2. Execute query
        db -->> ctx--:3.3.8.2.3. Return course data
        ctx -->> course_repo--:3.3.8.2.4. Return course entity
        course_repo -->> sv--:3.3.8.2.5. Return course entity
    
        sv -> sv++:3.3.8.2.6. Validate Course Ownership
        sv--
        
alt Course Not Found Or Unauthorized
            sv -->> be_ctrl:3.3.8.2.6.1. throw UnauthorizedAccessException
            be_ctrl -->> fe_ctrl:3.3.8.2.6.1.1. Return statusCode 403
            fe_ctrl -->> view:3.3.8.2.6.1.2. Return JSON (success=false)
            view -->> act:3.3.8.2.6.1.3. Display unauthorized error message
else Authorized
            sv -> repo++:3.3.8.2.6.2. Call DeleteQuestionAsync(questionId)
            repo -> ctx++:3.3.8.2.6.2.1. Call SaveChangesAsync()
            ctx -> db++:3.3.8.2.6.2.2. Save changes to database
            
            db -> db++:3.3.8.2.6.2.3. Check database constraints
            db--
            
alt Database Delete Failure
                db -->> ctx:3.3.8.2.6.2.3.1. throw DbUpdateException
                ctx -->> repo:3.3.8.2.6.2.3.1.1. throw DbUpdateException
                repo -->> sv:3.3.8.2.6.2.3.1.2. throw DbUpdateException
                sv -->> be_ctrl:3.3.8.2.6.2.3.1.3. throw DbUpdateException
                be_ctrl -->> fe_ctrl:3.3.8.2.6.2.3.1.4. Return statusCode 500
                fe_ctrl -->> view:3.3.8.2.6.2.3.1.5. Return JSON (success=false)
                view -->> act:3.3.8.2.6.2.3.1.6. Display server error message
else Database Delete Success
                db -->> ctx--:3.3.8.2.6.2.3.2. Return returnCode
                ctx -->> repo--:3.3.8.2.6.2.3.2.1. Return numberOfRowsAffected
                repo -->> sv--:3.3.8.2.6.2.3.2.2. Return result
end
            
            sv -->> be_ctrl--:3.3.8.2.6.2.4. Return result
            be_ctrl -->> fe_ctrl--:3.3.8.2.6.2.5. Return statusCode 204
            fe_ctrl -->> view--:3.3.8.2.6.2.6. Return JSON (success=true)
            view -->> act--:3.3.8.2.6.2.7. Display question deleted successfully
end
end
end
