@startuml
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300

        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox
mainframe Assign Quiz to Course

actor Instructor as act
participant "CourseEditorPage" as view
participant "LoginPage" as login_view
participant "ErrorPage" as error_view
participant "CourseQuizController" as fe_ctrl <<frontend controller>>
participant "CourseQuizController" as be_ctrl <<backend controller>>
participant ":QuizService" as sv
participant ":CourseQuizResponse" as res
participant ":CourseQuiz" as ett
participant ":IQuizRepository" as repo
participant ":ICourseRepository" as course_repo
participant ":AppDbContext" as ctx
database Database as db

act ++
act -> view++:1. Select a quiz to add
view -> fe_ctrl++:2. POST /CourseQuiz/Add

fe_ctrl -> fe_ctrl++:3. Validate actor's authentication and authorization
fe_ctrl--

alt Session Invalid
    fe_ctrl -->> login_view:3.1. Redirect to LoginPage
    activate login_view
    login_view -->> act--:3.1.1. Display login form
else Unauthorized Access
    fe_ctrl -->> error_view:3.2. Redirect to ErrorPage
    activate error_view
    error_view -->> act--:3.2.1. Display error message
else Valid actor's authentication and authorization
    fe_ctrl -> be_ctrl++:3.3. POST /api/courses/{courseId}/quizzes
    
    be_ctrl -> sv++:3.3.1. Call AddQuizToCourseAsync(request, instructorId)
    
    sv -> course_repo++:3.3.2. Call GetByIdAsync(courseId)
    course_repo -> ctx++:3.3.3. Query course from DbSet
    ctx -> db++:3.3.4. Execute query
    db -->> ctx--:3.3.5. Return course data
    ctx -->> course_repo--:3.3.6. Return course entity
    course_repo -->> sv--:3.3.7. Return course entity

    sv -> repo++:3.3.8. Call GetByIdAsync(quizId)
    repo -> ctx++:3.3.9. Query quiz from DbSet
    ctx -> db++:3.3.10. Execute query
    db -->> ctx--:3.3.11. Return quiz data
    ctx -->> repo--:3.3.12. Return quiz entity
    repo -->> sv--:3.3.13. Return quiz entity
    
    sv -> sv++:3.3.14. Validate quiz assignment request
    sv--
    
alt Course Pending
        sv -->> be_ctrl:3.3.14.1. throw InvalidOperationException
        be_ctrl -->> fe_ctrl:3.3.14.1.1. Return statusCode 400
        fe_ctrl -->> view:3.3.14.1.2. Return JSON (success=false)
        view -->> act:3.3.14.1.3. Display course under review error message
else Quiz Not Found
        sv -->> be_ctrl:3.3.14.2. throw KeyNotFoundException
        be_ctrl -->> fe_ctrl:3.3.14.2.1. Return statusCode 404
        fe_ctrl -->> view:3.3.14.2.2. Return JSON (success=false)
        view -->> act:3.3.14.2.3. Display quiz not found error message
else Unauthorized Access
        sv -->> be_ctrl:3.3.14.3. throw UnauthorizedAccessException
        be_ctrl -->> fe_ctrl:3.3.14.3.1. Return statusCode 403
        fe_ctrl -->> view:3.3.14.3.2. Return JSON (success=false)
        view -->> act:3.3.14.3.3. Display unauthorized error message
else Quiz Already Assigned
        sv -->> be_ctrl:3.3.14.4. throw InvalidOperationException
        be_ctrl -->> fe_ctrl:3.3.14.4.1. Return statusCode 400
        fe_ctrl -->> view:3.3.14.4.2. Return JSON (success=false)
        view -->> act:3.3.14.4.3. Display quiz already added error message
else Valid quiz assignment request
        sv -> ett++:3.3.14.5. Call CourseQuiz()
        ett -->> sv--:3.3.14.5.1. Return CourseQuiz entity
        
        sv -> repo++:3.3.14.5.2. Call AddToCourseAsync(courseQuiz)
        repo -> ctx++:3.3.14.5.3. Call SaveChangesAsync()
        ctx -> db++:3.3.14.5.4. Save changes to database
        
        db -> db++:3.3.14.5.5. Check database constraints
        db--
        
alt Database Save Failure
            db -->> ctx:3.3.14.5.5.1. throw DbUpdateException
            ctx -->> repo:3.3.14.5.5.1.1. throw DbUpdateException
            repo -->> sv:3.3.14.5.5.1.2. throw DbUpdateException
            sv -->> be_ctrl:3.3.14.5.5.1.3. throw DbUpdateException
            be_ctrl -->> fe_ctrl:3.3.14.5.5.1.4. Return statusCode 500
            fe_ctrl -->> view:3.3.14.5.5.1.5. Return JSON (success=false)
            view -->> act:3.3.14.5.5.1.6. Display server error message
else Database Save Success
            db -->> ctx--:3.3.14.5.5.2. Return returnCode
            ctx -->> repo--:3.3.14.5.5.2.1. Return numberOfRowsAffected
            repo -->> sv--:3.3.14.5.5.2.2. Return createdCourseQuiz
            
            sv -> res++:3.3.14.5.5.2.3. Call CourseQuizResponse()
            res -->> sv--:3.3.14.5.5.2.4. Return CourseQuizResponse object
            
            sv -->> be_ctrl--:3.3.14.5.5.2.5. Return CourseQuizResponse object
            be_ctrl -->> fe_ctrl--:3.3.14.5.5.2.6. Return statusCode 201
            fe_ctrl -->> view--:3.3.14.5.5.2.7. Return JSON (success=true)
            view -->> act--:3.3.14.5.5.2.8. Display quiz assigned successfully
end
end
end
