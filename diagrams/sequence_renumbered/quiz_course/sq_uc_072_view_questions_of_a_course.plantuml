@startuml
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300

        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox
mainframe View Questions of a Course

actor Instructor as act
participant "QuestionBankPage" as view
participant "QuestionBankController" as fe_ctrl <<frontend controller>>
participant "QuestionBankController" as be_ctrl <<backend controller>>
participant ":QuestionBankService" as sv
participant ":QuizQuestionResponse" as res
participant ":ILessonRepository" as lesson_repo
participant ":IQuestionBankRepository" as repo
participant ":AppDbContext" as ctx
database Database as db

act ++
act -> view++:1. Select a lesson
view -> fe_ctrl++:2. GET /QuestionBank/GetQuestions?lessonId={lessonId}

fe_ctrl -> be_ctrl++:3. GET /api/QuestionBank/lessons/{lessonId}/questions

be_ctrl -> sv++:4. Call GetQuestionsByLessonAsync(lessonId, instructorId)

sv -> lesson_repo++:5. Call GetByIdAsync(lessonId)
lesson_repo -> ctx++:6. Query lesson from DbSet
ctx -> db++:7. Execute query
db -->> ctx--:8. Return lesson data
ctx -->> lesson_repo--:9. Return lesson entity
lesson_repo -->> sv--:10. Return lesson entity


sv -> sv++:11. Check condition: Lesson Not Found
sv--

alt Lesson Not Found
    sv -->> be_ctrl:11.1. throw KeyNotFoundException
    be_ctrl -->> fe_ctrl:11.1.1. Return statusCode 404
    fe_ctrl -->> view:11.1.2. Return JSON (success=false)
    view -->> act:11.1.3. Display lesson not found error message
else Lesson Found
    sv -> sv++:11.2. Validate Course Ownership
    sv--
    
alt Unauthorized
        sv -->> be_ctrl:11.2.1. throw UnauthorizedAccessException
        be_ctrl -->> fe_ctrl:11.2.1.1. Return statusCode 403
        fe_ctrl -->> view:11.2.1.2. Return JSON (success=false)
        view -->> act:11.2.1.3. Display unauthorized error message
else Authorized
        sv -> repo++:11.2.2. Call GetQuestionsByLessonAsync(lessonId)
        repo -> ctx++:11.2.2.1. Query questions by lesson from DbSet
        ctx -> db++:11.2.2.2. Execute query
        db -->> ctx--:11.2.2.3. Return query results
        ctx -->> repo--:11.2.2.4. Return List<QuizQuestion>
        repo -->> sv--:11.2.2.5. Return List<QuizQuestion>
        
loop For each QuizQuestion in list
            sv -> res++:11.2.2.6. Call MapToResponse(q)
            res -->> sv--:11.2.2.7. Return QuizQuestionResponse object
end
        
        sv -->> be_ctrl--:11.2.2.8. Return List<QuizQuestionResponse>
        be_ctrl -->> fe_ctrl--:11.2.2.9. Return statusCode 200
        fe_ctrl -->> view--:11.2.2.10. Return JSON (success=true)
        view -->> act--:11.2.2.11. Display questions
end
end
