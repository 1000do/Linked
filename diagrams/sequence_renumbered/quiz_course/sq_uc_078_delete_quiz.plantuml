@startuml
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300

        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox
mainframe Delete Quiz

actor Instructor as act
participant "QuizListPage" as view
participant "LoginPage" as login_view
participant "ErrorPage" as error_view
participant "QuizController" as fe_ctrl <<frontend controller>>
participant "QuizController" as be_ctrl <<backend controller>>
participant ":QuizService" as sv
participant ":IQuizRepository" as repo
participant ":AppDbContext" as ctx
database Database as db

act ++
act -> view++:1. Click Delete Quiz
view -> fe_ctrl++:2. POST /Quiz/SoftDelete/{id}

fe_ctrl -> fe_ctrl++:3. Validate actor's authentication and authorization
fe_ctrl--

alt Session Invalid
    fe_ctrl -->> login_view:3.1. Redirect to LoginPage
    activate login_view
    login_view -->> act--:3.1.1. Display login form
else Unauthorized Access
    fe_ctrl -->> error_view:3.2. Redirect to ErrorPage
    activate error_view
    error_view -->> act--:3.2.1. Display error message
else Valid actor's authentication and authorization
    fe_ctrl -> be_ctrl++:3.3. DELETE /api/quizzes/{id}
    
    be_ctrl -> sv++:3.3.1. Call SoftDeleteQuizAsync(id, instructorId)
    
    sv -> repo++:3.3.2. Call GetByIdAsync(id)
    repo -> ctx++:3.3.3. Query quiz from DbSet
    ctx -> db++:3.3.4. Execute query
    db -->> ctx--:3.3.5. Return quiz data
    ctx -->> repo--:3.3.6. Return quiz entity
    repo -->> sv--:3.3.7. Return quiz entity
    
    sv -> repo++:3.3.8. Call HasActiveAttemptsAsync(id)
    repo -> ctx++:3.3.9. Query active attempts from DbSet
    ctx -> db++:3.3.10. Execute query
    db -->> ctx--:3.3.11. Return boolean flag
    ctx -->> repo--:3.3.12. Return active attempts status
    repo -->> sv--:3.3.13. Return active attempts status
    
    sv -> repo++:3.3.14. Call IsQuizInEnrolledCourseAsync(id)
    repo -> ctx++:3.3.15. Query course enrollment status from DbSet
    ctx -> db++:3.3.16. Execute query
    db -->> ctx--:3.3.17. Return boolean flag
    ctx -->> repo--:3.3.18. Return enrollment status
    repo -->> sv--:3.3.19. Return enrollment status
    
    sv -> sv++:3.3.20. Validate Ownership, Active Attempts & Enrollment
    sv--
    
alt Validation Failed
        sv -->> be_ctrl:3.3.20.1. throw InvalidOperationException / UnauthorizedAccessException
        be_ctrl -->> fe_ctrl:3.3.20.1.1. Return statusCode 400 / 403
        fe_ctrl -->> view:3.3.20.1.2. Return JSON (success=false)
        view -->> act:3.3.20.1.3. Display validation error message
else Can Delete
        sv -> repo++:3.3.20.2. Call SoftDeleteAsync(id)
        repo -> ctx++:3.3.20.2.1. Call SaveChangesAsync()
        ctx -> db++:3.3.20.2.2. Save changes to database
        
        db -> db++:3.3.20.2.3. Check database constraints
        db--
        
alt Database Save Failure
            db -->> ctx:3.3.20.2.3.1. throw DbUpdateException
            ctx -->> repo:3.3.20.2.3.1.1. throw DbUpdateException
            repo -->> sv:3.3.20.2.3.1.2. throw DbUpdateException
            sv -->> be_ctrl:3.3.20.2.3.1.3. throw DbUpdateException
            be_ctrl -->> fe_ctrl:3.3.20.2.3.1.4. Return statusCode 500
            fe_ctrl -->> view:3.3.20.2.3.1.5. Return JSON (success=false)
            view -->> act:3.3.20.2.3.1.6. Display server error message
else Database Save Success
            db -->> ctx--:3.3.20.2.3.2. Return returnCode
            ctx -->> repo--:3.3.20.2.3.2.1. Return numberOfRowsAffected
            repo -->> sv--:3.3.20.2.3.2.2. Return result
            
            sv -->> be_ctrl--:3.3.20.2.3.2.3. Return result
            be_ctrl -->> fe_ctrl--:3.3.20.2.3.2.4. Return statusCode 200
            fe_ctrl -->> view--:3.3.20.2.3.2.5. Return JSON (success=true)
            view -->> act--:3.3.20.2.3.2.6. Display quiz deleted successfully
end
end
end
