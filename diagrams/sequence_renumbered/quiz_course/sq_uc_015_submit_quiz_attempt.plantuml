@startuml
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300

        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox
mainframe Submit Quiz Attempt

actor User as act
participant "QuizLearningPage" as view
participant "QuizAttemptController" as fe_ctrl <<frontend controller>>
participant "QuizAttemptController" as be_ctrl <<backend controller>>
participant ":QuizService" as sv
participant ":IQuizRepository" as repo
participant ":AppDbContext" as ctx
database Database as db

act ++
act -> view++:1. Complete quiz and click Submit
view -> fe_ctrl++:2. POST /QuizAttempt/Submit
fe_ctrl -> be_ctrl++:3. POST /api/quiz-attempts/submit

be_ctrl -> sv++:4. Call SubmitAttemptAsync(request, userId)

sv -> repo++:5. Call GetAttemptByIdAsync(request.AttemptId)
repo -> ctx++:6. Query data from DbSet
ctx -> db++:7. Execute query
db -->> ctx--:8. Return query results
ctx -->> repo--:9. Return attempt entity
repo -->> sv--:10. Return attempt entity


sv -> sv++:11. Check condition: Attempt Not Found
sv--

alt Attempt Not Found
    sv -->> be_ctrl:11.1. throw KeyNotFoundException
    be_ctrl -->> fe_ctrl:11.1.1. Return statusCode 404
    fe_ctrl -->> view:11.1.2. Return JSON (success=false)
    view -->> act:11.1.3. Display attempt not found message
else Attempt Found
    sv -> sv++:11.2. Check condition: Not Attempt Owner
    sv--
alt Not Attempt Owner
        sv -->> be_ctrl:11.2.1. throw UnauthorizedAccessException
        be_ctrl -->> fe_ctrl:11.2.1.1. Return statusCode 403
        fe_ctrl -->> view:11.2.1.2. Return JSON (success=false)
        view -->> act:11.2.1.3. Display unauthorized message
else Is Attempt Owner
        sv -> sv++:11.2.2. Check condition: Already Submitted
        sv--
alt Already Submitted
            sv -->> be_ctrl:11.2.2.1. throw InvalidOperationException
            be_ctrl -->> fe_ctrl:11.2.2.1.1. Return statusCode 400
            fe_ctrl -->> view:11.2.2.1.2. Return JSON (success=false)
            view -->> act:11.2.2.1.3. Display already submitted message
else Not Yet Submitted
            sv -> repo++:11.2.2.2. Call GetQuizByIdAsync(attempt.QuizId)
            repo -> ctx++:11.2.2.2.1. Query data from DbSet
            ctx -> db++:11.2.2.2.2. Execute query
            db -->> ctx--:11.2.2.2.3. Return query results
            ctx -->> repo--:11.2.2.2.4. Return quiz entity
            repo -->> sv--:11.2.2.2.5. Return quiz entity
            
            sv -> sv++:11.2.2.2.6. Score submitted answers and update attempt result
            sv--
            
            sv -> repo++:11.2.2.2.7. Call SaveAttemptAsync(attempt)
            repo -> ctx++:11.2.2.2.8. Call SaveChangesAsync()
            ctx -> db++:11.2.2.2.9. Save changes to database
            

            db -> db++:11.2.2.2.10. Check condition: Database Save Failure
        db--

alt Database Save Failure
                db -->> ctx:11.2.2.2.10.1. throw DbUpdateException
                ctx -->> repo:11.2.2.2.10.1.1. throw DbUpdateException
                repo -->> sv:11.2.2.2.10.1.2. throw DbUpdateException
                sv -->> be_ctrl:11.2.2.2.10.1.3. throw DbUpdateException
                be_ctrl -->> fe_ctrl:11.2.2.2.10.1.4. Return statusCode 500
                fe_ctrl -->> view:11.2.2.2.10.1.5. Return JSON (success=false)
                view -->> act:11.2.2.2.10.1.6. Display server error message
else Database Save Success
                db -->> ctx--:11.2.2.2.10.2. Return returnCode
                ctx -->> repo--:11.2.2.2.10.2.1. Return numberOfRowsAffected
                repo -->> sv--:11.2.2.2.10.2.2. Return numberOfRowsAffected
                
                sv -> sv++:11.2.2.2.10.2.3. Map to QuizAttemptResultResponse
                sv--
                
                sv -->> be_ctrl--:11.2.2.2.10.2.4. Return QuizAttemptResultResponse object
                be_ctrl -->> fe_ctrl--:11.2.2.2.10.2.5. Return statusCode 200
                fe_ctrl -->> view--:11.2.2.2.10.2.6. Return JSON (success=true, result)
                view -->> act--:11.2.2.2.10.2.7. Display quiz result to student
end
end
end
end
