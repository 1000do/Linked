@startuml
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300

        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox
mainframe Create Quiz

actor Instructor as act
participant "QuizEditorPage" as view
participant "LoginPage" as login_view
participant "ErrorPage" as error_view
participant "QuizController" as fe_ctrl <<frontend controller>>
participant "QuizController" as be_ctrl <<backend controller>>
participant ":QuizService" as sv
participant ":IQuizRepository" as repo
participant ":IQuestionBankRepository" as question_bank_repo
participant ":AppDbContext" as ctx
database Database as db

act ++
act -> view++:1. Fill quiz details and click Create
view -> fe_ctrl++:2. POST /Quiz/Create

fe_ctrl -> fe_ctrl++:3. Validate actor's authentication and authorization
fe_ctrl--

alt Session Invalid
    fe_ctrl -->> login_view:3.1. Redirect to LoginPage
    activate login_view
    login_view -->> act--:3.1.1. Display login form
else Unauthorized Access
    fe_ctrl -->> error_view:3.2. Redirect to ErrorPage
    activate error_view
    error_view -->> act--:3.2.1. Display error message
else Valid actor's authentication and authorization
    fe_ctrl -> be_ctrl++:3.3. POST /api/quizzes
    
    be_ctrl -> sv++:3.3.1. Call CreateQuizAsync(request, instructorId)
    
    sv -> sv++:3.3.2. Validate quiz options and title uniqueness
    sv--
    
alt Validation Failed
        sv -->> be_ctrl:3.3.2.1. throw ArgumentException
        be_ctrl -->> fe_ctrl:3.3.2.1.1. Return statusCode 400
        fe_ctrl -->> view:3.3.2.1.2. Return JSON (success=false)
        view -->> act:3.3.2.1.3. Display validation error message
else Validation Passed
        sv -> question_bank_repo++:3.3.2.2. Call GetQuestionsByLessonAsync(lessonId)
        question_bank_repo -> ctx++:3.3.2.2.1. Query questions from DbSet
        ctx -> db++:3.3.2.2.2. Execute query
        db -->> ctx--:3.3.2.2.3. Return questions data
        ctx -->> question_bank_repo--:3.3.2.2.4. Return List<QuizQuestion>
        question_bank_repo -->> sv--:3.3.2.2.5. Return List<QuizQuestion>
    
        sv -> sv++:3.3.2.2.6. Validate quiz distributions count against bank
        sv--
        
alt Distributions Invalid
            sv -->> be_ctrl:3.3.2.2.6.1. throw ArgumentException
            be_ctrl -->> fe_ctrl:3.3.2.2.6.1.1. Return statusCode 400
            fe_ctrl -->> view:3.3.2.2.6.1.2. Return JSON (success=false)
            view -->> act:3.3.2.2.6.1.3. Display invalid distribution message
else Distributions Valid
            sv -> sv++:3.3.2.2.6.2. Map request to Quiz entity
            sv--
            
            sv -> repo++:3.3.2.2.6.2.1. Call CreateAsync(quiz)
            repo -> ctx++:3.3.2.2.6.2.2. Call SaveChangesAsync()
            ctx -> db++:3.3.2.2.6.2.3. Save changes to database
            
            db -> db++:3.3.2.2.6.2.4. Check database constraints
            db--
            
alt Database Save Failure
                db -->> ctx:3.3.2.2.6.2.4.1. throw DbUpdateException
                ctx -->> repo:3.3.2.2.6.2.4.1.1. throw DbUpdateException
                repo -->> sv:3.3.2.2.6.2.4.1.2. throw DbUpdateException
                sv -->> be_ctrl:3.3.2.2.6.2.4.1.3. throw DbUpdateException
                be_ctrl -->> fe_ctrl:3.3.2.2.6.2.4.1.4. Return statusCode 500
                fe_ctrl -->> view:3.3.2.2.6.2.4.1.5. Return JSON (success=false)
                view -->> act:3.3.2.2.6.2.4.1.6. Display server error message
else Database Save Success
                db -->> ctx--:3.3.2.2.6.2.4.2. Return returnCode
                ctx -->> repo--:3.3.2.2.6.2.4.2.1. Return createdQuiz
                repo -->> sv--:3.3.2.2.6.2.4.2.2. Return createdQuiz
                
                sv -> sv++:3.3.2.2.6.2.4.2.3. Map to QuizDetailResponse
                sv--
                
                sv -->> be_ctrl--:3.3.2.2.6.2.4.2.4. Return QuizDetailResponse object
                be_ctrl -->> fe_ctrl--:3.3.2.2.6.2.4.2.5. Return statusCode 200
                fe_ctrl -->> view--:3.3.2.2.6.2.4.2.6. Return JSON (success=true)
                view -->> act--:3.3.2.2.6.2.4.2.7. Display quiz created successfully
end
end
end
end
