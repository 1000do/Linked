@startuml 
<style>
    sequenceDiagram{
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox

mainframe Delete Account
actor Admin as act

participant "AdminAccountView" as view
participant "AdminAccountController" as fe_ctrl <<frontend controller>>
participant "AdminAccountController" as be_ctrl <<backend controller>>
participant ":IAdminAccountService" as sv
participant ":Lockout" as lockout_ett
participant ":IUserRepository" as u_repo
participant ":ILockoutRepository" as lockout_repo
participant ":AppDbContext" as ctx
database Database as db

act++
act->view++:1. Click "Delete/Ban" button
view->fe_ctrl++:2. POST /AdminAccount/ToggleBan/{id}

fe_ctrl->be_ctrl++:3. POST /api/admin/accounts/{id}/toggle-ban

be_ctrl->be_ctrl++:4. Extract adminId from User claims
be_ctrl--

be_ctrl->sv++:5. Call ToggleBanAsync(id, adminId)

sv->u_repo++:6. Call GetAccountByIdAsync(id)
u_repo->ctx++:7. Query Account with Manager details
ctx->db++:8. Execute query
db-->>ctx--:9. Return result
ctx-->>u_repo--:10. Return Account entity
u_repo-->>sv--:11. Return Account entity

sv->sv++:12. Check Account existence and role
sv--

alt Account not found
    sv-->>be_ctrl:12.1. Return null
    be_ctrl-->>fe_ctrl:12.1.1. Return statusCode 404
    fe_ctrl-->>view:12.1.2. Return JSON with success = false
    view-->>act:12.1.3. Display error toast message
else Account is Super Admin
    sv-->>be_ctrl:12.2. throw InvalidOperationException
    be_ctrl-->>fe_ctrl:12.2.1. Return statusCode 400
    fe_ctrl-->>view:12.2.2. Return JSON with success = false
    view-->>act:12.2.3. Display error toast message
else Account is valid
    sv->sv++:12.3. Check current Account status
    sv--
    
alt Account is currently Banned
        sv->sv++:12.3.1. Set AccountStatus = "Active"
        sv--
        sv->lockout_repo++:12.3.1.1. Call RemoveAccountLockoutsAsync(accountId)
        lockout_repo->ctx++:12.3.1.2. Remove Lockout entities
        ctx->db++:12.3.1.3. Execute query
        db-->>ctx--:12.3.1.4. Return result
        ctx-->>lockout_repo--:12.3.1.5. Return tracking state
        lockout_repo-->>sv--:12.3.1.6. Return success
else Account is currently Active
        sv->sv++:12.3.2. Set AccountStatus = "Banned"
        sv--
        sv->lockout_ett++:12.3.2.1. Call Lockout()
        lockout_ett-->>sv--:12.3.2.2. Return Lockout entity
        sv->lockout_repo++:12.3.2.3. Call AddAsync(lockout)
        lockout_repo->ctx++:12.3.2.4. Add Lockout entity (100 years)
        ctx->db++:12.3.2.5. Execute query
        db-->>ctx--:12.3.2.6. Return result
        ctx-->>lockout_repo--:12.3.2.7. Return tracking state
        lockout_repo-->>sv--:12.3.2.8. Return success
end
    
    sv->u_repo++:12.4. Call SaveChangesAsync()
    u_repo->ctx++:12.5. Commit tracked changes
    ctx->db++:12.6. Save changes to database
    
    db->db++:12.7. Execute query
    db--
    
alt Database save failed
        db-->>ctx:12.7.1. throw DbUpdateException
        ctx-->>u_repo:12.7.1.1. throw DbUpdateException
        u_repo-->>sv:12.7.1.2. throw DatabaseException
        sv-->>be_ctrl:12.7.1.3. throw InvalidOperationException
        be_ctrl-->>fe_ctrl:12.7.1.4. Return statusCode 400
        fe_ctrl-->>view:12.7.1.5. Return JSON with success = false
        view-->>act:12.7.1.6. Display error toast message
else Save successful
        db-->>ctx--:12.7.2. Return result
        ctx-->>u_repo--:12.7.2.1. Return numberOfRowsAffected
        u_repo-->>sv--:12.7.2.2. Return success
        
        sv-->>be_ctrl--:12.7.2.3. Return newStatus
        be_ctrl-->>fe_ctrl--:12.7.2.4. Return statusCode 200
        fe_ctrl-->>view--:12.7.2.5. Return JSON with success = true
        view-->>act--:12.7.2.6. Display success toast and update UI status
end
end
@enduml
