@startuml 
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300

        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox
mainframe Report Course

actor User as act
participant "CourseDetailsPage" as view
participant "LoginPage" as login_view
participant "ErrorPage" as error_view
participant "ReportController" as fe_ctrl <<frontend controller>>
participant "ReportController" as be_ctrl <<backend controller>>
participant ":IReportSubmissionService" as sv
participant ":CourseReport" as ett
participant ":IReportRepository" as repo
participant ":AppDbContext" as ctx
database Database as db

act ++
act -> view++:1. Click "Report this course" button
view -->> act--:2. Display report course form modal


act -> view++:3. Input reason and description, click "Submit Report"
view -> view++:4. Validate form input
view--
opt Invalid form input
    view -->> act:4.1. Display validation error message
end

view -> fe_ctrl++:5. POST /Report/ReportCourse

fe_ctrl -> fe_ctrl++:6. Validate actor's authentication and authorization
fe_ctrl--

alt Session Invalid
    fe_ctrl -->> login_view:6.1. Redirect to LoginPage
    activate login_view
    login_view -->> act--:6.1.1. Display login form
else Unauthorized Access
    fe_ctrl -->> error_view:6.2. Redirect to ErrorPage
    activate error_view
    error_view -->> act--:6.2.1. Display error message
else Valid actor's authentication and authorization
    fe_ctrl -> fe_ctrl++:6.3. Validate ModelState
    fe_ctrl--
    
opt Invalid ModelState
        fe_ctrl -->> view:6.3.2. Return BadRequest()
        view -->> act:6.3.2.1. Display error message
end

    fe_ctrl -> be_ctrl++:6.4. POST /api/report/courses
    be_ctrl -> sv++:6.5. Call CreateCourseReportAsync(reporterId, request)
    
    sv -> sv++:6.6. Validate course report request
    sv--
    
alt Course Not Found
        sv -->> be_ctrl:6.6.1. throw KeyNotFoundException
        be_ctrl -->> fe_ctrl:6.6.1.1. Return statusCode 404
        fe_ctrl -->> view:6.6.1.2. Return NotFound()
        view -->> act:6.6.1.3. Display error message
else Validation Failure
        sv -->> be_ctrl:6.6.2. throw BadRequestException
        be_ctrl -->> fe_ctrl:6.6.2.1. Return statusCode 400
        fe_ctrl -->> view:6.6.2.2. Return BadRequest()
        view -->> act:6.6.2.3. Display error message
else Valid course report request
        sv -> ett++:6.6.3. Call CourseReport()
        ett -->> sv--:6.6.3.1. Return CourseReport object

        sv -> repo++:6.6.3.2. AddCourseReportAsync(report)
        repo -> ctx++:6.6.3.3. Add(report)
        ctx -->> repo:6.6.3.4. Return result
        ctx--
        repo -->> sv:6.6.3.5. Return result
        repo--
        
        sv -> sv++:6.6.3.6. Call SaveChangesAndHandleExceptionsAsync()
        sv -> repo++:6.6.3.7. SaveChangesAsync()
        repo -> ctx++:6.6.3.8. SaveChangesAsync()
        ctx -> db++:6.6.3.9. Save changes to database
        db -> db++:6.6.3.10. Check database\n operation status
        db--
alt Database Save Failure
            db -->> ctx:6.6.3.10.1. throw DbUpdateException
            ctx -->> repo:6.6.3.10.1.1. throw DbUpdateException
            repo -->> sv:6.6.3.10.1.2. throw ReportException
            sv -->> be_ctrl:6.6.3.10.1.3. throw BadRequestException
            be_ctrl -->> fe_ctrl:6.6.3.10.1.4. Return statusCode 400
            fe_ctrl -->> view:6.6.3.10.1.5. Return BadRequest()
            view -->> act:6.6.3.10.1.6. Display error message regarding report submission failure
else Database Save Success
            db -->> ctx:6.6.3.10.2. Return result
            db--
            ctx -->> repo:6.6.3.10.2.1. Return result
            ctx--
            repo -->> sv:6.6.3.10.2.2. Return result
            repo--
            sv--
            
            sv -> sv++:6.6.3.10.2.3. Call NotifyManagersAsync()
            sv--
            
            sv -->> be_ctrl:6.6.3.10.2.4. Return true
            sv--
            be_ctrl -->> fe_ctrl--:6.6.3.10.2.5. Return statusCode 200
            fe_ctrl -->> view--:6.6.3.10.2.6. Return Ok()
            view -->> act--:6.6.3.10.2.7. Display success message regarding report submission
end
end
end
@enduml
