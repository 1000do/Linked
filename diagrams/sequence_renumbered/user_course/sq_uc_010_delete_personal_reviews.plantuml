@startuml
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300

        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox
mainframe Delete Personal Reviews

actor User as act
participant "CourseDetailPage" as view
participant "LoginPage" as login_view
participant "ErrorPage" as error_view
participant "CourseController" as fe_ctrl <<frontend controller>>
participant "ReviewController" as be_ctrl <<backend controller>>
participant ":ReviewService" as sv
participant ":IReviewRepository" as repo
participant ":AppDbContext" as ctx
database Database as db

act ++
act -> view++:1. Click Delete on own review
view -> fe_ctrl++:2. POST /Course/DeleteReview (DeleteReviewRequest)

fe_ctrl -> fe_ctrl++:3. Validate actor's authentication and authorization
fe_ctrl--

alt Session Invalid
    fe_ctrl -->> login_view:3.1. Redirect to LoginPage
    activate login_view
    login_view -->> act--:3.1.1. Display login form
else Unauthorized Access
    fe_ctrl -->> error_view:3.2. Redirect to ErrorPage
    activate error_view
    error_view -->> act--:3.2.1. Display error message
else Valid actor's authentication and authorization
    fe_ctrl -> be_ctrl++:3.3. DELETE /api/review/delete (request)
    be_ctrl -> sv++:3.3.1. Call DeleteReviewAsync(userId, request)
    

    sv -> sv++:3.3.2. Check condition: type == "lesson"
    sv--

    sv -> repo++:3.3.3. Call GetReviewByIdAsync(reviewId, type)
    note right of repo: Repository resolves internally whether to fetch\nLessonReview or CourseReview based on type
    repo -> ctx++:3.3.4. Query data from DbSet
    ctx -> db++:3.3.5. Execute query
    db -->> ctx--:3.3.6. Return query results
    ctx -->> repo--:3.3.7. Return review entity
    repo -->> sv--:3.3.8. Return review entity
    

    sv -> sv++:3.3.9. Check condition: Review == null OR Not Owner
    sv--

alt Review == null OR Not Owner
        sv -->> be_ctrl:3.3.9.1. throw InvalidOperationException / UnauthorizedAccessException
        be_ctrl -->> fe_ctrl:3.3.9.1.1. Return statusCode 400 / 403
        fe_ctrl -->> view:3.3.9.1.2. Return JSON (success=false)
        view -->> act:3.3.9.1.3. Display error message
else Valid Review
        sv -> repo++:3.3.9.2. Call HasPendingReportsAsync(reviewId, type)
        repo -> ctx++:3.3.9.2.1. Query data from DbSet
        ctx -> db++:3.3.9.2.2. Execute query
        db -->> ctx--:3.3.9.2.3. Return query results
        ctx -->> repo--:3.3.9.2.4. Return hasPending flag
        repo -->> sv--:3.3.9.2.5. Return hasPending flag
        

        sv -> sv++:3.3.9.2.6. Check condition: hasPending == true
        sv--

alt hasPending == true
            sv -->> be_ctrl:3.3.9.2.6.1. throw InvalidOperationException
            be_ctrl -->> fe_ctrl:3.3.9.2.6.1.1. Return statusCode 400
            fe_ctrl -->> view:3.3.9.2.6.1.2. Return JSON (success=false)
            view -->> act:3.3.9.2.6.1.3. Display moderation error message
else No pending reports
            sv -> repo++:3.3.9.2.6.2. Call UpdateReview(review)
            repo -> ctx++:3.3.9.2.6.2.1. Update entity state (IsRemoved=true)
            ctx -->> repo--:3.3.9.2.6.2.2. Return
            repo -->> sv--:3.3.9.2.6.2.3. Return
end
end
    
    sv -> repo++:3.3.10. Call SaveChangesAsync()
    repo -> ctx++:3.3.11. Call SaveChangesAsync()
    ctx -> db++:3.3.12. Save changes to database
    

    db -> db++:3.3.13. Check condition: Database Save Failure
        db--

alt Database Save Failure
        db -->> ctx:3.3.13.1. throw DbUpdateException
        ctx -->> repo:3.3.13.1.1. throw DbUpdateException
        repo -->> sv:3.3.13.1.2. throw DbUpdateException
        sv -->> be_ctrl:3.3.13.1.3. throw DbUpdateException
        be_ctrl -->> fe_ctrl:3.3.13.1.4. Return statusCode 500
        fe_ctrl -->> view:3.3.13.1.5. Return JSON (success=false)
        view -->> act:3.3.13.1.6. Display server error message
else Database Save Success
        db -->> ctx--:3.3.13.2. Return returnCode
        ctx -->> repo--:3.3.13.2.1. Return numberOfRowsAffected
        repo -->> sv--:3.3.13.2.2. Return numberOfRowsAffected
        
        sv -->> be_ctrl--:3.3.13.2.3. Return success
        be_ctrl -->> fe_ctrl--:3.3.13.2.4. Return statusCode 200
        fe_ctrl -->> view--:3.3.13.2.5. Return JSON (success=true)
        view -->> act--:3.3.13.2.6. Display review deleted successfully
end
end
