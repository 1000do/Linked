@startuml
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300

        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox
mainframe Go To Learning

actor User as act
participant "CourseLearnPage" as view
participant "LoginPage" as login_view
participant "ErrorPage" as error_view
participant "CourseController" as fe_ctrl <<frontend controller>>
participant "CoursePublicController" as be_ctrl <<backend controller>>
participant ":CourseQueryService" as sv
participant ":CourseDetailResponse" as res
participant ":IRedisService" as redis
participant ":ICourseRepository" as repo
participant ":IInstructorRepository" as inst_repo
participant ":ICartRepository" as cart_repo
participant ":AppDbContext" as ctx
database Database as db

act ++
act -> view++:1. Click "Go to learning"
view -> fe_ctrl++:2. GET /Course/Learn/{id}

fe_ctrl -> fe_ctrl++:3. Validate actor's authentication and authorization
fe_ctrl--

alt Session Invalid
    fe_ctrl -->> login_view:3.1. Redirect to LoginPage
    activate login_view
    login_view -->> act--:3.1.1. Display login form
else Unauthorized Access
    fe_ctrl -->> error_view:3.2. Redirect to ErrorPage
    activate error_view
    error_view -->> act--:3.2.1. Display error message
else Valid actor's authentication and authorization

    fe_ctrl -> be_ctrl++:3.3. GET /api/public/courses/{id}
    be_ctrl -> sv++:3.3.1. Call GetCourseWithDetailsAsync(id, userId, role)
    
    sv -> redis++:3.3.2. Call GetCacheAsync(cacheKey)
    redis -->> sv--:3.3.3. Return cachedResponse
    

    sv -> sv++:3.3.4. Check condition: cachedResponse == null
    sv--

alt cachedResponse == null
        sv -> repo++:3.3.4.1. Call GetCourseWithDetailsAsync(id)
        repo -> ctx++:3.3.4.1.1. Query data from DbSet
        ctx -> db++:3.3.4.1.2. Execute query
        db -->> ctx--:3.3.4.1.3. Return query results
        ctx -->> repo--:3.3.4.1.4. Return course entity
        repo -->> sv--:3.3.4.1.5. Return course entity
        

        sv -> sv++:3.3.4.1.6. Check condition: Course Not Found
        sv--

alt Course Not Found
            sv -->> be_ctrl:3.3.4.1.6.1. throw KeyNotFoundException
            be_ctrl -->> fe_ctrl:3.3.4.1.6.1.1. Return statusCode 404
            fe_ctrl -->> view:3.3.4.1.6.1.2. Return NotFound()
            view -->> act:3.3.4.1.6.1.3. Display course not found message
else Course Found

            sv -> sv++:3.3.4.1.6.2. Check condition: InstructorId HasValue
            sv--
opt InstructorId HasValue
                sv -> inst_repo++:3.3.4.1.6.2.1. Call GetStatsAsync(InstructorId)
                inst_repo -> ctx++:3.3.4.1.6.2.1.1. Query data from DbSet
                ctx -> db++:3.3.4.1.6.2.1.2. Execute query
                db -->> ctx--:3.3.4.1.6.2.1.3. Return query results
                ctx -->> inst_repo--:3.3.4.1.6.2.1.4. Return instructor stats
                inst_repo -->> sv--:3.3.4.1.6.2.1.5. Return instructor stats
end
            
            sv -> res++:3.3.4.1.6.3. Call CourseDetailResponse()
            res -->> sv--:3.3.4.1.6.4. Return CourseDetailResponse object
            
            sv -> redis++:3.3.4.1.6.5. Call SetCacheAsync(cacheKey, response)
            redis -->> sv--:3.3.4.1.6.6. Return result
end
else cachedResponse != null
        sv -> sv++:3.3.4.2. Use cachedResponse
        sv--
end
    
    sv -> cart_repo++:3.3.5. Call IsCourseInAnyCartAsync(id)
    cart_repo -> ctx++:3.3.6. Query data from DbSet
    ctx -> db++:3.3.7. Execute query
    db -->> ctx--:3.3.8. Return query results
    ctx -->> cart_repo--:3.3.9. Return IsInAnyCart flag
    cart_repo -->> sv--:3.3.10. Return IsInAnyCart flag
    

    sv -> sv++:3.3.11. Check condition: userId HasValue
    sv--

opt userId HasValue
        sv -> repo++:3.3.11.2. Call IsEnrolledAsync(userId, courseId)
        repo -> ctx++:3.3.11.2.1. Query data from DbSet
        ctx -> db++:3.3.11.2.2. Execute query
        db -->> ctx--:3.3.11.2.3. Return query results
        ctx -->> repo--:3.3.11.2.4. Return IsEnrolled flag
        repo -->> sv--:3.3.11.2.5. Return IsEnrolled flag
end
    
    sv -> sv++:3.3.12. Validate course status and access permissions
    sv--

alt Course Status != Published
        sv -> sv++:3.3.12.1. Check access permissions
        sv--
        
alt Unauthorized Access (Not Owner and Not Admin/Staff)
            sv -->> be_ctrl:3.3.12.1.1. throw UnauthorizedAccessException
            be_ctrl -->> fe_ctrl:3.3.12.1.1.1. Return statusCode 403
            fe_ctrl -->> view:3.3.12.1.1.2. Return Forbid()
            view -->> act:3.3.12.1.1.3. Display access denied message
else Valid actor's authentication and authorization
            sv -->> be_ctrl:3.3.12.1.2. Return CourseDetailResponse object
            be_ctrl -->> fe_ctrl:3.3.12.1.2.1. Return statusCode 200
            fe_ctrl -->> view:3.3.12.1.2.2. Return View(CourseDetailViewModel)
            view -->> act:3.3.12.1.2.3. Display course learning page
end
else Course Status == Published
        sv -->> be_ctrl--:3.3.12.2. Return CourseDetailResponse object
        be_ctrl -->> fe_ctrl--:3.3.12.2.1. Return statusCode 200
        fe_ctrl -->> view--:3.3.12.2.2. Return View(CourseDetailViewModel)
        view -->> act--:3.3.12.2.3. Display course learning page
end
end
