@startuml
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300

        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox
mainframe View Learning Progress

actor User as act
participant "CourseLearnSidebar" as view
participant "LoginPage" as login_view
participant "ErrorPage" as error_view
participant "CourseController" as fe_ctrl <<frontend controller>>
participant "EnrollmentController" as be_ctrl <<backend controller>>
participant ":EnrollmentService" as sv
participant ":ProgressResponse" as res
participant ":IEnrollmentRepository" as repo
participant ":ICourseRepository" as course_repo
participant ":AppDbContext" as ctx
database Database as db

act ++
act -> view++:1. View learning progress
view -> fe_ctrl++:2. GET /Course/Learn/{id}

fe_ctrl -> fe_ctrl++:3. Validate actor's authentication and authorization
fe_ctrl--

alt Session Invalid
    fe_ctrl -->> login_view:3.1. Redirect to LoginPage
    activate login_view
    login_view -->> act:3.1.1. Display login form
else Unauthorized Access
    fe_ctrl -->> error_view:3.2. Redirect to ErrorPage
    activate error_view
    error_view -->> act:3.2.1. Display error message
else Valid actor's authentication and authorization
    fe_ctrl -> be_ctrl++:3.3. GET /api/enrollment/progress/{courseId}
    be_ctrl -> sv++:3.3.1. Call GetProgressAsync(userId, courseId)

sv -> repo++:3.3.2. Call GetEnrollmentAsync(userId, courseId)
repo -> ctx++:3.3.3. Query data from DbSet
ctx -> db++:3.3.4. Execute query
db -->> ctx--:3.3.5. Return query results
ctx -->> repo--:3.3.6. Return enrollment entity
repo -->> sv--:3.3.7. Return enrollment entity


sv -> sv++:3.3.8. Check condition: Enrollment == null
sv--

alt Enrollment == null
    sv -> sv++:3.3.8.1. Check Instructor Bypass
    sv--
alt Is Instructor
        sv -> course_repo++:3.3.8.1.1. Call GetCourseStatsAsync(courseId)
        course_repo -> ctx++:3.3.8.1.1.1. Query data from DbSet
        ctx -> db++:3.3.8.1.1.2. Execute query
        db -->> ctx--:3.3.8.1.1.3. Return query results
        ctx -->> course_repo--:3.3.8.1.1.4. Return course stats
        course_repo -->> sv--:3.3.8.1.1.5. Return course stats
        
        sv -> res++:3.3.8.1.1.6. Call ProgressResponse()
        res -->> sv--:3.3.8.1.1.7. Return ProgressResponse object (mocked full progress)
        sv -->> be_ctrl:3.3.8.1.1.8. Return ProgressResponse object
else Not Instructor
        sv -->> be_ctrl:3.3.8.1.2. Return null
end
else Enrollment != null
    sv -> course_repo++:3.3.8.2. Call GetCourseStatsAsync(courseId)
    course_repo -> ctx++:3.3.8.2.1. Query data from DbSet
    ctx -> db++:3.3.8.2.2. Execute query
    db -->> ctx--:3.3.8.2.3. Return query results
    ctx -->> course_repo--:3.3.8.2.4. Return course stats
    course_repo -->> sv--:3.3.8.2.5. Return course stats

    sv -> repo++:3.3.8.2.6. Call GetCompletedMaterialCountAsync(enrollmentId)
    repo -> ctx++:3.3.8.2.7. Query data from DbSet
    ctx -> db++:3.3.8.2.8. Execute query
    db -->> ctx--:3.3.8.2.9. Return query results
    ctx -->> repo--:3.3.8.2.10. Return completed count
    repo -->> sv--:3.3.8.2.11. Return completed count
    
    sv -> repo++:3.3.8.2.12. Call GetCompletedMaterialIdsAsync(enrollmentId)
    repo -> ctx++:3.3.8.2.13. Query data from DbSet
    ctx -> db++:3.3.8.2.14. Execute query
    db -->> ctx--:3.3.8.2.15. Return query results
    ctx -->> repo--:3.3.8.2.16. Return completed ids
    repo -->> sv--:3.3.8.2.17. Return completed material ids
    
    sv -> res++:3.3.8.2.18. Call ProgressResponse()
    res -->> sv--:3.3.8.2.19. Return ProgressResponse object
    sv -->> be_ctrl--:3.3.8.2.20. Return ProgressResponse object
end

be_ctrl -> be_ctrl++:3.3.9. Check condition: Progress == null
be_ctrl--

alt Progress == null
    be_ctrl -->> fe_ctrl:3.3.9.1. Return statusCode 404
    fe_ctrl -->> view:3.3.9.1.1. Return JSON (success=false)
    view -->> act:3.3.9.1.2. Display error message
else Progress != null
    be_ctrl -->> fe_ctrl--:3.3.9.2. Return statusCode 200
    fe_ctrl -->> view--:3.3.9.2.1. Return JSON (success=true)
    view -->> act--:3.3.9.2.2. Display learning progress
end

end
