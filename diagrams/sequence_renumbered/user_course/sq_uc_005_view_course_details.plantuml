@startuml
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300

        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox
mainframe View Course Detail

actor Guest as act
participant "CourseDetailPage" as view
participant "CourseController" as fe_ctrl <<frontend controller>>
participant "CoursePublicController" as be_ctrl <<backend controller>>
participant ":CourseQueryService" as sv
participant ":CourseDetailResponse" as res
participant ":IRedisService" as redis
participant ":ICourseRepository" as repo
participant ":IInstructorRepository" as inst_repo
participant ":ICartRepository" as cart_repo
participant ":AppDbContext" as ctx
database Database as db

act ++
act -> view++:1. Click on a course
view -> fe_ctrl++:2. GET /Course/Details/{id}
fe_ctrl -> be_ctrl++:3. GET /api/public/courses/{id}
be_ctrl -> sv++:4. Call GetCourseWithDetailsAsync(id, userId, role)

sv -> redis++:5. Call GetCacheAsync(cacheKey)
redis -->> sv--:6. Return cachedResponse

sv -> sv++:7. Check cached response
sv--

alt cachedResponse == null
    sv -> repo++:7.1. Call GetCourseWithDetailsAsync(id)
    repo -> ctx++:7.1.1. Query course details from DbSet
    ctx -> db++:7.1.2. Execute query
    db -->> ctx--:7.1.3. Return query results
    ctx -->> repo--:7.1.4. Return course entity
    repo -->> sv--:7.1.5. Return course entity
    
    sv -> sv++:7.1.6. Check course entity presence
    sv--
    
alt Course Not Found
        sv -->> be_ctrl:7.1.6.1. throw KeyNotFoundException
        be_ctrl -->> fe_ctrl:7.1.6.1.1. Return statusCode 404
        fe_ctrl -->> view:7.1.6.1.2. Return NotFound()
        view -->> act:7.1.6.1.3. Display course not found message
else Course Found

        sv -> sv++:7.1.6.2. Check if InstructorId has value
        sv--
        
opt InstructorId HasValue
            sv -> inst_repo++:7.1.6.2.1. Call GetStatsAsync(InstructorId)
            inst_repo -> ctx++:7.1.6.2.1.1. Query instructor stats from DbSet
            ctx -> db++:7.1.6.2.1.2. Execute query
            db -->> ctx--:7.1.6.2.1.3. Return query results
            ctx -->> inst_repo--:7.1.6.2.1.4. Return instructor stats
            inst_repo -->> sv--:7.1.6.2.1.5. Return instructor stats
end
        
        sv -> res++:7.1.6.3. Call CourseDetailResponse()
        res -->> sv--:7.1.6.4. Return CourseDetailResponse object
        
        sv -> redis++:7.1.6.5. Call SetCacheAsync(cacheKey, response)
        redis -->> sv--:7.1.6.6. Return result
end
else cachedResponse != null
    sv -> sv++:7.2. Use cachedResponse
    sv--
end

sv -> cart_repo++:8. Call IsCourseInAnyCartAsync(id)
cart_repo -> ctx++:9. Query cart status from DbSet
ctx -> db++:10. Execute query
db -->> ctx--:11. Return query results
ctx -->> cart_repo--:12. Return IsInAnyCart flag
cart_repo -->> sv--:13. Return IsInAnyCart flag

sv -> sv++:14. Check if userId has value
sv--

opt userId HasValue
    sv -> repo++:14.2. Call IsEnrolledAsync(userId, courseId)
    repo -> ctx++:14.2.1. Query enrollment from DbSet
    ctx -> db++:14.2.2. Execute query
    db -->> ctx--:14.2.3. Return query results
    ctx -->> repo--:14.2.4. Return IsEnrolled flag
    repo -->> sv--:14.2.5. Return IsEnrolled flag
end

sv -> sv++:15. Validate course status and access permissions
sv--

alt Course Status != Published
    sv -> sv++:15.1. Check access permissions
    sv--
    
alt Unauthorized Access (Not Owner and Not Admin/Staff)
        sv -->> be_ctrl:15.1.1. throw UnauthorizedAccessException
        be_ctrl -->> fe_ctrl:15.1.1.1. Return statusCode 403
        fe_ctrl -->> view:15.1.1.2. Return Forbid()
        view -->> act:15.1.1.3. Display access denied message
else Authorized
        sv -->> be_ctrl:15.1.2. Return CourseDetailResponse object
        be_ctrl -->> fe_ctrl:15.1.2.1. Return statusCode 200
        fe_ctrl -->> view:15.1.2.2. Return View(CourseDetailViewModel)
        view -->> act:15.1.2.3. Display course details
end
else Course Status == Published
    sv -->> be_ctrl--:15.2. Return CourseDetailResponse object
    be_ctrl -->> fe_ctrl--:15.2.1. Return statusCode 200
    fe_ctrl -->> view--:15.2.2. Return View(CourseDetailViewModel)
    view -->> act--:15.2.3. Display course details
end
