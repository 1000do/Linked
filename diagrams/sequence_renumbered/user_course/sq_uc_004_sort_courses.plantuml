@startuml
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300

        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox
mainframe Sort Courses

actor Guest as act
participant "CourseListPage" as view
participant "CourseController" as fe_ctrl <<frontend controller>>
participant "CoursePublicController" as be_ctrl <<backend controller>>
participant ":CourseQueryService" as sv
participant ":CourseResponse" as res
participant ":ICourseRepository" as repo
participant ":AppDbContext" as ctx
database Database as db

act ++
act -> view++:1. Select sorting option
view -> fe_ctrl++:2. GET /Course/Index?sort=price_asc
fe_ctrl -> be_ctrl++:3. GET /api/public/courses?sort=price_asc
be_ctrl -> sv++:4. Call GetPublishedCoursesPagedAsync(sort)

sv -> repo++:5. Call GetAllPublishedCoursesPagedAsync(sort)
repo -> ctx++:6. Query published courses from DbSet
ctx -> db++:7. Execute query
db -->> ctx--:8. Return query results
ctx -->> repo--:9. Return entities and totalCount
repo -->> sv--:10. Return (courses, totalCount)

sv -> sv++:11. Check course list presence
sv--

alt courses is empty
    sv -->> be_ctrl:11.1. Return empty list
    be_ctrl -->> fe_ctrl:11.1.1. Return statusCode 200
    fe_ctrl -->> view:11.1.2. Return View(emptyList)
    view -->> act:11.1.3. Display empty course list message
else courses found
    sv -> sv++:11.2. Fetch course stats, enrollment and wishlist status
    sv--
    sv -> res++:11.2.1. Call CourseResponse() (via IMapper)
    res -->> sv--:11.2.2. Return List<CourseResponse>
    
    sv -->> be_ctrl--:11.2.3. Return List<CourseResponse>
    be_ctrl -->> fe_ctrl--:11.2.4. Return statusCode 200
    fe_ctrl -->> view--:11.2.5. Return View(List<CourseResponse>)
    view -->> act--:11.2.6. Display course list
end
