@startuml
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300

        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox

mainframe View Chat History

actor User as act
participant "ChatIndexPage" as view
participant "ChatHub" as hub
participant "LoginPage" as login_view
participant "ErrorPage" as error_page
participant "ChatController" as fe_ctrl <<frontend controller>>
participant "ChatController" as be_ctrl <<backend controller>>
participant ":IChatService" as sv
participant ":IChatRepository" as repo
participant ":MessageDto" as msg_dto
participant ":AppDbContext" as ctx
database Database as db

act++
act->view++:1. Click on partner in Chat List
view->view++:2. selectChat(chatId, name, avatar, isOnline)
view--

view->fe_ctrl++:3. GET /Chat/GetHistory?roomId={chatId}

fe_ctrl -> fe_ctrl++:4. Validate actor's authentication and authorization
fe_ctrl--

alt Session Invalid
    fe_ctrl -->> login_view:4.1. Redirect to LoginPage
    activate login_view
    login_view -->> act--:4.1.1. Display login form
else Unauthorized Access
    fe_ctrl -->> error_page:4.2. Redirect to ErrorPage
    activate error_page
    error_page -->> act--:4.2.1. Display error message
else Valid actor's authentication and authorization
    fe_ctrl->be_ctrl++:4.3. GET /api/chat/history?roomId={chatId}
    
    be_ctrl->sv++:4.3.1. Call GetChatHistoryAsync(chatId, accountId)

sv->sv++:4.3.2. Call ValidateChatAccessAsync(accountId, chatId)
sv--

alt Unauthorized Access
    sv-->>be_ctrl:4.3.2.1. Throw UnauthorizedAccessException
    be_ctrl-->>fe_ctrl:4.3.2.1.1. Return statusCode 403 (Forbidden)
    fe_ctrl-->>view:4.3.2.1.2. Return statusCode 403 (Forbidden)
    view-->>act:4.3.2.1.3. Display permission error message
else Valid chat access permission
    sv->sv++:4.3.2.2. Call MarkChatAsReadAsync(chatId, accountId)
    sv--
    
    sv->repo++:4.3.2.2.1. Call GetParticipantAsync(chatId, accountId)
    repo-->>sv--:4.3.2.2.2. Return ChatParticipant
    
    sv->repo++:4.3.2.2.3. Call GetMessagesByChatIdAsync(chatId)
    repo->ctx++:4.3.2.2.4. Call GetMessagesByChatIdAsync(chatId)
    ctx->db++:4.3.2.2.5. Execute SELECT query
    db-->>ctx--:4.3.2.2.6. Return messages list
    ctx-->>repo--:4.3.2.2.7. Return messages list
    repo-->>sv--:4.3.2.2.8. Return messages list
    
    sv->sv++:4.3.2.2.9. Call FilterMessagesByClearedAt(messages, clearedAt)
    sv--
    
    sv->msg_dto++:4.3.2.2.10. Call MessageDto()
    msg_dto-->>sv--:4.3.2.2.11. Return MessageDto list
    
    sv-->>be_ctrl--:4.3.2.2.12. Return MessageDto list
    be_ctrl-->>fe_ctrl--:4.3.2.2.13. Return statusCode 200 (Ok)
    fe_ctrl-->>view--:4.3.2.2.14. Return JSON messages
    
loop for each message m
        view->view++:4.3.2.2.15. appendMessage(m)
        view--
end
    view->view++:4.3.2.2.16. scrollToBottom()
    view--
    
    view->hub++:4.3.2.2.17. Invoke MarkAsRead(chatId) via SignalR
    hub-->>view--:4.3.2.2.18. Broadcast read receipt via SignalR
    
    view-->>act--:4.3.2.2.19. Display chat messages in panel
end
end

@enduml
