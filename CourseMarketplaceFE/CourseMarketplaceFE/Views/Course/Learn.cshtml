@model CourseMarketplaceFE.Models.CourseDetailViewModel
@functions {
    public static string FormatDuration(int totalSeconds)
    {
        if (totalSeconds <= 0) return "0 mins";
        if (totalSeconds < 60) return totalSeconds == 1 ? "1 sec" : $"{totalSeconds} secs";
        
        if (totalSeconds < 3600)
        {
            var mins = (int)Math.Round(totalSeconds / 60.0);
            if (mins == 60) return "1 hr";
            return mins == 1 ? "1 min" : $"{mins} mins";
        }
        
        var hrs = totalSeconds / 3600;
        var remainingMins = (int)Math.Round((totalSeconds % 3600) / 60.0);
        if (remainingMins == 60)
        {
            hrs += 1;
            remainingMins = 0;
        }
        
        var hrText = hrs == 1 ? "1 hr" : $"{hrs} hrs";
        if (remainingMins == 0) return hrText;
        
        var minText = remainingMins == 1 ? "1 min" : $"{remainingMins} mins";
        return $"{hrText} {minText}";
    }
}
@{
    ViewData["Title"] = "Learning: " + Model.Title;
    Layout = null; // No layout for full-screen player experience
    var tokenForLayout = Context.Request.Cookies["AccessToken"]
                         ?? Context.Request.Cookies[".AspNetCore.Identity.Application"] ?? "";
    var firstMaterial = Model.Lessons.SelectMany(l => l.LearningMaterials).FirstOrDefault();

    var userRole = (Context.Request.Cookies["UserRole"] ?? "").ToLower();
    var isStaffOrAdmin = userRole == "admin" || userRole == "staff" || User.IsInRole("admin") || User.IsInRole("staff");
    var isCourseOwner = Model.IsOwner;
    var canSkipVideoServer = isStaffOrAdmin || isCourseOwner;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <link rel="icon" type="image/png" href="~/img/default-avatar.png" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <style>
        body { font-family: 'Inter', sans-serif; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #f0fcfb; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #006a6233; border-radius: 3px; }
        .active-material { background-color: #e0f2f1; border-left: 4px solid #006a62; }
        .fill-1 { font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .learn-review-menu-container.menu-open { opacity: 1 !important; }
    </style>
</head>
<body class="bg-[#f0fcfb] text-[#191c1b] h-screen flex flex-col overflow-hidden">

    @if (!Model.CourseStatus.Equals("published", StringComparison.OrdinalIgnoreCase))
    {
        <div class="w-full bg-amber-500 text-amber-950 font-bold text-center py-2 shadow-md shrink-0 z-[40]">
            WARNING: This course is currently in @Model.CourseStatus.ToUpper() state.
        </div>
    }
    <!-- Header -->
    <header class="h-14 bg-[#006a62] text-white flex items-center justify-between px-6 shrink-0 z-50 shadow-md">
        <div class="flex items-center gap-4">
            <a href="/Course/Details/@Model.CourseId" class="hover:opacity-80 transition-all">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <div class="h-6 w-px bg-white/20"></div>
            <div class="flex flex-col">
                <h1 class="font-bold text-sm truncate max-w-md">@Model.Title</h1>
                <div class="flex items-center gap-2 mt-0.5">
                    <div class="w-32 h-1.5 bg-white/20 rounded-full overflow-hidden">
                        <div id="top-progress-bar" class="h-full bg-[#43e8d8] transition-all duration-500" style="width: 0%"></div>
                    </div>
                    <span id="top-progress-text" class="text-[10px] font-bold text-white/70">0% complete</span>
                </div>
            </div>
        </div>
        <button type="button" onclick="toggleCurriculum()" class="lg:hidden p-2 text-white/80 hover:text-white rounded-xl hover:bg-white/10 transition-colors">
            <span class="material-symbols-outlined text-[24px]">menu_book</span>
        </button>
    </header>

    <!-- CURRICULUM OVERLAY -->
    <div id="curriculumOverlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[60] hidden lg:hidden transition-opacity opacity-0 duration-300" onclick="toggleCurriculum()"></div>

    <div class="flex-1 flex overflow-hidden">
        <!-- Main Content -->
        <main class="flex-1 flex flex-col relative bg-white overflow-y-auto custom-scrollbar">
            @{
                bool isFirstVideo = true;
                var fileType = firstMaterial?.MaterialMetadata?.FileType;
                if (!string.IsNullOrEmpty(fileType))
                {
                    isFirstVideo = fileType.StartsWith("video") || fileType == "mp4";
                }
                var firstLesson = Model.Lessons.FirstOrDefault(l => l.LearningMaterials != null && l.LearningMaterials.Any(m => m.MaterialId == firstMaterial?.MaterialId));
                bool isFirstPending = firstLesson != null && (string.Equals(firstLesson.LessonStatus, "pending", StringComparison.OrdinalIgnoreCase) || string.Equals(firstMaterial?.LearningStatus, "pending", StringComparison.OrdinalIgnoreCase));
            }
            <!-- Media Area -->
            <div class="w-full bg-[#191c1b] flex items-center justify-center relative group min-h-[500px] h-[80vh] shrink-0" oncontextmenu="return false;">
                
                <!-- Pending Viewer -->
                <div id="pending-viewer" class="w-full h-full bg-slate-50 flex flex-col items-center justify-center @(isFirstPending ? "" : "hidden")">
                    <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 text-center max-w-md">
                        <div class="w-16 h-16 bg-amber-50 text-amber-500 rounded-full flex items-center justify-center mx-auto mb-4">
                            <span class="material-symbols-outlined text-[32px]">pending_actions</span>
                        </div>
                        <h3 class="text-lg font-bold text-slate-800 mb-2">Pending Review</h3>
                        <p class="text-sm text-slate-500">This content is currently pending moderation review and is temporarily unavailable.</p>
                    </div>
                </div>

                <!-- Video Player -->
                <video id="main-video" class="w-full h-full @(isFirstVideo && !isFirstPending ? "" : "hidden")" controls autoplay controlsList="nodownload" oncontextmenu="return false;">
                    <source id="video-source" src="@(firstMaterial?.MaterialUrl ?? "")" type="video/mp4">
                </video>
                
                <!-- Quiz Viewer -->
                <iframe id="quiz-iframe" class="w-full h-full hidden" frameborder="0" allowfullscreen="true"></iframe>

                <!-- Document Viewer (Embed) -->
                <div id="document-viewer" class="w-full h-full bg-[#f0fcfb] flex flex-col @(!isFirstVideo && !isFirstPending ? "" : "hidden")">
                    <div class="flex items-center justify-between px-6 py-3 bg-[#006a62]/10 border-b border-[#006a62]/20 shrink-0 select-none">
                        <div class="flex items-center gap-2 text-[#006a62] font-bold">
                            <span class="material-symbols-outlined text-[20px]">description</span>
                            <span id="doc-title" class="text-sm">@(firstMaterial?.Title)</span>
                        </div>
                        <div class="flex gap-3">
                            <span class="text-xs text-[#006a62] font-semibold bg-[#006a62]/10 px-2 py-1 rounded">Protected Material</span>
                        </div>
                    </div>
                    @{
                        bool isTxt = false;
                        if (!isFirstVideo && firstMaterial != null && !string.IsNullOrEmpty(firstMaterial.MaterialUrl))
                        {
                            isTxt = firstMaterial.MaterialUrl.EndsWith(".txt", StringComparison.OrdinalIgnoreCase);
                        }
                    }
                    <iframe id="doc-iframe" src="@(isTxt ? firstMaterial?.MaterialUrl : "")" class="w-full flex-1 bg-white hidden" frameborder="0"></iframe>
                    
                    <!-- Text Viewer -->
                    <div id="doc-txt-viewer" class="w-full flex-1 bg-white overflow-y-auto p-8 @(isTxt && !isFirstVideo ? "" : "hidden")">
                        <pre id="doc-txt-content" class="text-sm font-mono text-slate-800 whitespace-pre-wrap word-break"></pre>
                    </div>
                    
                    <div id="doc-download-fallback" class="w-full flex-1 bg-slate-50 flex flex-col items-center justify-center @(!isTxt && !isFirstVideo ? "" : "hidden")">
                        <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 text-center max-w-sm">
                            <div class="w-16 h-16 bg-[#006a62]/10 text-[#006a62] rounded-full flex items-center justify-center mx-auto mb-4">
                                <span class="material-symbols-outlined text-[32px]">download_for_offline</span>
                            </div>
                            <h3 class="text-lg font-bold text-slate-800 mb-2">Attached Resource</h3>
                            <p class="text-sm text-slate-500 mb-6">This file format is not supported for direct viewing in the browser. Please download to view.</p>
                            <a id="doc-download-btn" href="@(!isFirstVideo ? firstMaterial?.MaterialUrl : "#")" target="_blank" download class="bg-[#006a62] text-white px-6 py-2.5 rounded-full font-bold hover:bg-[#00544e] transition-colors flex items-center justify-center gap-2">
                                <span class="material-symbols-outlined text-[20px]">download</span>
                                Download Resource
                            </a>
                        </div>
                    </div>
                </div>
                
                <!-- Loading Overlay -->
                <div id="video-loader" class="absolute inset-0 bg-black/60 hidden flex items-center justify-center z-10">
                    <div class="w-12 h-12 border-4 border-[#006a62] border-t-[#43e8d8] rounded-full animate-spin"></div>
                </div>
            </div>

            <!-- Content Info Tabs -->
            <div class="flex-1 bg-white border-t border-slate-100 p-8 pb-20">
                <div class="max-w-4xl mx-auto">
                    <div class="flex gap-8 border-b border-slate-100 mb-6 sticky top-0 bg-white z-10 pt-2">
                        <button id="btn-tab-overview" onclick="switchTab('overview', this)" class="tab-btn pb-4 border-b-2 border-[#006a62] text-[#006a62] font-bold text-sm">Overview</button>
                        <button id="btn-tab-reviews" onclick="switchTab('reviews', this)" class="tab-btn pb-4 text-slate-400 font-bold text-sm hover:text-[#006a62] transition-colors">Reviews</button>
                    </div>
                    
                    <!-- Overview Tab Content -->
                    <div id="tab-overview" class="tab-content">
                        <h2 id="current-material-title" class="text-2xl font-bold mb-4">@(firstMaterial?.Title ?? "Select a lesson to start")</h2>
                        <div id="current-material-desc" class="text-slate-600 leading-relaxed prose prose-slate max-w-none">
                            @(Html.Raw(firstMaterial?.Description ?? "No description available."))
                        </div>
                    </div>

                    <!-- Reviews Tab Content -->
                    <div id="tab-reviews" class="tab-content hidden text-slate-700">
                        <h2 class="text-xl font-extrabold mb-6 text-[#191c1b]">Student Feedback</h2>
                        
                        <!-- Dynamic stats (populated via JS) -->
                        <div class="flex flex-col md:flex-row gap-8 mb-10 items-start">
                            <div class="text-center w-32 shrink-0">
                                <p id="learn-stats-avg" class="text-5xl font-extrabold text-[#006a62] mb-1">—</p>
                                <div id="learn-stats-stars" class="flex justify-center text-amber-500 mb-1"></div>
                                <p id="learn-stats-total" class="text-xs font-bold text-[#006a62]">Lesson Rating</p>
                            </div>
                            
                            <div id="learn-stats-bars" class="flex-1 w-full space-y-1.5 max-w-md">
                                <!-- Dynamic bars -->
                            </div>
                        </div>

                        <div class="space-y-6">
                            <h3 class="font-bold text-lg text-[#191c1b] mb-4">Reviews</h3>
                            
                            <!-- Submit Review Form (conditionally shown by JS) -->
                            <div id="learn-review-form" class="hidden">
                                <div class="bg-gradient-to-r from-[#006a62]/5 to-[#43e8d8]/10 p-6 rounded-2xl border border-[#006a62]/20 mb-8">
                                    <h4 class="font-bold text-sm mb-1 text-[#006a62]">✍️ Write your review</h4>
                                    <p class="text-xs text-slate-500 mb-4">Review after you have experienced the lesson</p>
                                    <div class="flex gap-1 mb-4" id="rating-input">
                                        @for (int i = 1; i <= 5; i++) {
                                            <button onclick="setRating(@i)" class="star-btn text-slate-300 hover:text-amber-500 transition-colors">
                                                <span class="material-symbols-outlined text-3xl">star</span>
                                            </button>
                                        }
                                        <input type="hidden" id="selected-rating" value="0" />
                                    </div>
                                    <textarea id="review-comment" rows="3" class="w-full bg-white border border-slate-200 rounded-lg p-4 text-sm focus:outline-none focus:ring-2 focus:ring-[#006a62]/20 mb-4" placeholder="Share your learning experience..."></textarea>
                                    <button onclick="submitReview()" id="submit-review-btn" class="bg-[#006a62] text-white px-6 py-2.5 rounded-full font-bold text-sm hover:bg-[#00544e] transition-all flex items-center gap-2">
                                        <span class="material-symbols-outlined text-[18px]">send</span>
                                        Submit Review
                                    </button>
                                </div>
                            </div>

                            <!-- Blocked message for users who haven't learned yet -->
                            <div id="learn-review-blocked" class="hidden mb-8">
                                <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 flex items-start gap-3">
                                    <span class="material-symbols-outlined text-[#006a62] text-xl mt-0.5">school</span>
                                    <div>
                                        <p id="learn-blocked-msg" class="text-sm font-medium text-slate-700"></p>
                                        <p class="text-xs text-slate-500 mt-1">Complete at least 1 lesson to unlock the review feature.</p>
                                    </div>
                                </div>
                            </div>

                            <div id="learn-reviews-list" class="space-y-6">
                                <!-- Loaded via JS -->
                            </div>


                        </div>
                    </div>
                </div>
        </main>

        <!-- Sidebar (Curriculum) -->
        <aside id="courseCurriculumSidebar" class="w-[320px] lg:w-[350px] bg-white border-l border-slate-100 flex flex-col shrink-0 shadow-2xl lg:shadow-sm fixed inset-y-0 right-0 translate-x-full transition-transform duration-300 ease-in-out z-[70] lg:relative lg:translate-x-0 lg:z-auto">
            <div class="p-4 border-b border-slate-100 font-bold text-[#191c1b] flex items-center justify-between">
                <span>Course Content</span>
                <button type="button" onclick="toggleCurriculum()" class="lg:hidden p-1.5 text-slate-400 hover:text-slate-800 hover:bg-slate-50 rounded-lg transition-colors">
                    <span class="material-symbols-outlined text-[20px]">close</span>
                </button>
            </div>
            
            <div class="flex-1 overflow-y-auto custom-scrollbar">
                @foreach (var lesson in Model.Lessons)
                {
                    <div class="lesson-section border-b border-slate-50" data-lesson-id="@lesson.LessonId">
                        <button class="w-full px-4 py-3 bg-slate-50 flex items-center justify-between text-left hover:bg-slate-100 transition-colors"
                                onclick="this.nextElementSibling.classList.toggle('hidden')">
                            <div>
                                <p class="text-xs font-bold text-[#006a62] uppercase tracking-tighter">Section @(Model.Lessons.IndexOf(lesson) + 1)</p>
                                <div class="flex items-center gap-2">
                                    <h3 class="font-bold text-sm text-[#191c1b]">@lesson.Title</h3>
                                    <span class="lesson-rating-badge hidden text-[11px] font-bold text-amber-600 bg-amber-50 border border-amber-200 px-1.5 py-0.5 rounded-md leading-none"></span>
                                    <span class="lesson-lock-icon hidden text-slate-400" title="Complete previous lesson to unlock">
                                        <span class="material-symbols-outlined text-[16px]">lock</span>
                                    </span>
                                </div>
                            </div>
                            <span class="material-symbols-outlined text-slate-400">expand_more</span>
                        </button>
                        <div class="lesson-items bg-white">
                            @foreach (var material in lesson.LearningMaterials)
                            {
                                string mFileType = material.MaterialMetadata?.FileType;
                                if (string.IsNullOrEmpty(mFileType)) {
                                    mFileType = (material.MaterialUrl?.EndsWith(".mp4") == true || material.MaterialUrl?.EndsWith(".webm") == true) ? "video" : "document";
                                }
                                bool isPending = string.Equals(lesson.LessonStatus, "pending", StringComparison.OrdinalIgnoreCase) || string.Equals(material.LearningStatus, "pending", StringComparison.OrdinalIgnoreCase);

                                <div class="material-item group cursor-pointer border-b border-slate-50 @(material == firstMaterial ? "active-material" : "")"
                                      onclick="playMaterial('@material.MaterialUrl', '@material.Title', '@(material.Description?.Replace("'", "\\'"))', this, '@mFileType', @material.MaterialId, @lesson.LessonId, @isPending.ToString().ToLower())">
                                    <div class="px-4 py-4 flex gap-3">
                                        <div class="flex flex-col items-center pt-1 shrink-0">
                                            @if (mFileType.StartsWith("video") || mFileType == "mp4") {
                                                <span class="material-symbols-outlined text-[20px] text-slate-400 group-hover:text-[#006a62]">play_circle</span>
                                            } else {
                                                <span class="material-symbols-outlined text-[20px] text-slate-400 group-hover:text-[#006a62]">description</span>
                                            }
                                        </div>
                                        <div class="flex-1">
                                            <p class="text-sm font-medium leading-tight mb-1 group-hover:text-[#006a62] transition-colors">@material.Title</p>
                                            <div class="flex items-center justify-between">
                                                <div class="flex items-center gap-2 text-[11px] text-slate-400">
                                                    @{
                                                        bool isVid = mFileType.StartsWith("video") || mFileType == "mp4";
                                                    }
                                                    <span class="material-symbols-outlined text-[14px]">@(isVid ? "ondemand_video" : "description")</span>
                                                    <span>@(isVid ? FormatDuration(material.MaterialMetadata?.Duration ?? 0) : "Document")</span>
                                                </div>
                                                <div id="check-@material.MaterialId" class="hidden text-emerald-500">
                                                    <span class="material-symbols-outlined fill-1 text-[18px]">check_circle</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                
                @if (Model.CourseQuizzes != null && Model.CourseQuizzes.Any(q => !q.IsHidden))
                {
                    <div class="lesson-section quiz-section border-b border-indigo-50 mt-4">
                        <button class="w-full px-4 py-3 bg-indigo-50 flex items-center justify-between text-left hover:bg-indigo-100 transition-colors"
                                onclick="this.nextElementSibling.classList.toggle('hidden')">
                            <div>
                                <p class="text-xs font-bold text-indigo-600 uppercase tracking-tighter">Assessments</p>
                                <div class="flex items-center gap-2">
                                    <h3 class="font-bold text-sm text-indigo-900">Quizzes</h3>
                                    <span class="text-[11px] font-bold text-indigo-600 bg-white border border-indigo-200 px-1.5 py-0.5 rounded-md leading-none">@Model.CourseQuizzes.Count(q => !q.IsHidden)</span>
                                    <span class="quiz-lock-icon hidden text-indigo-400" title="Complete all lessons to unlock quizzes">
                                        <span class="material-symbols-outlined text-[16px]">lock</span>
                                    </span>
                                </div>
                            </div>
                            <span class="material-symbols-outlined text-indigo-400">expand_more</span>
                        </button>
                        <div class="lesson-items quiz-items bg-white">
                            @foreach (var quiz in Model.CourseQuizzes.Where(q => !q.IsHidden))
                            {
                                <div class="material-item group cursor-pointer border-b border-slate-50 hover:bg-indigo-50/50 transition-colors"
                                     onclick="playQuiz(@quiz.QuizId, '@Html.Raw(quiz.Title.Replace("'", "\\'"))', '@Html.Raw(quiz.Description?.Replace("'", "\\'") ?? "")', this)">
                                    <div class="px-4 py-4 flex gap-3">
                                        <div class="flex flex-col items-center pt-1 shrink-0">
                                            <span class="material-symbols-outlined text-[20px] text-indigo-400 group-hover:text-indigo-600">quiz</span>
                                        </div>
                                        <div class="flex-1">
                                            <p class="text-sm font-medium leading-tight mb-1 group-hover:text-indigo-600 transition-colors">@quiz.Title</p>
                                            <div class="flex items-center gap-2 text-[11px] text-slate-400">
                                                <span class="material-symbols-outlined text-[14px]">format_list_bulleted</span>
                                                <span>@quiz.QuestionCount Questions</span>
                                                @if (quiz.TimeLimitMinutes.HasValue && quiz.TimeLimitMinutes.Value > 0)
                                                {
                                                    <span class="material-symbols-outlined text-[14px] ml-1">timer</span>
                                                    <span>@quiz.TimeLimitMinutes.Value mins</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </aside>
    </div>

    <!-- </script> -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Global Logout Form -->
    <form id="global-logout-form" asp-controller="Account" asp-action="Logout" method="post" style="display:none;">
        @Html.AntiForgeryToken()
    </form>

    <script>
    function toggleCurriculum() {
        const sidebar = document.getElementById('courseCurriculumSidebar');
        const overlay = document.getElementById('curriculumOverlay');
        
        if (sidebar.classList.contains('translate-x-full')) {
            sidebar.classList.remove('translate-x-full');
            overlay.classList.remove('hidden');
            setTimeout(() => overlay.classList.remove('opacity-0'), 10);
        } else {
            sidebar.classList.add('translate-x-full');
            overlay.classList.add('opacity-0');
            setTimeout(() => overlay.classList.add('hidden'), 300);
        }
    }
    function showSwalLikeSuccessPopup(title, text, callback) {
        const popupId = 'swal-custom-' + Date.now();
        const popup = document.createElement('div');
        popup.id = popupId;
        popup.className = 'fixed inset-0 z-[10000] bg-black/40 flex items-center justify-center p-4 transition-opacity duration-300';
        popup.innerHTML = `        <style id="swal2-custom-style">
            @@keyframes swal2-animate-success-icon {
                0% { transform: rotateX(-100deg); opacity: 0; }
                100% { transform: rotateX(0deg); opacity: 1; }
            }
            @@keyframes swal2-animate-success-check {
                0% { stroke-dashoffset: 100; }
                100% { stroke-dashoffset: 0; }
            }
        </style>
        <div class="bg-white rounded-[5px] w-full max-w-[32rem] p-6 text-center transform scale-75 opacity-0 transition-all duration-300 flex flex-col items-center shadow-lg" id="modal-${popupId}">
            <div style="border-color:#a5dc86; width:80px; height:80px; border-width:4px; border-style:solid; border-radius:50%; box-sizing:content-box; position:relative; margin: 20px auto 24px; animation: swal2-animate-success-icon .5s;">
                <svg viewBox="0 0 80 80" style="position:absolute; inset:0; width:100%; height:100%; z-index:3; left:-4px; top:-4px;">
                    <path d="M 23 41 L 35 53 L 59 26" fill="none" stroke="#a5dc86" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="100" stroke-dashoffset="100" style="animation: swal2-animate-success-check 0.4s ease-out 0.2s forwards;" />
                </svg>
                <div style="box-sizing:content-box; border-radius:50%; position:absolute; width:80px; height:80px; border:4px solid rgba(165,220,134,.2); left:-4px; top:-4px; z-index:2;"></div>
            </div>
            <h2 class="text-[#545454] text-[1.875em] font-semibold mb-2 leading-tight">${title}</h2>
                <div class="text-[#545454] text-[1.125em] font-normal mb-8">${text}</div>
                <div class="flex justify-center w-full gap-3">
                    <button id="btn-${popupId}" class="bg-[#7066e0] text-white px-[1.1em] py-[0.625em] rounded-[0.25em] text-[1em] font-medium hover:bg-[#5b52b8] focus:ring-[3px] focus:ring-[#7066e0]/50 outline-none transition-colors">
                        OK
                    </button>
                </div>
            </div>
        `;
        document.body.appendChild(popup);

        setTimeout(() => {
            const modal = document.getElementById(`modal-${popupId}`);
            if(modal) {
                modal.classList.remove('scale-75', 'opacity-0');
                modal.classList.add('scale-100', 'opacity-100');
            }
        }, 10);

        const closeAndReload = () => {
            if (!document.body.contains(popup)) return;
            popup.classList.add('opacity-0');
            const modal = document.getElementById(`modal-${popupId}`);
            if(modal) {
                modal.classList.remove('scale-100', 'opacity-100');
                modal.classList.add('scale-75', 'opacity-0');
            }
            setTimeout(() => {
                if (document.body.contains(popup)) popup.remove();
                if (callback) callback();
            }, 300);
        };

        document.getElementById(`btn-${popupId}`).addEventListener('click', closeAndReload);

        setTimeout(() => {
            closeAndReload();
        }, 3000);
    }

        const videoPlayer = document.getElementById('main-video');
        const videoSource = document.getElementById('video-source');
        const videoLoader = document.getElementById('video-loader');
        const docViewer = document.getElementById('document-viewer');
        const docTitle = document.getElementById('doc-title');
        const docIframe = document.getElementById('doc-iframe');
        const quizIframe = document.getElementById('quiz-iframe');
        const docDownloadFallback = document.getElementById('doc-download-fallback');
        const docDownloadBtn = document.getElementById('doc-download-btn');
        const titleEl = document.getElementById('current-material-title');
        const descEl = document.getElementById('current-material-desc');

        let currentMaterialId = 0;
        let currentLessonId = 0;
        let eligibilityData = null;
        let completedMaterialIdsArray = [];
        let isCurrentVideoCompleted = false;
        let maxPlayedTime = 0;

        const canSkipVideoServer = @(canSkipVideoServer ? "true" : "false");
        function canSkipVideo() {
            if (canSkipVideoServer) return true;
            if (typeof currentUserRole !== 'undefined' && currentUserRole) {
                const roleLower = currentUserRole.toLowerCase();
                if (roleLower === 'admin' || roleLower === 'staff') return true;
            }
            return false;
        }

        const lessonMaterialsMap = {
            @foreach(var l in Model.Lessons) {
                @:@l.LessonId: [@string.Join(",", l.LearningMaterials.Select(m => m.MaterialId))],
            }
        };

        const lessonOrderList = [
            @foreach(var l in Model.Lessons) {
                @:@l.LessonId,
            }
        ];

        function isLessonCompleted(lessonId) {
            const mIds = lessonMaterialsMap[lessonId];
            if (!mIds || mIds.length === 0) return false;
            return mIds.every(id => completedMaterialIdsArray.includes(id));
        }

        function updateSequentialLockState() {
            let prevCompleted = true; // Lesson 0 is unlocked by default

            lessonOrderList.forEach((lid, idx) => {
                const sectionEl = document.querySelector(`.lesson-section[data-lesson-id="${lid}"]`);
                if (!sectionEl) return;

                const lockIcon = sectionEl.querySelector('.lesson-lock-icon');
                const itemsContainer = sectionEl.querySelector('.lesson-items');

                const isUnlocked = (idx === 0) || prevCompleted || canSkipVideo();

                if (isUnlocked) {
                    sectionEl.dataset.isLocked = "false";
                    if (lockIcon) lockIcon.classList.add('hidden');
                    if (itemsContainer) {
                        itemsContainer.classList.remove('opacity-50', 'pointer-events-none', 'select-none');
                    }
                } else {
                    sectionEl.dataset.isLocked = "true";
                    if (lockIcon) lockIcon.classList.remove('hidden');
                    if (itemsContainer) {
                        itemsContainer.classList.add('opacity-50', 'pointer-events-none', 'select-none');
                    }
                }

                prevCompleted = isLessonCompleted(lid);
            });

            // Lock/unlock Quizzes section (requires all lessons to be completed)
            const quizSectionEl = document.querySelector('.quiz-section');
            if (quizSectionEl) {
                const quizLockIcon = quizSectionEl.querySelector('.quiz-lock-icon');
                const quizItemsContainer = quizSectionEl.querySelector('.quiz-items');
                const allLessonsCompleted = lessonOrderList.length === 0 || lessonOrderList.every(lid => isLessonCompleted(lid));
                const isQuizUnlocked = allLessonsCompleted || canSkipVideo();

                if (isQuizUnlocked) {
                    quizSectionEl.dataset.isLocked = "false";
                    if (quizLockIcon) quizLockIcon.classList.add('hidden');
                    if (quizItemsContainer) {
                        quizItemsContainer.classList.remove('opacity-50', 'pointer-events-none', 'select-none');
                    }
                } else {
                    quizSectionEl.dataset.isLocked = "true";
                    if (quizLockIcon) quizLockIcon.classList.remove('hidden');
                    if (quizItemsContainer) {
                        quizItemsContainer.classList.add('opacity-50', 'pointer-events-none', 'select-none');
                    }
                }
            }
        }

        async function loadProgress() {
            try {
                const res = await fetch('/Course/GetProgress/@Model.CourseId');
                const result = await res.json();
                if (result.success) {
                    const data = result.data;
                    const pct = Math.round(data.progressPercentage);
                    document.getElementById('top-progress-bar').style.width = pct + '%';
                    document.getElementById('top-progress-text').textContent = pct + '% complete';

                    // Update checkmarks in sidebar
                    if (data.completedMaterialIds) {
                        completedMaterialIdsArray = data.completedMaterialIds;
                        data.completedMaterialIds.forEach(id => {
                            const checkIcon = document.getElementById('check-' + id);
                            if (checkIcon) checkIcon.classList.remove('hidden');
                        });
                    } else {
                        completedMaterialIdsArray = [];
                    }

                    // Update lesson locks (Sequential Progression)
                    updateSequentialLockState();
                    updateReviewFormVisibility();
                }
            } catch (e) {}
        }

        async function markAsCompleted(materialId) {
            try {
                await fetch('/Course/UpdateProgress', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ courseId: @Model.CourseId, materialId: materialId })
                });
                loadProgress();
                // Re-check eligibility after progress update
                loadLearnEligibility();
            } catch (e) {}
        }

        // Anti-seeking setup
        videoPlayer.ontimeupdate = () => {
            if (!videoPlayer.seeking && !isCurrentVideoCompleted) {
                maxPlayedTime = Math.max(maxPlayedTime, videoPlayer.currentTime);
            }
        };

        videoPlayer.onseeking = () => {
            if (!canSkipVideo() && !isCurrentVideoCompleted) {
                if (videoPlayer.currentTime > maxPlayedTime + 1.5) {
                    videoPlayer.currentTime = maxPlayedTime;
                    const Toast = Swal.mixin({
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 3000,
                        timerProgressBar: true
                    });
                    Toast.fire({
                        icon: 'info',
                        title: 'Please watch the video in order; fast-forwarding is disabled!'
                    });
                }
            }
        };

        // Anti-AFK (Tab Switching / Blur)
        document.addEventListener('visibilitychange', () => {
            if (document.hidden) {
                if (videoPlayer && !videoPlayer.paused) {
                    videoPlayer.pause();
                    const Toast = Swal.mixin({
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 3000,
                        timerProgressBar: true
                    });
                    Toast.fire({
                        icon: 'warning',
                        title: 'Video automatically paused because you switched tabs.'
                    });
                }
            }
        });

        window.addEventListener('blur', () => {
            if (videoPlayer && !videoPlayer.paused) {
                videoPlayer.pause();
            }
        });

        videoPlayer.onended = () => {
            if (currentMaterialId) {
                if (canSkipVideo() || isCurrentVideoCompleted || maxPlayedTime >= (videoPlayer.duration * 0.95)) {
                    markAsCompleted(currentMaterialId);
                } else {
                    const Toast = Swal.mixin({
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 4000,
                        timerProgressBar: true
                    });
                    Toast.fire({
                        icon: 'warning',
                        title: 'You must watch at least 95% of the video duration to complete this lesson.'
                    });
                }
            }
        };

        // ── Stats (dynamic from DB) ────────────────────────────────
