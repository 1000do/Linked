                const res = await fetch('/Course/GetLessonReviewStats/' + currentLessonId);
                const result = await res.json();
                if (result.success && result.data) {
                    const d = result.data;
                    const avgRating = d.averageRating !== undefined ? d.averageRating : (d.AverageRating !== undefined ? d.AverageRating : 0);
                    const totalReviews = d.totalReviews !== undefined ? d.totalReviews : (d.TotalReviews !== undefined ? d.TotalReviews : 0);
                    document.getElementById('learn-stats-avg').textContent = avgRating.toFixed(1);
                    document.getElementById('learn-stats-total').textContent = `${totalReviews} reviews`;
                    const avg = Math.round(avgRating);
