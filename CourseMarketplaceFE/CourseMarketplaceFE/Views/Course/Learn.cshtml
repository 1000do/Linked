        // ── currentUserId từ JWT ────────────────────────────────────────────────────
        const currentToken = `@Html.Raw(Context.Request.Cookies["AccessToken"] ?? "")`.trim();
        console.log("currentToken",currentToken);
        
        function decodeToken(token) {
            try {
                const base64Url = token.split('.')[1];
                const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
                const jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {
                    return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
                }).join(''));
                console.log("Decoded token: " + jsonPayload);
                return JSON.parse(jsonPayload);
            } catch (e) {
                console.error("Failed to decode token", e);
                return null;
            }
        }
        const decoded = decodeToken(currentToken);
        const currentUserId = decoded ? parseInt(decoded["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier"] || decoded["nameid"]) : null;
        const currentUserRole = decoded ? (decoded["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] || decoded["role"]) : null;

        function renderReviewItem(r) {
            const isOwn = currentUserId > 0 && (r.userId == currentUserId || r.UserId == currentUserId);
            if (r.reviewStatus === 'pending' && !isOwn) return '';
            const createdTime = r.createdAt ? new Date(r.createdAt).getTime() : 0;
            const updatedTime = r.updatedAt ? new Date(r.updatedAt).getTime() : 0;
            const isEdited = updatedTime && updatedTime > (createdTime + 60000);
            const isRemoved = r.isRemoved;
            return (r.isRemoved && r.reviewStatus === 'violating') ? `
                <div class="border-t border-slate-100 pt-6" id="review-card-${r.reviewId}">
                    <div class="flex gap-3 items-start">
                        <div class="w-8 h-8 rounded-full bg-slate-200 flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined text-[16px] text-slate-400">gavel</span>
                        </div>
                        <p class="text-sm text-slate-400 italic pt-1">${r.comment}</p>
                    </div>
                </div>
            ` : (r.reviewStatus === 'pending') ? `
                <div class="border-t border-slate-100 pt-6 group" id="review-card-${r.reviewId}">
                    <div class="flex gap-3 items-start p-3 bg-amber-50 rounded-xl border border-amber-200">
                        <div class="w-8 h-8 rounded-full bg-amber-100 flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined text-[16px] text-amber-500">hourglass_empty</span>
                        </div>
                        <div class="flex-1">
                            <p class="text-sm font-bold text-amber-800 mb-1">Review pending moderation</p>
                            <p class="text-sm text-amber-700">Your review is under moderation and will appear once it’s approved.</p>
                        </div>
                    </div>
                </div>
            ` : r.isRemoved ? `
                <div class="border-t border-slate-100 pt-6" id="review-card-${r.reviewId}">
                    <div class="flex gap-3 items-start">
                        <div class="w-8 h-8 rounded-full bg-slate-200 flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined text-[16px] text-slate-400">delete</span>
                        </div>
                        <p class="text-sm text-slate-400 italic pt-1">This review was removed by the author.</p>
                    </div>
                </div>
            ` : `
                <div class="border-t border-slate-100 pt-6 group" id="review-card-${r.reviewId}">
                    <div class="flex gap-4 mb-3">
                        <div class="w-10 h-10 rounded-full bg-[#191c1b] text-white flex items-center justify-center font-bold text-sm shrink-0 overflow-hidden">
                            ${r.userAvatarUrl ? `<img src="${r.userAvatarUrl}" class="w-full h-full object-cover" />` : r.userFullName.charAt(0)}
                        </div>
                        <div class="flex-1">
                            <div class="flex items-center justify-between mb-1">
                                <h4 class="font-bold text-sm text-[#191c1b]">
                                    ${r.userFullName}
                                    ${r.isInstructor ? '<span class="ml-2 bg-[#006a62]/10 text-[#006a62] text-[10px] px-2 py-0.5 rounded-full border border-[#006a62]/20">Instructor</span>' : ''}
                                </h4>
                                <div class="relative flex items-center gap-2">
                                    <span class="text-[11px] text-slate-400 font-medium">${new Date(r.createdAt).toLocaleDateString('en-US')}</span>
                                    ${(isEdited && !isRemoved) ? '<span class="text-[10px] text-slate-400 italic">(edited)</span>' : ''}
                                    ${(!isRemoved && !isOwn) ? `
                                    <div class="relative opacity-0 group-hover:opacity-100 focus-within:opacity-100 transition-opacity learn-review-menu-container">
                                        <button onclick="toggleLearnMenu(event, this)" class="w-7 h-7 flex items-center justify-center rounded-full hover:bg-slate-100 text-slate-400 hover:text-slate-700 transition-colors" title="More options">
                                            <span class="material-symbols-outlined text-[18px]">more_vert</span>
                                        </button>
                                        <div class="learn-review-menu hidden absolute right-0 top-8 z-30 min-w-[160px] bg-white border border-slate-200 rounded-2xl shadow-xl py-1.5">
                                            <button onclick="reportReview(${r.reviewId}, '${r.lessonId ? 'lesson' : 'course'}'); closeAllLearnMenus()" class="w-full text-left px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50 flex items-center gap-2">
                                                <span class="material-symbols-outlined text-[16px] text-orange-500">flag</span> Report
                                            </button>
                                        </div>
                                    </div>` : ''}
                                </div>
                            </div>
                            <div class="flex items-center gap-3 mb-2">
                                ${(!isRemoved && r.rating > 0) ? `
                                <div class="flex text-amber-500">
                                    ${Array(5).fill(0).map((_, i) => `
                                        <span class="material-symbols-outlined text-[14px] ${i < r.rating ? 'fill-1' : ''}">star</span>
                                    `).join('')}
                                </div>` : ''}
                                ${r.lessonTitle ? `
                                    <div class="flex items-center gap-1 bg-slate-100 text-slate-500 text-[10px] px-2 py-0.5 rounded border border-slate-200">
                                        <span class="material-symbols-outlined text-[12px]">menu_book</span>
                                        ${r.lessonTitle}
                                    </div>
                                ` : `
                                    <div class="flex items-center gap-1 bg-amber-50 text-amber-600 text-[10px] px-2 py-0.5 rounded border border-amber-200">
                                        <span class="material-symbols-outlined text-[12px]">auto_awesome</span>
                                        General review
                                    </div>
                                `}
                            </div>
                            <p class="text-sm ${isRemoved ? 'text-slate-400 italic' : 'text-slate-700'} leading-relaxed" id="review-text-${r.reviewId}">${r.comment}</p>
                            ${(isOwn && !isRemoved) ? `
                            <div class="flex items-center gap-3 mt-2">
                                <button onclick="editLearnReview(${r.reviewId}, '${r.lessonId ? 'lesson' : 'course'}', ${r.rating}, ${JSON.stringify(r.comment).replace(/"/g, '&quot;')})" class="flex items-center gap-1 text-xs font-semibold text-slate-500 hover:text-blue-600 transition-colors">
                                    <span class="material-symbols-outlined text-[14px]">edit</span> Edit
                                </button>
                                <button onclick="deleteLearnReview(${r.reviewId}, '${r.lessonId ? 'lesson' : 'course'}')" class="flex items-center gap-1 text-xs font-semibold text-slate-500 hover:text-red-600 transition-colors">
                                    <span class="material-symbols-outlined text-[14px]">delete</span> Delete
                                </button>
                            </div>` : ''}
                            <!-- Edit form (hidden) -->
                            ${!isRemoved ? `
                            <div id="edit-form-${r.reviewId}" class="hidden mt-3 p-3 bg-slate-50 rounded-2xl border border-slate-200">
                                <div class="flex gap-1 mb-2" id="edit-stars-${r.reviewId}">
                                    ${Array(5).fill(0).map((_, i) => `
                                        <button type="button" onclick="setLearnEditRating(${r.reviewId}, ${i+1})" class="learn-edit-star text-slate-300 hover:text-amber-500 transition-colors">
                                            <span class="material-symbols-outlined text-[20px]">star</span>
                                        </button>
                                    `).join('')}
                                    <input type="hidden" id="edit-rating-${r.reviewId}" value="${r.rating}" />
                                </div>
                                <textarea id="edit-comment-${r.reviewId}" rows="3" class="w-full rounded-xl border-slate-200 text-sm p-2 focus:ring-[#006a62] resize-none">${r.comment}</textarea>
                                <div class="flex gap-2 mt-2">
                                    <button onclick="saveLearnEditReview(${r.reviewId}, '${r.lessonId ? 'lesson' : 'course'}')" class="px-4 py-1.5 bg-[#006a62] text-white text-xs font-bold rounded-xl hover:bg-[#004d48] transition-colors">Save</button>
                                    <button onclick="cancelLearnEdit(${r.reviewId})" class="px-4 py-1.5 bg-slate-100 text-slate-600 text-xs font-bold rounded-xl hover:bg-slate-200 transition-colors">Cancel</button>
                                </div>
                            </div>` : ''}
                        </div>
                    </div>
                </div>
            `;
        }

        function renderErrorState(message, retryFuncStr) {
            return `
                <div class="flex flex-col items-center justify-center py-8 px-4 text-center max-w-sm mx-auto">
                    <div class="w-12 h-12 bg-red-50 text-red-500 rounded-full flex items-center justify-center mb-3">
                        <span class="material-symbols-outlined text-[24px]">error_outline</span>
                    </div>
                    <h4 class="text-slate-800 font-bold text-sm mb-1">Failed to load content</h4>
                    <p class="text-slate-400 text-xs mb-4 leading-relaxed">${message}</p>
                    ${retryFuncStr ? `
                    <button onclick="${retryFuncStr}" class="px-4 py-1.5 bg-[#006a62] hover:bg-[#00544e] text-white text-xs font-bold rounded-xl transition-all flex items-center gap-1.5 shadow-sm">
                        <span class="material-symbols-outlined text-[14px]">refresh</span> Retry
                    </button>
                    ` : ''}
                </div>
            `;
        }

        // ── Menu helpers ─────────────────────────────────────────────────
        function toggleLearnMenu(event, btn) {
            event.stopPropagation();
            const menu = btn.nextElementSibling;
            const container = btn.parentElement;
            const isHidden = menu.classList.contains('hidden');
            closeAllLearnMenus();
            if (isHidden) {
                menu.classList.remove('hidden');
                if (container) container.classList.add('menu-open');
            }
        }
        function closeAllLearnMenus() {
            document.querySelectorAll('.learn-review-menu').forEach(m => m.classList.add('hidden'));
            document.querySelectorAll('.learn-review-menu-container').forEach(c => c.classList.remove('menu-open'));
        }

        document.addEventListener('click', function(e) {
            if (!e.target.closest('.learn-review-menu')) {
                closeAllLearnMenus();
            }
        });

        // ── Edit helpers ────────────────────────────────────────────────
        function editLearnReview(reviewId, type, currentRating, currentComment) {
            document.getElementById(`edit-form-${reviewId}`).classList.remove('hidden');
            document.getElementById(`review-text-${reviewId}`).classList.add('hidden');
            setLearnEditRating(reviewId, Math.round(currentRating));
        }
        function cancelLearnEdit(reviewId) {
            document.getElementById(`edit-form-${reviewId}`).classList.add('hidden');
            document.getElementById(`review-text-${reviewId}`).classList.remove('hidden');
        }
        function setLearnEditRating(reviewId, n) {
            document.getElementById(`edit-rating-${reviewId}`).value = n;
            document.querySelectorAll(`#edit-stars-${reviewId} .learn-edit-star`).forEach((btn, i) => {
                const icon = btn.querySelector('.material-symbols-outlined');
                if (i < n) { btn.classList.add('text-amber-500'); btn.classList.remove('text-slate-300'); icon.classList.add('fill-1'); }
                else { btn.classList.remove('text-amber-500'); btn.classList.add('text-slate-300'); icon.classList.remove('fill-1'); }
            });
        }
        async function saveLearnEditReview(reviewId, type) {
            const rating = parseFloat(document.getElementById(`edit-rating-${reviewId}`).value);
            const comment = document.getElementById(`edit-comment-${reviewId}`).value.trim();
            if (!rating || rating < 1) return Swal.fire('Error', 'Please select a rating.', 'warning');
            if (!comment) return Swal.fire('Error', 'Comment cannot be empty.', 'warning');
            try {
                const res = await fetch(`/Course/UpdateReview?reviewId=${reviewId}&type=${type}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ rating, comment, type })
                });
                const result = await res.json();
                if (result.success) {
                    showSwalLikeSuccessPopup('Updated!', result.message || 'Your review has been updated.', () => {
                        loadReviews(currentLearnReviewPage);
                        loadLearnStats();
                        loadLessonRatings();
                    });
                } else {
                    Swal.fire('Error', result.message || 'Could not update review.', 'error');
                }
            } catch { Swal.fire('Error', 'Could not connect to server.', 'error'); }
        }
        async function deleteLearnReview(reviewId, type) {
            const confirm = await Swal.fire({
                title: 'Delete this review?', text: 'This action cannot be undone.',
                icon: 'warning', showCancelButton: true,
                confirmButtonColor: '#ef4444', confirmButtonText: 'Yes, delete it',
                cancelButtonText: 'Cancel',
                customClass: { popup: 'rounded-3xl' }
            });
            if (!confirm.isConfirmed) return;
            try {
                const res = await fetch(`/Course/DeleteReview?reviewId=${reviewId}&type=${type}`, { method: 'DELETE' });
                const result = await res.json();
            if (result.success) {
                loadReviews(currentLearnReviewPage);
                loadLearnStats();
                loadLessonRatings();
                loadLearnEligibility();
                Swal.fire({ icon: 'success', title: 'Deleted', timer: 1200, showConfirmButton: false });
            } else if (res.status === 400 && result.message && result.message.includes('moderation')) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Under Moderation',
                    text: 'This review is currently under review by our moderation team and cannot be deleted at this time.',
                    confirmButtonText: 'OK',
                    customClass: { popup: 'rounded-3xl' }
                });
            } else {
                    Swal.fire('Error', result.message || 'Could not delete review.', 'error');
                }
            } catch { Swal.fire('Error', 'Could not connect to server.', 'error'); }
        }

        // ── Sidebar: Load lesson avg ratings ──────────────────────────────
        let lessonRatingMap = {}; // { lessonId: { averageRating, totalReviews } }
        async function loadLessonRatings() {
            try {
                const res = await fetch('/Course/GetLessonRatings/@Model.CourseId');
                const result = await res.json();
                if (result.success && Array.isArray(result.data)) {
                    lessonRatingMap = {};
                    result.data.forEach(x => {
                        const lid = x.lessonId !== undefined ? x.lessonId : x.LessonId;
                        if (lid !== undefined) {
                            lessonRatingMap[lid] = x;
                        }
                    });
                    // Cập nhật badge rating trên tất cả lesson items
                    document.querySelectorAll('[data-lesson-id]').forEach(el => {
                        const lid = parseInt(el.dataset.lessonId);
                        const ratingInfo = lessonRatingMap[lid];
                        const badge = el.querySelector('.lesson-rating-badge');
                        if (badge) {
                            if (ratingInfo) {
                                const avg = ratingInfo.averageRating !== undefined ? ratingInfo.averageRating : ratingInfo.AverageRating;
                                if (avg !== undefined && avg !== null) {
                                    badge.textContent = `★ ${parseFloat(avg).toFixed(1)}`;
                                    badge.classList.remove('hidden');
                                    return;
                                }
                            }
                            badge.classList.add('hidden');
                        }
                    });
                }
            } catch (e) { console.error('Error loading lesson ratings:', e); }
        }
        // ── Tab Switching ──────────────────────────────────────────
        function switchTab(tabId, element) {
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('border-b-2', 'border-[#006a62]', 'text-[#006a62]');
                btn.classList.add('text-slate-400');
            });
            element.classList.add('border-b-2', 'border-[#006a62]', 'text-[#006a62]');
            element.classList.remove('text-slate-400');

            document.querySelectorAll('.tab-content').forEach(content => content.classList.add('hidden'));
            document.getElementById('tab-' + tabId).classList.remove('hidden');

            if (tabId === 'reviews') {
                loadReviews(1);
                loadLearnStats();
                loadLearnEligibility();
            }
        }

        function playMaterial(url, title, description, element, type, materialId, lessonId, isPending = false) {
            if (lessonId) {
                const sectionEl = document.querySelector(`.lesson-section[data-lesson-id="${lessonId}"]`);
                if (sectionEl && sectionEl.dataset.isLocked === "true") {
                    Swal.fire({
                        title: 'Lesson Locked 🔒',
                        text: 'You need to complete all materials in previous lessons to unlock this lesson.',
                        icon: 'warning',
                        confirmButtonColor: '#006a62',
                        customClass: { popup: 'rounded-2xl shadow-xl' }
                    });
                    return;
                }
            }

            if (!url) {
                Swal.fire({
                    title: 'Empty Material',
                    text: 'This lesson does not have any uploaded materials yet.',
                    icon: 'info',
                    confirmButtonColor: '#006a62',
                    background: '#ffffff',
                    customClass: { popup: 'rounded-2xl shadow-xl' }
                });
                return;
            }
            currentMaterialId = materialId;
            currentLessonId = lessonId;
            updateReviewFormVisibility();

            // Show Reviews tab button when playing a lesson material
            const reviewsTabBtn = document.getElementById('btn-tab-reviews');
            if (reviewsTabBtn) reviewsTabBtn.classList.remove('hidden');

            // UI feedback
            document.querySelectorAll('.material-item').forEach(el => el.classList.remove('active-material'));
            element.classList.add('active-material');

            // Update Info
            titleEl.textContent = title;
            descEl.innerHTML = description || 'No description available.';

            const isVideo = type.startsWith('video') || type === 'mp4';

            if (isPending) {
                videoPlayer.classList.add('hidden');
                videoPlayer.pause();
                docViewer.classList.add('hidden');
                quizIframe.classList.add('hidden');
                document.getElementById('pending-viewer').classList.remove('hidden');
                return;
            } else {
                document.getElementById('pending-viewer').classList.add('hidden');
            }

            // Anti-skip setup
            isCurrentVideoCompleted = completedMaterialIdsArray.includes(materialId);
            maxPlayedTime = 0;

            if (isVideo) {
                quizIframe.classList.add('hidden');
                quizIframe.src = '';
                docViewer.classList.add('hidden');
                videoPlayer.classList.remove('hidden');
                videoLoader.classList.remove('hidden');
                
                if (docIframe) {
                    docIframe.src = '';
                    docIframe.classList.add('hidden');
                }
                if (docDownloadFallback) docDownloadFallback.classList.add('hidden');

                let optimizedUrl = url;
                if (url.includes('cloudinary.com/df8i0azc5/video/upload/')) {
                    optimizedUrl = url.replace('/video/upload/', '/video/upload/f_auto,q_auto/');
                }

                videoSource.src = optimizedUrl;
                videoPlayer.load();
                videoPlayer.play().catch(e => console.log('Auto-play blocked or failed:', e));
                
                videoPlayer.onloadeddata = () => {
                    videoLoader.classList.add('hidden');
                };
            } else {
                videoPlayer.classList.add('hidden');
                videoPlayer.pause();
                quizIframe.classList.add('hidden');
                quizIframe.src = '';
                docViewer.classList.remove('hidden');
                docTitle.textContent = title;
                
                var lowerUrl = url.toLowerCase();
                if (lowerUrl.endsWith('.txt')) {
                    if (docIframe) {
                        docIframe.src = '';
                        docIframe.classList.add('hidden');
                    }
                    if (docDownloadFallback) docDownloadFallback.classList.add('hidden');
                    
                    const txtViewer = document.getElementById('doc-txt-viewer');
                    const txtContent = document.getElementById('doc-txt-content');
                    if (txtViewer) txtViewer.classList.remove('hidden');
                    if (txtContent) txtContent.textContent = 'Loading content...';

                    fetch(url)
                        .then(res => res.arrayBuffer())
                        .then(buffer => {
                            const decoder = new TextDecoder('utf-8');
                            txtContent.textContent = decoder.decode(buffer);
                        })
                        .catch(err => {
                            txtContent.textContent = 'Error loading file: ' + err.message;
                        });
                    
                    markAsCompleted(materialId); // Mark text as completed immediately on view
                } else {
                    if (docIframe) {
                        docIframe.src = '';
                        docIframe.classList.add('hidden');
                    }
                    const txtViewer = document.getElementById('doc-txt-viewer');
                    if (txtViewer) txtViewer.classList.add('hidden');

                    if (docDownloadFallback) docDownloadFallback.classList.remove('hidden');
                    
                    let downloadUrl = url;
                    if (url.includes('cloudinary.com') && !url.includes('fl_attachment')) {
                        downloadUrl = url.replace(/\/upload\//, '/upload/fl_attachment/');
                    }
                    if (docDownloadBtn) {
                        docDownloadBtn.href = downloadUrl;
                        docDownloadBtn.onclick = () => markAsCompleted(materialId); // Mark when downloaded
                    }
                }
            }
            // If reviews tab is active, reload reviews and stats for the new lesson
            const reviewsTab = document.getElementById('tab-reviews');
            if (reviewsTab && !reviewsTab.classList.contains('hidden')) {
                loadReviews(1);
                loadLearnStats();
                loadLearnEligibility();
            }
        }

        function playQuiz(quizId, title, description, element) {
            const quizSectionEl = element.closest('.quiz-section');
            if (quizSectionEl && quizSectionEl.dataset.isLocked === "true") {
                const Toast = Swal.mixin({
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
                Toast.fire({
                    icon: 'warning',
                    title: 'Please complete all lessons in the course before taking the quiz!'
                });
                return;
            }

            currentMaterialId = null; // Quizzes are not marked complete via video API
            currentLessonId = null;

            // Hide Reviews tab button when taking a quiz
            const reviewsTabBtn = document.getElementById('btn-tab-reviews');
            if (reviewsTabBtn) reviewsTabBtn.classList.add('hidden');

            // Switch to overview tab if currently viewing reviews tab
            const reviewsTabContent = document.getElementById('tab-reviews');
            const overviewTabBtn = document.getElementById('btn-tab-overview');
            if (reviewsTabContent && !reviewsTabContent.classList.contains('hidden') && overviewTabBtn) {
                switchTab('overview', overviewTabBtn);
            }

            // UI feedback
            document.querySelectorAll('.material-item').forEach(el => el.classList.remove('active-material'));
            element.classList.add('active-material');

            // Update Info
            titleEl.textContent = title;
            descEl.innerHTML = description || 'No description available.';

            // Hide other viewers
            videoPlayer.classList.add('hidden');
            videoPlayer.pause();
            document.getElementById('pending-viewer').classList.add('hidden');
            docViewer.classList.add('hidden');
            
            // Show Quiz iframe
            quizIframe.classList.remove('hidden');
            quizIframe.src = '/QuizAttempt/Take/' + quizId;
        }

        window.addEventListener('DOMContentLoaded', () => {
            const firstItem = document.querySelector('.material-item');
            if (firstItem) {
                firstItem.classList.remove('active-material');
                firstItem.click();
            }
            if (window.location.hash && window.location.hash.startsWith('#review-card-')) {
                const reviewsBtn = document.querySelector('button[onclick="switchTab(\\\'reviews\\\', this)"]');
                if (reviewsBtn) reviewsBtn.click();
            }
            loadProgress();
            loadLessonRatings();
        });

        // Forced logout SignalR logic
        var localTokenForLayout = "@tokenForLayout";
        console.log("Token for layout:", localTokenForLayout);
        if (currentToken) {
            if (localStorage.getItem("AccountLocked") === "true") {
                localStorage.removeItem("AccountLocked");
                const form = document.getElementById('global-logout-form');
                if(form) { form.submit(); }
            }

            const notiConn = new signalR.HubConnectionBuilder()
                .withUrl("/notificationHub", { accessTokenFactory: () => currentToken })
                .withAutomaticReconnect().build();

            notiConn.on("ReceiveNotification", (noti) => {
                if (noti && noti.title && localStorage.getItem("AccountLocked") !== "true") {
                    const truncateText = (text, maxLength = 100) => {
                        if (!text) return "";
                        return text.length > maxLength ? text.substring(0, maxLength) + "..." : text;
                    };

                    const displayTitle = truncateText(noti.title, 255);
                    const displayContent = truncateText(noti.content, 100);

                    const Toast = Swal.mixin({
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 10000,
                        timerProgressBar: true,
                        width: '600px',
                        padding: '24px',
                        didOpen: (toast) => {
                            toast.addEventListener('mouseenter', Swal.stopTimer);
                            toast.addEventListener('mouseleave', Swal.resumeTimer);
                            
                            // Make entire toast clickable
                            toast.style.cursor = 'pointer';
                                toast.addEventListener('click', (e) => {
                                    if (e.target.tagName === 'BUTTON') return;
                                    e.preventDefault();
                                    const targetUrl = noti.linkAction || '/Notification';
                                    try {
                                        const urlObj = new URL(targetUrl, window.location.origin);
                                        if (urlObj.pathname.toLowerCase() === window.location.pathname.toLowerCase()) {
                                            window.location.href = targetUrl;
                                            window.location.reload();
                                        } else {
                                            window.location.href = targetUrl;
                                        }
                                    } catch (err) {
                                        window.location.href = targetUrl;
                                    }
                                });
                        }
                    });

                    Toast.fire({
                        icon: 'info',
                        title: displayTitle,
                        html: `
                            <div class="text-left font-body">
                                <p class="text-[12px] text-slate-600 mt-1 leading-relaxed">${displayContent}</p>
                                ${noti.linkAction ? `<a href="${noti.linkAction}" class="inline-block mt-2 text-[12px] font-bold text-emerald-600 hover:text-emerald-700 transition-colors">View Detail &rarr;</a>` : ''}
                            </div>
                        `
                    });
                }
            });

            notiConn.on("AccountLockedOut", () => {
                localStorage.setItem("AccountLocked", "true");
                Swal.fire({
                    icon: 'error',
                    title: 'Account Locked',
                    text: 'Your account has been locked due to a policy violation. You will be logged out automatically.',
                    timer: 5000,
                    timerProgressBar: true,
                    showConfirmButton: false,
                    allowOutsideClick: false,
                    allowEscapeKey: false
                }).then(() => {
                    document.getElementById('global-logout-form').submit();
                });
            });
            notiConn.start().catch(err => console.error("Noti Hub Error", err));
        }
    </script>
</body>
</html>


