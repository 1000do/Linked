                    ).join('');
                    const bars = [
                        { n: 5, pct: d.star5Pct !== undefined ? d.star5Pct : (d.Star5Pct !== undefined ? d.Star5Pct : 0) },
                        { n: 4, pct: d.star4Pct !== undefined ? d.star4Pct : (d.Star4Pct !== undefined ? d.Star4Pct : 0) },
                        { n: 3, pct: d.star3Pct !== undefined ? d.star3Pct : (d.Star3Pct !== undefined ? d.Star3Pct : 0) },
                        { n: 2, pct: d.star2Pct !== undefined ? d.star2Pct : (d.Star2Pct !== undefined ? d.Star2Pct : 0) },
                        { n: 1, pct: d.star1Pct !== undefined ? d.star1Pct : (d.Star1Pct !== undefined ? d.Star1Pct : 0) }
                    ];
                    document.getElementById('learn-stats-bars').innerHTML = bars.map(b => `
                        <div class="flex items-center gap-3 group cursor-pointer">
                            <div class="flex-1 h-2 bg-slate-100 rounded-full overflow-hidden">
