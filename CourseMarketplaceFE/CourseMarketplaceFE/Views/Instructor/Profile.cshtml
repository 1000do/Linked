@model CourseMarketplaceFE.Models.InstructorPublicProfileViewModel

@{
    ViewData["Title"] = $"{Model.FullName ?? "Instructor"} - Profile";
    string FixUrl(string? url) => string.IsNullOrWhiteSpace(url) ? "#" : (url.StartsWith("http://") || url.StartsWith("https://") ? url : "https://" + url);
}

<div class="bg-[#fcfcfd] min-h-screen pb-24 font-sans selection:bg-primary/10 selection:text-primary">
    <!-- Header/Hero Profile -->
    <div class="relative bg-gradient-to-br from-slate-950 via-indigo-950/90 to-slate-900 text-white overflow-hidden pt-20 pb-40">
        @* Background decorative elements *@
        <div class="absolute inset-0 opacity-30">
            <div class="absolute top-[-20%] left-[-10%] w-[50%] h-[70%] bg-indigo-600/30 rounded-full blur-[140px] animate-pulse"></div>
            <div class="absolute bottom-[-20%] right-[-10%] w-[40%] h-[60%] bg-teal-500/20 rounded-full blur-[120px] opacity-50"></div>
        </div>
        <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-10"></div>
        
        <div class="max-w-7xl mx-auto px-6 relative z-10">
            <div class="flex flex-col md:flex-row items-center md:items-start gap-12">
                <!-- Avatar with animation -->
                <div class="relative group">
                    <div class="absolute -inset-1 bg-gradient-to-r from-teal-400 to-indigo-500 rounded-full blur opacity-40 group-hover:opacity-85 transition duration-1000 group-hover:duration-200"></div>
                    <div class="relative w-44 h-44 md:w-56 md:h-56 rounded-full border-[6px] border-white/10 overflow-hidden shadow-2xl bg-slate-900 ring-4 ring-white/10 flex items-center justify-center">
                        @{
                            var avatarSrc = (!string.IsNullOrWhiteSpace(Model.AvatarUrl) && Model.AvatarUrl != "null") ? Model.AvatarUrl : "/img/default-instructor.png";
                        }
                        <img src="@avatarSrc" alt="@Model.FullName" 
                             class="w-full h-full object-cover scale-105 group-hover:scale-100 transition-transform duration-700" 
                             onerror="this.onerror=null; this.src='/img/default-instructor.png';" />
                    </div>
                    @* Badge for verified instructor *@
                    @if (Model.TotalStudents > 0 || Model.AverageRating >= 4.0m)
                    {
                        <div class="absolute bottom-4 right-4 w-12 h-12 bg-teal-500 rounded-2xl flex items-center justify-center shadow-2xl border-4 border-slate-950 transform rotate-12" title="Verified Instructor">
                            <span class="material-symbols-outlined text-white text-2xl fill-1">verified</span>
                        </div>
                    }
                </div>

                <!-- Info Section -->
                <div class="flex-1 text-center md:text-left">
                    @if (Model.AverageRating >= 4.5m && Model.TotalStudents >= 10)
                    {
                        <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-indigo-500/20 backdrop-blur-md rounded-full border border-indigo-400/30 mb-6 shadow-lg shadow-indigo-500/10">
                            <span class="w-2.5 h-2.5 bg-emerald-400 rounded-full animate-ping"></span>
                            <span class="text-xs font-black uppercase tracking-widest text-indigo-300">Top Instructor</span>
                        </div>
                    }
                    else
                    {
                        <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-white/10 backdrop-blur-md rounded-full border border-white/10 mb-6">
                            <span class="w-2.5 h-2.5 bg-teal-400 rounded-full"></span>
                            <span class="text-xs font-black uppercase tracking-widest text-slate-300">Instructor</span>
                        </div>
                    }
                    
                    <h1 class="text-5xl md:text-7xl font-black mb-4 tracking-tighter leading-none text-white drop-shadow-md">@Model.FullName</h1>
                    @if (!string.IsNullOrWhiteSpace(Model.ProfessionalTitle))
                    {
                        <p class="text-xl md:text-2xl text-indigo-200/90 font-medium mb-10 max-w-2xl leading-relaxed italic">"@Model.ProfessionalTitle"</p>
                    }
                    else
                    {
                        <div class="mb-8"></div>
                    }
                    
                    @* Premium Stats Layout *@
                    <div class="grid grid-cols-3 gap-4 md:gap-12 max-w-2xl">
                        <div class="group">
                            <p class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2 group-hover:text-teal-400 transition-colors">Students</p>
                            <div class="flex items-baseline gap-1">
                                <span class="text-3xl md:text-4xl font-black tabular-nums">@Model.TotalStudents.ToString("N0")</span>
                                @if (Model.TotalStudents > 0)
                                {
                                    <span class="text-xs font-bold text-teal-400">+</span>
                                }
                            </div>
                        </div>
                        <div class="group border-x border-white/10 px-4 md:px-12">
                            <p class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2 group-hover:text-amber-400 transition-colors">Reviews</p>
                            <div class="flex items-baseline gap-1">
                                <span class="text-3xl md:text-4xl font-black tabular-nums">@Model.TotalReviews.ToString("N0")</span>
                                <span class="text-[10px] font-bold text-slate-400">total</span>
                            </div>
                        </div>
                        <div class="group">
                            <p class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2 group-hover:text-indigo-400 transition-colors">Rating</p>
                            <div class="flex items-center gap-2">
                                <span class="text-3xl md:text-4xl font-black tabular-nums">@(Model.TotalReviews > 0 ? Model.AverageRating.ToString("F1") : "N/A")</span>
                                @if (Model.TotalReviews > 0)
                                {
                                    <span class="material-symbols-outlined text-amber-400 fill-1 text-2xl animate-pulse">star</span>
                                }
                                else
                                {
                                    <span class="material-symbols-outlined text-slate-500 text-2xl">star_outline</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Social Action Column -->
                <div class="flex md:flex-col gap-4">
                    @if (!string.IsNullOrEmpty(Model.LinkedinUrl))
                    {
                        <a href="@FixUrl(Model.LinkedinUrl)" target="_blank" rel="noopener noreferrer" class="w-14 h-14 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center hover:bg-[#0077b5] hover:border-transparent hover:shadow-[0_0_20px_rgba(0,119,181,0.4)] transition-all duration-300 group" title="LinkedIn">
                            <i class="fa-brands fa-linkedin-in text-2xl group-hover:scale-125 transition-transform"></i>
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(Model.YoutubeUrl))
                    {
                        <a href="@FixUrl(Model.YoutubeUrl)" target="_blank" rel="noopener noreferrer" class="w-14 h-14 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center hover:bg-[#ff0000] hover:border-transparent hover:shadow-[0_0_20px_rgba(255,0,0,0.4)] transition-all duration-300 group" title="YouTube">
                            <i class="fa-brands fa-youtube text-2xl group-hover:scale-125 transition-transform"></i>
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(Model.FacebookUrl))
                    {
                        <a href="@FixUrl(Model.FacebookUrl)" target="_blank" rel="noopener noreferrer" class="w-14 h-14 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center hover:bg-[#1877f2] hover:border-transparent hover:shadow-[0_0_20px_rgba(24,119,242,0.4)] transition-all duration-300 group" title="Facebook">
                            <i class="fa-brands fa-facebook-f text-2xl group-hover:scale-125 transition-transform"></i>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Section -->
    <div class="max-w-7xl mx-auto px-6 -mt-20 relative z-20">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
            
            <!-- Left Column: Bio & Courses -->
            <div class="lg:col-span-12 space-y-12">
                
                @* Bio Card *@
                <div class="bg-white rounded-[3rem] shadow-2xl shadow-slate-200/50 border border-slate-100 p-10 md:p-14 relative overflow-hidden">
                    <div class="absolute top-0 right-0 w-40 h-40 bg-slate-50 rounded-bl-[100px] -z-10"></div>
                    <h2 class="text-3xl font-black text-slate-900 mb-8 flex items-center gap-4">
                        <span class="w-10 h-10 bg-primary/10 text-primary rounded-xl flex items-center justify-center">
                            <span class="material-symbols-outlined">notes</span>
                        </span>
                        About the Instructor
                    </h2>
                    <div class="prose prose-lg max-w-none text-slate-600 leading-relaxed font-medium">
                        @if (!string.IsNullOrEmpty(Model.Bio))
                        {
                            @Html.Raw(Model.Bio)
                        }
                        else
                        {
                            <div class="py-10 text-center bg-slate-50 rounded-3xl border-2 border-dashed border-slate-200">
                                <span class="material-symbols-outlined text-4xl text-slate-300 mb-2">person_off</span>
                                <p class="text-slate-400">The instructor has not updated their introduction yet.</p>
                            </div>
                        }
                    </div>
                </div>

                @* Courses Section *@
                <div id="courses">
                    <div class="flex items-center justify-between mb-6 px-2">
                        <h2 class="text-2xl font-black text-slate-900 flex items-center gap-3">
                            <span class="w-9 h-9 bg-indigo-100 text-indigo-600 rounded-xl flex items-center justify-center">
                                <span class="material-symbols-outlined text-xl">auto_stories</span>
                            </span>
                            Teaching Courses (@Model.TotalCourses)
                        </h2>
                    </div>

                    @if (Model.Courses != null && Model.Courses.Any())
                    {
                        var pageSize = 8;
                        var totalCourses = Model.Courses.Count;
                        var totalPages = (int)Math.Ceiling((double)totalCourses / pageSize);

                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6" id="courses-container">
                            @{ var courseIdx = 0; }
                            @foreach (var course in Model.Courses)
                            {
                                var pageNum = (courseIdx / pageSize) + 1;
                                var isHidden = pageNum > 1 ? "hidden" : "";
                                <a href="/Course/Details/@course.CourseId" 
                                   data-page="@pageNum"
                                   class="profile-course-card @isHidden group bg-white rounded-2xl border border-slate-200/80 overflow-hidden hover:shadow-xl hover:border-indigo-300 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
                                    <div class="aspect-[16/9] relative overflow-hidden bg-slate-100">
                                        <img src="@(string.IsNullOrEmpty(course.ThumbnailUrl) ? "https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=600" : course.ThumbnailUrl)" 
                                             alt="@course.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                                        <div class="absolute top-3 right-3 bg-slate-900/80 backdrop-blur-md text-white text-xs font-black px-3 py-1 rounded-lg shadow-md">
                                            $@course.Price.ToString("F2")
                                        </div>
                                    </div>
                                    <div class="p-5 flex-1 flex flex-col justify-between">
                                        <div>
                                            <h3 class="text-base font-bold text-slate-800 line-clamp-2 leading-snug group-hover:text-indigo-600 transition-colors mb-4 min-h-[2.75rem] overflow-hidden" title="@course.Title">@course.Title</h3>
                                        </div>
                                        <div class="flex items-center justify-between pt-3 border-t border-slate-100 text-xs font-medium text-slate-500">
                                            <div class="flex items-center gap-1 text-amber-500 font-bold">
                                                <span class="material-symbols-outlined fill-1 text-base">star</span>
                                                <span>@(course.Rating > 0 ? course.Rating.ToString("F1") : "0.0")</span>
                                            </div>
                                            <div class="flex items-center gap-1 text-slate-400">
                                                <span class="material-symbols-outlined text-sm">group</span>
                                                <span>@course.TotalStudents.ToString("N0") students</span>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                                courseIdx++;
                            }
                        </div>

                        @if (totalPages > 1)
                        {
                            <div class="flex items-center justify-center gap-2 mt-10" id="pagination-controls">
                                <button onclick="changePage(currentPage - 1)" id="btn-prev" class="w-10 h-10 rounded-xl border border-slate-200 bg-white text-slate-600 flex items-center justify-center hover:bg-indigo-50 hover:text-indigo-600 hover:border-indigo-200 transition-all disabled:opacity-40 disabled:cursor-not-allowed shadow-sm">
                                    <span class="material-symbols-outlined text-xl">chevron_left</span>
                                </button>
                                
                                <div class="flex items-center gap-1.5" id="page-numbers">
                                    @for (int p = 1; p <= totalPages; p++)
                                    {
                                        <button onclick="changePage(@p)" data-p="@p" class="btn-page-num px-4 py-2 rounded-xl text-sm font-bold border transition-all shadow-sm @(p == 1 ? "bg-indigo-600 text-white border-indigo-600 shadow-indigo-600/20" : "bg-white text-slate-600 border-slate-200 hover:bg-slate-50")">
                                            @p
                                        </button>
                                    }
                                </div>

                                <button onclick="changePage(currentPage + 1)" id="btn-next" class="w-10 h-10 rounded-xl border border-slate-200 bg-white text-slate-600 flex items-center justify-center hover:bg-indigo-50 hover:text-indigo-600 hover:border-indigo-200 transition-all disabled:opacity-40 disabled:cursor-not-allowed shadow-sm">
                                    <span class="material-symbols-outlined text-xl">chevron_right</span>
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="py-16 text-center bg-white rounded-3xl border border-slate-100 shadow-xl shadow-slate-200/40">
                            <span class="material-symbols-outlined text-5xl text-slate-300 mb-3">auto_stories</span>
                            <h3 class="text-xl font-bold text-slate-700 mb-1">No courses published yet</h3>
                            <p class="text-sm text-slate-400">This instructor has not published any courses yet.</p>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script>
        let currentPage = 1;
        const totalPages = @(Model.Courses != null && Model.Courses.Any() ? (int)Math.Ceiling((double)Model.Courses.Count / 8) : 1);

        function changePage(page) {
            if (page < 1 || page > totalPages) return;
            currentPage = page;

            // Show/hide cards
            const cards = document.querySelectorAll('.profile-course-card');
            cards.forEach(card => {
                const cardPage = parseInt(card.getAttribute('data-page'));
                if (cardPage === currentPage) {
                    card.classList.remove('hidden');
                } else {
                    card.classList.add('hidden');
                }
            });

            // Update page number buttons
            const pageButtons = document.querySelectorAll('.btn-page-num');
            pageButtons.forEach(btn => {
                const p = parseInt(btn.getAttribute('data-p'));
                if (p === currentPage) {
                    btn.className = "btn-page-num px-4 py-2 rounded-xl text-sm font-bold border transition-all shadow-sm bg-indigo-600 text-white border-indigo-600 shadow-indigo-600/20";
                } else {
                    btn.className = "btn-page-num px-4 py-2 rounded-xl text-sm font-bold border transition-all shadow-sm bg-white text-slate-600 border-slate-200 hover:bg-slate-50";
                }
            });

            // Update Prev/Next buttons
            const btnPrev = document.getElementById('btn-prev');
            const btnNext = document.getElementById('btn-next');
            if (btnPrev) btnPrev.disabled = (currentPage === 1);
            if (btnNext) btnNext.disabled = (currentPage === totalPages);

            // Scroll to courses section
            const coursesSection = document.getElementById('courses');
            if (coursesSection) {
                coursesSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            if (totalPages > 1) {
                changePage(1);
            }
        });
    </script>
}
