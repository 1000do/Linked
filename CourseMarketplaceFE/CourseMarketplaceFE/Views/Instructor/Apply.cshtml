@model CourseMarketplaceFE.Models.InstructorApplyViewModel
@{
    ViewData["Title"] = "Register as Instructor";
    bool isVerified = ViewBag.IsEmailVerified ?? false;
}

<div class="min-h-screen pt-24 pb-20 bg-surface">
    <!-- TOP STEPPER & HEADER -->
    <div class="max-w-4xl mx-auto px-4 mb-10 text-center">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-bold uppercase tracking-wider mb-4">
            <span class="material-symbols-outlined text-sm" style='font-variation-settings: "FILL" 1;'>school</span>
            Instructor Onboarding
        </div>
        
        <h1 class="text-3xl sm:text-4xl font-headline font-extrabold text-on-surface tracking-tight">
            Become an Instructor
        </h1>
        <p class="text-slate-500 mt-2 text-sm max-w-lg mx-auto leading-relaxed">
            Share your expertise with thousands of active learners. Complete your teaching application below to begin.
        </p>

        @if (isVerified)
        {
            <!-- Stepper -->
            <div class="mt-8 max-w-xl mx-auto flex items-center justify-between relative px-4">
                <!-- Line behind -->
                <div class="absolute left-12 right-12 top-5 h-0.5 bg-slate-200 -z-0"></div>

                <!-- Step 1 (Active) -->
                <div class="flex flex-col items-center gap-2 relative z-10">
                    <div class="w-10 h-10 rounded-full bg-primary text-white font-headline font-bold text-sm flex items-center justify-center shadow-lg shadow-primary/30 ring-4 ring-surface">
                        1
                    </div>
                    <span class="text-xs font-bold text-on-surface">Application</span>
                </div>

                <!-- Step 2 (Pending) -->
                <div class="flex flex-col items-center gap-2 relative z-10">
                    <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-400 font-headline font-bold text-sm border border-slate-200 flex items-center justify-center ring-4 ring-surface">
                        2
                    </div>
                    <span class="text-xs font-semibold text-slate-400">Review</span>
                </div>

                <!-- Step 3 (Pending) -->
                <div class="flex flex-col items-center gap-2 relative z-10">
                    <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-400 font-headline font-bold text-sm border border-slate-200 flex items-center justify-center ring-4 ring-surface">
                        3
                    </div>
                    <span class="text-xs font-semibold text-slate-400">Payout Setup</span>
                </div>
            </div>
        }
    </div>

    @* ── EMAIL CHƯA XÁC THỰC → CHẶN ────────────────────── *@
    @if (!isVerified)
    {
        <div class="max-w-xl mx-auto px-4">
            <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/60 border border-slate-100 p-8 sm:p-10 text-center relative overflow-hidden">
                <div class="inline-flex items-center justify-center w-20 h-20 bg-amber-50 rounded-3xl border border-amber-100 mb-6 shadow-sm">
                    <span class="material-symbols-outlined text-amber-600 text-4xl">mail_lock</span>
                </div>
                <h2 class="text-2xl font-headline font-bold text-on-surface mb-3">Email Verification Required</h2>
                <p class="text-sm text-slate-500 mb-8 max-w-md mx-auto leading-relaxed">
                    To maintain a secure learning community and verify instructor identity, please complete your <strong>email verification</strong> before submitting an application.
                </p>
                <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
                    <a href="/Account/SendVerifyOtp"
                       class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 bg-gradient-to-r from-primary to-secondary text-white font-headline font-bold rounded-2xl shadow-lg shadow-primary/25 hover:shadow-xl hover:scale-[1.01] active:scale-[0.99] transition-all duration-300 text-sm">
                        <span class="material-symbols-outlined text-lg">verified</span>
                        Verify Email Now
                    </a>
                    <a href="/Account/Profile"
                       class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 bg-slate-100 text-slate-700 font-headline font-bold rounded-2xl hover:bg-slate-200 transition-all text-sm">
                        <span class="material-symbols-outlined text-lg">arrow_back</span>
                        Return to Profile
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
                
                @* ── LEFT COLUMN: GUIDELINES & STANDARDS (lg:col-span-5) ── *@
                <div class="lg:col-span-5 space-y-6">
                    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-100 shadow-xl shadow-slate-200/50">
                        <div class="flex items-center gap-3 mb-4">
                            <div class="w-10 h-10 rounded-2xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-[22px]">assignment_turned_in</span>
                            </div>
                            <div>
                                <h3 class="font-headline font-bold text-lg text-on-surface">Application Guide</h3>
                                <p class="text-xs text-slate-400">Quality standards for approval</p>
                            </div>
                        </div>

                        <p class="text-xs text-slate-500 leading-relaxed mb-6">
                            To ensure your profile stands out and passes our 24-hour admin review, please make sure your application meets these criteria:
                        </p>

                        <div class="space-y-4">
                            <div class="flex items-start gap-3.5 p-3.5 rounded-2xl bg-slate-50/70 border border-slate-100">
                                <div class="w-7 h-7 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 mt-0.5">
                                    <span class="material-symbols-outlined text-sm font-bold">check</span>
                                </div>
                                <div>
                                    <h4 class="text-xs font-bold text-slate-800">Professional CV / Resume</h4>
                                    <p class="text-[11px] text-slate-500 mt-0.5 leading-normal">
                                        Highlight verifiable teaching experience, industry projects, or academic achievements in your field.
                                    </p>
                                </div>
                            </div>

                            <div class="flex items-start gap-3.5 p-3.5 rounded-2xl bg-slate-50/70 border border-slate-100">
                                <div class="w-7 h-7 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 mt-0.5">
                                    <span class="material-symbols-outlined text-sm font-bold">check</span>
                                </div>
                                <div>
                                    <h4 class="text-xs font-bold text-slate-800">Clear Area of Expertise</h4>
                                    <p class="text-[11px] text-slate-500 mt-0.5 leading-normal">
                                        Specify distinct technical domains or subjects so students can easily discover your upcoming courses.
                                    </p>
                                </div>
                            </div>

                            <div class="flex items-start gap-3.5 p-3.5 rounded-2xl bg-slate-50/70 border border-slate-100">
                                <div class="w-7 h-7 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 mt-0.5">
                                    <span class="material-symbols-outlined text-sm font-bold">check</span>
                                </div>
                                <div>
                                    <h4 class="text-xs font-bold text-slate-800">Valid Verification Files</h4>
                                    <p class="text-[11px] text-slate-500 mt-0.5 leading-normal">
                                        Accepted formats are PDF, JPG, and PNG. Maximum size is 5MB per document.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="mt-6 pt-6 border-t border-slate-100 flex items-center gap-3">
                            <span class="material-symbols-outlined text-primary text-xl shrink-0">help</span>
                            <p class="text-xs text-slate-500">Need help with your application? Contact <a href="/Chat" class="text-primary font-bold hover:underline">Support</a>.</p>
                        </div>
                    </div>

                    <!-- Promotion/Community Banner Card -->
                    <div class="bg-gradient-to-br from-primary to-secondary rounded-3xl p-6 sm:p-8 text-white shadow-xl shadow-primary/20 relative overflow-hidden group">
                        <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-white/10 rounded-full blur-2xl group-hover:scale-125 transition-transform duration-500"></div>
                        <div class="relative z-10">
                            <span class="inline-block px-3 py-1 rounded-full bg-white/15 backdrop-blur-md text-[10px] font-bold tracking-wider uppercase mb-3">
                                Instructor Benefits
                            </span>
                            <h3 class="font-headline font-bold text-lg mb-2">Build Your Educating Legacy</h3>
                            <p class="text-xs text-white/80 leading-relaxed mb-4">
                                Create engaging video courses, reach passionate learners worldwide, and receive direct, secure payouts directly via Stripe Connect.
                            </p>
                            <div class="flex items-center gap-2 text-xs font-bold text-primary-container">
                                <span>Learn about instructor terms</span>
                                <span class="material-symbols-outlined text-sm">arrow_forward</span>
                            </div>
                        </div>
                    </div>
                </div>

                @* ── RIGHT COLUMN: FORM (lg:col-span-7) ── *@
                <div class="lg:col-span-7">
                    <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 p-6 sm:p-10 relative">

                        @* ── RESUBMIT BANNER ── *@
                        @if (Model.IsResubmit)
                        {
                            <div class="bg-amber-50/90 border border-amber-200 rounded-2xl p-5 mb-8 flex items-start gap-4">
                                <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-outlined">warning</span>
                                </div>
                                <div class="flex-1">
                                    <h4 class="text-sm font-headline font-bold text-amber-900 mb-1">Application Revision Required</h4>
                                    <p class="text-xs text-amber-800 leading-relaxed">
                                        Please review and update your information or documents below. When ready, click <strong>Resubmit Application</strong> for a re-evaluation under your existing account.
                                    </p>
                                </div>
                            </div>
                        }

                        <div class="mb-6 border-b border-slate-100 pb-5">
                            <h2 class="text-xl font-headline font-extrabold text-on-surface">Instructor Application Form</h2>
                            <p class="text-xs text-slate-400 mt-1">Please provide accurate professional details and documentation.</p>
                        </div>

                        <form asp-action="Apply" asp-controller="Instructor" method="post" enctype="multipart/form-data" class="space-y-6">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="IsResubmit" />
                            <input type="hidden" asp-for="ExistingDocumentUrl" />

                            @* Professional Title (Full Width Row) *@
                            <div>
                                <label class="flex items-center gap-2 text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                                    <span class="material-symbols-outlined text-base text-primary">badge</span>
                                    Professional Title <span class="text-red-500">*</span>
                                </label>
                                <input asp-for="ProfessionalTitle" type="text" placeholder="e.g., Senior Solution Architect & Cloud Developer"
                                       class="w-full px-4 py-3.5 bg-slate-50/70 border border-slate-200 rounded-2xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-sm font-medium text-slate-800 placeholder:text-slate-400" />
                                <span asp-validation-for="ProfessionalTitle" class="text-xs text-red-500 mt-1 block"></span>
                            </div>

                            @* Areas of Expertise (Full Width Row) *@
                            <div>
                                <label class="flex items-center gap-2 text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                                    <span class="material-symbols-outlined text-base text-primary">category</span>
                                    Areas of Expertise <span class="text-red-500">*</span>
                                </label>
                                
                                <div class="relative">
                                    <!-- Hidden input to store comma-separated values for form submission -->
                                    <input type="hidden" asp-for="ExpertiseCategories" id="hiddenExpertiseCategories" />
                                    
                                    <div id="expertise-tag-box" class="flex flex-wrap gap-2 px-4 py-3.5 bg-slate-50/70 border border-slate-200 rounded-2xl min-h-[52px] focus-within:bg-white focus-within:ring-2 focus-within:ring-primary/20 focus-within:border-primary transition-all cursor-text" onclick="document.getElementById('expertiseInput').focus()">
                                        <input type="text" id="expertiseInput" class="flex-1 bg-transparent border-none text-sm outline-none px-1 min-w-[150px] font-medium text-slate-800 placeholder:text-slate-400" placeholder="Type category and press Enter...">
                                    </div>
                                    <div id="expertise-suggestions" class="hidden absolute left-0 right-0 top-full mt-1 bg-white border border-slate-200 shadow-xl rounded-xl z-20 max-h-48 overflow-y-auto py-1"></div>
                                </div>

                                <p class="text-[11px] text-slate-400 mt-1.5 font-medium">List the main technical domains, programming languages, or topics you specialize in teaching.</p>
                                <span asp-validation-for="ExpertiseCategories" class="text-xs text-red-500 mt-1 block"></span>
                            </div>

                            @* Row 2: LinkedIn and Stripe Country *@
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                                <div>
                                    <label class="flex items-center gap-2 text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                                        <span class="material-symbols-outlined text-base text-primary">link</span>
                                        LinkedIn Profile
                                    </label>
                                    <input asp-for="LinkedinUrl" type="url" placeholder="https://linkedin.com/in/yourname"
                                           class="w-full px-4 py-3.5 bg-slate-50/70 border border-slate-200 rounded-2xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-sm font-medium text-slate-800 placeholder:text-slate-400" />
                                    <span asp-validation-for="LinkedinUrl" class="text-xs text-red-500 mt-1 block"></span>
                                </div>

                                <div>
                                    <label class="flex items-center gap-2 text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                                        <span class="material-symbols-outlined text-base text-primary">public</span>
                                        Stripe Payout Country <span class="text-red-500">*</span>
                                    </label>
                                    <select asp-for="StripeCountry" asp-items="Model.AvailableCountries"
                                            class="w-full px-4 py-3.5 bg-slate-50/70 border border-slate-200 rounded-2xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-sm font-medium text-slate-800 cursor-pointer">
                                        <option value="">-- Select Country --</option>
                                    </select>
                                    <span asp-validation-for="StripeCountry" class="text-xs text-red-500 mt-1 block"></span>
                                </div>
                            </div>

                            @* Row 3: YouTube and Facebook *@
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                                <div>
                                    <label class="flex items-center gap-2 text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                                        <span class="material-symbols-outlined text-base text-primary">video_library</span>
                                        YouTube Channel
                                    </label>
                                    <input asp-for="YoutubeUrl" type="url" placeholder="https://youtube.com/@@yourchannel"
                                           class="w-full px-4 py-3.5 bg-slate-50/70 border border-slate-200 rounded-2xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-sm font-medium text-slate-800 placeholder:text-slate-400" />
                                </div>

                                <div>
                                    <label class="flex items-center gap-2 text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                                        <span class="material-symbols-outlined text-base text-primary">group</span>
                                        Facebook Profile
                                    </label>
                                    <input asp-for="FacebookUrl" type="url" placeholder="https://facebook.com/yourprofile"
                                           class="w-full px-4 py-3.5 bg-slate-50/70 border border-slate-200 rounded-2xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-sm font-medium text-slate-800 placeholder:text-slate-400" />
                                </div>
                            </div>

                            @* Document Upload Section *@
                            <div class="pt-6 border-t border-slate-100">
                                <div class="flex items-center justify-between mb-3">
                                    <div>
                                        <label class="flex items-center gap-2 text-sm font-headline font-extrabold text-on-surface">
                                            <span class="material-symbols-outlined text-lg text-primary">folder_managed</span>
                                            Verification Documents (Max 3) <span class="text-red-500">*</span>
                                        </label>
                                        <p class="text-xs text-slate-400 mt-0.5">Upload CV, diplomas, certificates, or identity verification.</p>
                                    </div>
                                    <span class="text-xs font-bold px-3 py-1 bg-slate-100 rounded-full text-slate-600">
                                        Selected: <span id="files-uploaded-count" class="font-extrabold text-primary">0</span>/3
                                    </span>
                                </div>

                                @* Retained documents for resubmit *@
                                @if (Model.IsResubmit && Model.ExistingDocumentUrls != null && Model.ExistingDocumentUrls.Any())
                                {
                                    <div class="mb-4 space-y-2 bg-slate-50/80 p-4 rounded-2xl border border-slate-200/80">
                                        <p class="text-xs font-bold text-slate-600 uppercase tracking-wider mb-2">Current Stored Documents:</p>
                                        <div class="grid grid-cols-1 gap-2" id="retained-documents-list">
                                            @for (int i = 0; i < Model.ExistingDocumentUrls.Count; i++)
                                            {
                                                var url = Model.ExistingDocumentUrls[i];
                                                var ext = System.IO.Path.GetExtension(url).ToLower();
                                                var iconName = (ext == ".pdf") ? "picture_as_pdf" : "image";
                                                <div class="flex items-center justify-between p-3.5 bg-white rounded-xl border border-slate-200 shadow-sm transition-all hover:border-primary/40" id="retained-doc-@i">
                                                    <input type="hidden" name="RetainedDocumentUrls" value="@url" id="retained-input-@i" />
                                                    <div class="flex items-center gap-3 truncate">
                                                        <div class="w-9 h-9 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
                                                            <span class="material-symbols-outlined text-lg">@iconName</span>
                                                        </div>
                                                        <a href="@url" target="_blank" class="text-xs text-on-surface font-bold hover:text-primary truncate max-w-sm">
                                                            Document #@(i + 1) (@ext.TrimStart('.'))
                                                        </a>
                                                    </div>
                                                    <div class="flex items-center gap-2">
                                                        <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2.5 py-0.5 rounded-full uppercase tracking-wider">Stored</span>
                                                        <button type="button" class="w-8 h-8 rounded-full bg-slate-100 text-slate-400 hover:bg-rose-50 hover:text-rose-600 transition-all flex items-center justify-center active:scale-90 border-0 cursor-pointer" onclick="removeRetainedDocument(@i)" title="Remove stored file">
                                                            <span class="material-symbols-outlined text-[18px]">close</span>
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                <!-- Dynamic Document Slots Container -->
                                <div id="document-slots-container" class="space-y-4 mt-3">
                                    <!-- Slots will be injected here dynamically by JavaScript -->
                                </div>

                                <!-- Add Slot Button -->
                                <div class="mt-4 flex justify-end">
                                    <button type="button" id="add-slot-btn" class="inline-flex items-center gap-2 px-5 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-headline font-bold text-xs rounded-2xl border border-slate-200/80 transition-all shadow-sm active:scale-95 cursor-pointer">
                                        <span class="material-symbols-outlined text-base font-bold">add</span>
                                        Add Another Document Slot
                                    </button>
                                </div>
                                <span asp-validation-for="DocumentFiles" class="text-xs text-red-500 mt-2 block"></span>
                            </div>

                            @* Bottom Actions Bar *@
                            <div class="pt-6 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4">
                                <a href="/Account/Profile" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 text-xs font-bold text-slate-500 hover:text-slate-800 transition-colors py-3 px-4 rounded-xl hover:bg-slate-50">
                                    <span class="material-symbols-outlined text-base">arrow_back</span>
                                    Back to Profile
                                </a>

                                <button type="submit"
                                        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 bg-gradient-to-r from-primary to-secondary text-white font-headline font-bold rounded-2xl shadow-lg shadow-primary/25 hover:shadow-xl hover:shadow-primary/30 hover:scale-[1.01] active:scale-[0.99] transition-all duration-300 text-sm">
                                    <span class="material-symbols-outlined text-lg">send</span>
                                    @(Model.IsResubmit ? "Resubmit Application" : "Submit Application")
                                </button>
                            </div>
                        </form>

                        <!-- Privacy / Security Note -->
                        <div class="mt-8 pt-6 border-t border-slate-100 flex items-start sm:items-center gap-3 text-xs text-slate-500 bg-surface/60 p-4 rounded-2xl border border-primary/10">
                            <span class="material-symbols-outlined text-primary text-xl shrink-0 mt-0.5 sm:mt-0">verified_user</span>
                            <span>Your professional information and uploaded verification files are securely encrypted and evaluated exclusively by LinkedLearn administration under strict privacy standards.</span>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (ViewBag.ApiError != null)
    {
        <script>
            Swal.fire({
                title: 'Submission Error',
                text: '@Html.Raw(ViewBag.ApiError)',
                icon: 'error',
                confirmButtonColor: '#006a62'
            });
        </script>
    }

    <script>
        let slots = [];
        let nextSlotId = 1;
        let retainedCount = @(Model.IsResubmit && Model.ExistingDocumentUrls != null ? Model.ExistingDocumentUrls.Count : 0);

        document.addEventListener('DOMContentLoaded', () => {
            const addBtn = document.getElementById('add-slot-btn');
            if (addBtn) {
                addBtn.addEventListener('click', addSlot);
            }
            if (retainedCount === 0) {
                addSlot();
            } else {
                updateTotalCount();
            }
        });

        function getSlotHtml(slotId) {
            return `
                <div class="document-slot bg-slate-50/50 rounded-3xl border border-slate-200/80 p-5 transition-all hover:bg-slate-50 hover:border-slate-300 relative group" id="slot-${slotId}" data-slot-id="${slotId}">
                    <input type="file" name="DocumentFiles" accept=".pdf,.jpg,.jpeg,.png" class="hidden slot-file-input" id="file-input-${slotId}" onchange="onFileInputChange(${slotId}, event)" />
                    
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-2">
                            <span class="w-6 h-6 rounded-full bg-primary/10 text-primary flex items-center justify-center text-xs font-bold font-headline">${slotId}</span>
                            <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">Document / Certificate #${slotId}</span>
                        </div>
                        <button type="button" class="w-8 h-8 rounded-full bg-slate-100 text-slate-400 hover:bg-rose-50 hover:text-rose-600 transition-all flex items-center justify-center active:scale-95 border-0 cursor-pointer" onclick="removeSlot(${slotId})" title="Remove slot">
                            <span class="material-symbols-outlined text-[18px]">close</span>
                        </button>
                    </div>

                    <!-- Empty State (Dashed Upload Zone) -->
                    <div class="empty-state border-2 border-dashed border-slate-200 rounded-2xl p-6 text-center cursor-pointer hover:border-primary/50 hover:bg-primary/[0.02] transition-all duration-300 flex flex-col items-center justify-center gap-2" id="empty-state-${slotId}" onclick="triggerFileInput(${slotId})">
                        <div class="w-12 h-12 bg-white rounded-2xl shadow-sm border border-slate-100 text-primary flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                            <span class="material-symbols-outlined text-[24px]">cloud_upload</span>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-slate-700">Drag and drop file here or <span class="text-primary underline font-extrabold">browse</span></p>
                            <p class="text-[11px] text-slate-400 mt-0.5 font-medium">Accepted formats: PDF, JPG, PNG (Max 5MB)</p>
                        </div>
                    </div>
                    
                    <!-- Chosen State (File details) -->
                    <div class="chosen-state hidden bg-white border border-slate-200/80 rounded-2xl p-4 shadow-sm items-center justify-between gap-4" id="chosen-state-${slotId}">
                        <div class="flex items-center gap-3.5 min-w-0">
                            <div class="w-12 h-12 rounded-2xl flex items-center justify-center shrink-0 slot-file-icon-container">
                                <span class="material-symbols-outlined slot-file-icon text-[24px]">description</span>
                            </div>
                            <div class="min-w-0 truncate">
                                <p class="text-sm font-bold text-slate-800 truncate slot-file-name" id="file-name-${slotId}"></p>
                                <div class="flex items-center gap-2 mt-0.5">
                                    <span class="text-[11px] font-semibold text-slate-400 slot-file-size" id="file-size-${slotId}"></span>
                                    <span class="w-1 h-1 rounded-full bg-slate-300"></span>
                                    <span class="text-[11px] font-bold text-emerald-600 flex items-center gap-0.5">
                                        <span class="material-symbols-outlined text-[14px]">check_circle</span> Ready
                                    </span>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="text-xs font-bold text-primary hover:text-secondary hover:underline shrink-0 bg-transparent border-0 cursor-pointer" onclick="triggerFileInput(${slotId})">
                            Change file
                        </button>
                    </div>
                </div>
            `;
        }

        function triggerFileInput(slotId) {
            const input = document.getElementById(`file-input-${slotId}`);
            if (input) {
                input.click();
            }
        }

        function addSlot() {
            if (retainedCount + slots.length >= 3) return;

            const slotId = nextSlotId++;
            slots.push(slotId);

            const container = document.getElementById('document-slots-container');
            if (container) {
                container.insertAdjacentHTML('beforeend', getSlotHtml(slotId));
                initSlotDragAndDrop(slotId);
            }
            updateTotalCount();
        }

        function removeSlot(slotId) {
            const fileInput = document.getElementById(`file-input-${slotId}`);
            
            if (retainedCount + slots.length <= 1) {
                if (fileInput) {
                    fileInput.value = '';
                }
                const emptyDiv = document.getElementById(`empty-state-${slotId}`);
                const chosenDiv = document.getElementById(`chosen-state-${slotId}`);
                if (emptyDiv && chosenDiv) {
                    emptyDiv.classList.remove('hidden');
                    chosenDiv.classList.remove('flex');
                    chosenDiv.classList.add('hidden');
                }
            } else {
                const slotEl = document.getElementById(`slot-${slotId}`);
                if (slotEl) {
                    slotEl.remove();
                }
                slots = slots.filter(id => id !== slotId);
            }
            updateTotalCount();
        }

        function removeRetainedDocument(index) {
            const docEl = document.getElementById(`retained-doc-${index}`);
            const inputEl = document.getElementById(`retained-input-${index}`);
            if (docEl) docEl.remove();
            if (inputEl) inputEl.remove();

            retainedCount--;
            
            if (retainedCount + slots.length === 0) {
                addSlot();
            } else {
                updateTotalCount();
            }
        }

        function onFileInputChange(slotId, event) {
            const files = event.target.files;
            if (files && files.length > 0) {
                const file = files[0];
                if (validateFile(file)) {
                    updateSlotUI(slotId, file);
                } else {
                    event.target.value = '';
                    const emptyDiv = document.getElementById(`empty-state-${slotId}`);
                    const chosenDiv = document.getElementById(`chosen-state-${slotId}`);
                    if (emptyDiv && chosenDiv) {
                        emptyDiv.classList.remove('hidden');
                        chosenDiv.classList.remove('flex');
                        chosenDiv.classList.add('hidden');
                    }
                }
            }
            updateTotalCount();
        }

        function validateFile(file) {
            const allowedExtensions = ['.pdf', '.jpg', '.jpeg', '.png'];
            const maxBytes = 5 * 1024 * 1024;
            const ext = '.' + file.name.split('.').pop().toLowerCase();

            if (!allowedExtensions.includes(ext)) {
                Swal.fire({
                    title: 'Invalid Format',
                    text: `File "${file.name}" is not supported. Please upload PDF, JPG, or PNG only.`,
                    icon: 'error',
                    confirmButtonColor: '#006a62'
                });
                return false;
            }

            if (file.size > maxBytes) {
                Swal.fire({
                    title: 'File Too Large',
                    text: `File "${file.name}" exceeds the 5MB size limit.`,
                    icon: 'error',
                    confirmButtonColor: '#006a62'
                });
                return false;
            }

            return true;
        }

        function updateSlotUI(slotId, file) {
            const emptyDiv = document.getElementById(`empty-state-${slotId}`);
            const chosenDiv = document.getElementById(`chosen-state-${slotId}`);
            const nameEl = document.getElementById(`file-name-${slotId}`);
            const sizeEl = document.getElementById(`file-size-${slotId}`);
            const iconEl = document.querySelector(`#slot-${slotId} .slot-file-icon`);
            const iconContainer = document.querySelector(`#slot-${slotId} .slot-file-icon-container`);

            if (emptyDiv && chosenDiv && nameEl && sizeEl) {
                emptyDiv.classList.add('hidden');
                chosenDiv.classList.remove('hidden');
                chosenDiv.classList.add('flex');
                
                nameEl.textContent = file.name;
                const sizeMb = (file.size / (1024 * 1024)).toFixed(2);
                sizeEl.textContent = `${sizeMb} MB`;

                const ext = '.' + file.name.split('.').pop().toLowerCase();
                if (iconEl && iconContainer) {
                    if (ext === '.pdf') {
                        iconEl.textContent = 'picture_as_pdf';
                        iconContainer.className = 'w-12 h-12 bg-rose-50 text-rose-600 rounded-2xl flex items-center justify-center shrink-0 border border-rose-100 slot-file-icon-container';
                    } else {
                        iconEl.textContent = 'image';
                        iconContainer.className = 'w-12 h-12 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center shrink-0 border border-emerald-100 slot-file-icon-container';
                    }
                }
            }
        }

        function initSlotDragAndDrop(slotId) {
            const slotEl = document.getElementById(`slot-${slotId}`);
            if (!slotEl) return;

            ['dragenter', 'dragover'].forEach(eventName => {
                slotEl.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    if (!slotEl.classList.contains('bg-primary/10')) {
                        slotEl.classList.add('border-primary/80', 'bg-primary/10');
                    }
                }, false);
            });

            ['dragleave', 'drop'].forEach(eventName => {
                slotEl.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    slotEl.classList.remove('border-primary/80', 'bg-primary/10');
                }, false);
            });

            slotEl.addEventListener('drop', (e) => {
                const dt = e.dataTransfer;
                const files = dt.files;
                if (files && files.length > 0) {
                    const fileInput = document.getElementById(`file-input-${slotId}`);
                    if (fileInput) {
                        const file = files[0];
                        if (validateFile(file)) {
                            const dt2 = new DataTransfer();
                            dt2.items.add(file);
                            fileInput.files = dt2.files;
                            updateSlotUI(slotId, file);
                            updateTotalCount();
                        }
                    }
                }
            });
        }

        function updateTotalCount() {
            let filledCount = 0;
            slots.forEach(slotId => {
                const fileInput = document.getElementById(`file-input-${slotId}`);
                if (fileInput && fileInput.files && fileInput.files.length > 0) {
                    filledCount++;
                }
            });

            const totalFiles = retainedCount + filledCount;
            const countEl = document.getElementById('files-uploaded-count');
            if (countEl) {
                countEl.textContent = totalFiles;
            }

            const totalSlots = retainedCount + slots.length;
            const addBtn = document.getElementById('add-slot-btn');
            if (addBtn) {
                if (totalSlots >= 3) {
                    addBtn.classList.add('hidden');
                } else {
                    addBtn.classList.remove('hidden');
                }
            }
        }

        // --- EXPERTISE CATEGORIES AUTOCOMPLETE LOGIC ---
        const expertiseInput = document.getElementById('expertiseInput');
        const expertiseSuggestions = document.getElementById('expertise-suggestions');
        const hiddenExpertiseCategories = document.getElementById('hiddenExpertiseCategories');
        
        let allCategories = [];
        let selectedExpertise = [];

        // Pre-load if model already has some
        const initialExpertise = hiddenExpertiseCategories.value;
        if (initialExpertise) {
            selectedExpertise = initialExpertise.split(',').map(s => s.trim()).filter(s => s);
            // Limit to 1
            if (selectedExpertise.length > 1) {
                selectedExpertise = [selectedExpertise[0]];
            }
            renderExpertiseTags();
        }

        // Fetch categories from API
        async function fetchCategories() {
            try {
                const res = await fetch('/api/public/courses/categories');
                const apiResp = await res.json();
                if (apiResp.success && apiResp.data) {
                    // API returns list of CategoryResponse with categoriesName property
                    allCategories = apiResp.data.map(c => c.categoriesName); 
                }
            } catch (err) { console.error('Failed to load categories', err); }
        }
        fetchCategories();

        expertiseInput.addEventListener('input', (e) => {
            const query = e.target.value.toLowerCase().trim();
            if (query.length < 1) { 
                expertiseSuggestions.classList.add('hidden'); 
                return; 
            }
            
            // Filter locally instead of API call per keystroke
            const matched = allCategories.filter(c => c.toLowerCase().includes(query));
            
            if (matched.length > 0) {
                expertiseSuggestions.innerHTML = matched
                    .filter(m => !selectedExpertise.some(s => s.toLowerCase() === m.toLowerCase()))
                    .map(m => `<div class="px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-primary cursor-pointer transition-colors font-medium" onclick="addExpertiseTag('${m.replace(/'/g, "\\'")}')">${m}</div>`).join('');
                
                if (expertiseSuggestions.innerHTML) {
                    expertiseSuggestions.classList.remove('hidden');
                } else {
                    expertiseSuggestions.classList.add('hidden');
                }
            } else { 
                expertiseSuggestions.innerHTML = `<div class="px-4 py-2 text-sm text-slate-500 italic">No matching categories found...</div>`;
                expertiseSuggestions.classList.remove('hidden');
            }
        });

        function addExpertiseTag(val) {
            // Only allow 1 category to be selected
            selectedExpertise = [val]; 
            renderExpertiseTags(); 
            
            expertiseInput.value = '';
            expertiseSuggestions.classList.add('hidden');
        }

        function renderExpertiseTags() {
            const box = document.getElementById('expertise-tag-box');
            box.querySelectorAll('.expertise-pill').forEach(el => el.remove());
            
            selectedExpertise.forEach((val, idx) => {
                const pill = document.createElement('span');
                pill.className = "expertise-pill inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-bold bg-primary/10 text-primary border border-primary/20 select-none shadow-sm";
                pill.innerHTML = `${val} <button type="button" onclick="removeExpertiseTag(${idx})" class="text-primary/60 hover:text-primary hover:bg-primary/10 rounded-full p-0.5 transition-colors material-symbols-outlined text-[14px] outline-none border-0">close</button>`;
                box.insertBefore(pill, expertiseInput);
            });
            
            hiddenExpertiseCategories.value = selectedExpertise.join(', ');

            // Hide input if 1 category is selected
            if (selectedExpertise.length >= 1) {
                expertiseInput.style.display = 'none';
            } else {
                expertiseInput.style.display = 'block';
                expertiseInput.focus();
            }
        }

        function removeExpertiseTag(idx) { 
            selectedExpertise.splice(idx, 1); 
            renderExpertiseTags(); 
        }

        // Hide suggestions when clicking outside
        document.addEventListener('click', (e) => {
            if (!document.getElementById('expertise-tag-box').contains(e.target) && e.target !== expertiseSuggestions) {
                expertiseSuggestions.classList.add('hidden');
            }
        });
    </script>
}

