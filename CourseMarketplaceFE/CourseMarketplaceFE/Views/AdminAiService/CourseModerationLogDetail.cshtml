@model CourseMarketplaceFE.Models.CourseModerationLogViewModel
@using System.Text.Json
@using System
@{
    ViewData["Title"] = "AI Moderation Details";
    ViewData["PageHeader"] = "Course Evaluation Record";
    Layout = "_AdminLayout";

    (string Name, string Description) GetStageStepInfo(string stage, string step) {
        if (stage == "1") return ("Course Content Deduplication", "Checks if the course's thumbnail picture or learning materials are duplicates of existing courses.");
        if (stage == "2" && step == "1") return ("Course Info Classification", "Scans course text fields (like title, description, lesson names) for harmful, spam, or toxic content.");
        if (stage == "2" && step == "2") return ("Course Content Classification", "Scans the course's thumbnail picture and learning files for harmful, spam, or toxic content.");
        return ($"Stage {stage}" + (!string.IsNullOrEmpty(step) ? $" / Step {step}" : ""), "No detailed context available for this execution phase.");
    }

    string GetItemHref(string item, int courseId) {
        if (item.StartsWith("course.")) return $"/Course/Details/{courseId}#" + item.Replace(".", "_");
        if (item.StartsWith("lesson_")) return $"/Course/Details/{courseId}#" + item.Split('.')[0];
        if (item.StartsWith("material_")) return $"/Course/Learn/{courseId}#" + item.Split('.')[0];
        return $"/Course/Details/{courseId}#{item}";
    }

    JsonElement? inputData = null;
    JsonElement? outputData = null;
    try {
        if (!string.IsNullOrEmpty(Model.InputJson)) {
            inputData = JsonDocument.Parse(Model.InputJson).RootElement;
            Console.WriteLine(inputData);
        }
        if (!string.IsNullOrEmpty(Model.OutputJson)) {
            outputData = JsonDocument.Parse(Model.OutputJson).RootElement;
            Console.WriteLine(outputData);
        }
    } catch { }
}

<div class="flex flex-col gap-6 max-w-7xl mx-auto">
    <!-- Breadcrumb back link -->
    <div class="flex items-center gap-2">
        @{
            var q = Context.Request.QueryString.Value;
            var backUrl = Url.Action("Index", "AdminAiService") + (string.IsNullOrEmpty(q) ? "?tab=logs&subtab=course_logs" : q);
        }
        <a href="@backUrl" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-900 transition-colors">
            <span class="material-symbols-outlined text-[16px]">arrow_back</span>
            Back to Activity Logs
        </a>
    </div>

    <!-- Header Card -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6 flex flex-col md:flex-row items-start justify-between gap-6 relative overflow-hidden">
        <div class="flex flex-col gap-2 relative z-10">
            <div class="flex items-center gap-2.5 flex-wrap">
                <span class="font-mono text-xs font-bold text-slate-400">LOG-@Model.LogId</span>
                <h2 class="text-xl font-bold text-slate-900 group">
                    <a href="/Course/Details/@Model.CourseId" target="_blank" class="hover:text-indigo-600 transition-colors">@Model.Title</a> 
                    <span class="text-sm text-slate-500 font-normal">(Course ID: @Model.CourseId)</span>
                </h2>
                
                @if(Model.ResultStatus == "Flagged" || Model.ResultStatus == "Match Found") {
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-100">@Model.ResultStatus</span>
                } else if (Model.ResultStatus == "ERROR" || !string.IsNullOrEmpty(Model.ErrorMessage)) {
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-red-50 text-red-700 border border-red-100">ERROR</span>
                } else if (Model.ResultStatus == "Manual Audit") {
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-100">@Model.ResultStatus</span>
                } else {
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100">@Model.ResultStatus</span>
                }
            </div>
            
            <div class="grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-2 text-sm mt-2">
                <div class="flex flex-col">
                    <span class="text-[10px] uppercase font-bold text-slate-400">Model Used</span>
                    <span class="font-medium text-slate-700">@Model.ModelName <span class="text-slate-400 text-xs">(ID: @Model.ModelId)</span></span>
                </div>
                <div class="flex flex-col">
                    <span class="text-[10px] uppercase font-bold text-slate-400">Interaction Type</span>
                    <span class="font-medium text-slate-700">@(Model.InteractionType ?? "None")</span>
                </div>
                <div class="flex flex-col">
                    <span class="text-[10px] uppercase font-bold text-slate-400">Performance</span>
                    <span class="font-medium text-slate-700">@Model.LatencyMs ms <span class="text-slate-300 mx-1">•</span> @Model.TokenUsage tokens</span>
                </div>
                <div class="flex flex-col">
                    <span class="text-[10px] uppercase font-bold text-slate-400">Logged At</span>
                    <span class="font-medium text-slate-700">@Model.LogCreatedAt.ToString("MMM dd yyyy HH:mm:ss")</span>
                </div>
            </div>
        </div>
        <div class="absolute right-0 top-0 bottom-0 w-32 bg-gradient-to-l from-slate-50 to-transparent pointer-events-none"></div>
    </div>

    <!-- Error Banner -->
    @if(!string.IsNullOrEmpty(Model.ErrorMessage)) {
        <div class="bg-red-50 border border-red-200 rounded-xl p-4 flex items-start gap-3">
            <span class="material-symbols-outlined text-red-600 mt-0.5">error</span>
            <div class="flex flex-col">
                <h4 class="text-sm font-bold text-red-800">Execution Error</h4>
                <p class="text-sm text-red-600 mt-1">@Model.ErrorMessage</p>
            </div>
        </div>
    }

    <!-- Moderation I/O Details -->
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm flex flex-col overflow-hidden mt-6">
        <div class="px-6 py-4 border-b border-slate-100 bg-slate-50 flex items-center justify-between">
            <h3 class="text-sm font-bold text-slate-900">Moderation I/O Details</h3>
            @if(outputData.HasValue && outputData.Value.TryGetProperty("details", out var details)) {
                <button onclick="openRawDetailsModal(this.getAttribute('data-json'))" data-json="@details.GetRawText()" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold bg-white border border-slate-200 text-slate-600 rounded-lg hover:bg-slate-50 hover:text-slate-900 transition-colors shadow-sm">
                    <span class="material-symbols-outlined text-[16px]">data_object</span>
                    View Raw JSON
                </button>
            }
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-slate-100">
            <!-- Column 1: Input Thresholds -->
            <div class="p-6 bg-white">
                <h4 class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-4">Input Thresholds</h4>
                @if(inputData.HasValue) {
                    <dl class="flex flex-col gap-3 text-sm">
                        @if(inputData.Value.TryGetProperty("spam_score_threshold", out var spam)) {
                            <div class="flex justify-between items-center py-1">
                                <dt class="text-slate-500">Spam Score</dt>
                                <dd class="font-semibold text-slate-900 font-mono">@spam</dd>
                            </div>
                        }
                        @if(inputData.Value.TryGetProperty("toxic_score_threshold", out var toxic)) {
                            <div class="flex justify-between items-center py-1">
                                <dt class="text-slate-500">Toxic Score</dt>
                                <dd class="font-semibold text-slate-900 font-mono">@toxic</dd>
                            </div>
                        }
                        @if(inputData.Value.TryGetProperty("similarity_score_threshold", out var sim)) {
                            <div class="flex justify-between items-center py-1">
                                <dt class="text-slate-500">Similarity Score</dt>
                                <dd class="font-semibold text-slate-900 font-mono">@sim</dd>
                            </div>
                        }
                    </dl>
                } else {
                    <div class="text-sm text-slate-400 italic">No input data available.</div>
                }
            </div>

            <!-- Column 2: Execution Result -->
            <div class="p-6 bg-white">
                <h4 class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-4">Execution Result</h4>
                @if(outputData.HasValue) {
                    <dl class="flex flex-col gap-3 text-sm">
                        <div class="flex justify-between items-center py-1">
                            <dt class="text-slate-500">Result Status</dt>
                            <dd>
                                @{
                                    string res = Model.ResultStatus ?? "";
                                    string resClass = "text-emerald-600";
                                    
                                    if (res.Equals("Flagged", StringComparison.OrdinalIgnoreCase) || res.Equals("Match Found", StringComparison.OrdinalIgnoreCase)) resClass = "text-rose-600";
                                    else if (res.Equals("ERROR", StringComparison.OrdinalIgnoreCase) || !string.IsNullOrEmpty(Model.ErrorMessage)) resClass = "text-red-600";
                                    else if (res.Equals("Manual Audit", StringComparison.OrdinalIgnoreCase)) resClass = "text-amber-600";
                                }
                                <span class="font-bold @resClass uppercase text-xs">@res</span>
                            </dd>
                        </div>
                        <div class="flex justify-between items-center py-1">
                            <dt class="text-slate-500">Confidence</dt>
                            <dd class="font-semibold text-slate-900 font-mono">@(outputData.Value.TryGetProperty("confidence_score", out var conf) ? conf.GetRawText() : "N/A")</dd>
                        </div>
                        <div class="flex justify-between items-center py-1">
                            <dt class="text-slate-500">Execution Phase</dt>
                            <dd class="font-medium text-slate-700">
                                @{
                                    string stageStr = outputData.Value.TryGetProperty("stage", out var stageProp) ? stageProp.ToString() : "";
                                    string stepStr = outputData.Value.TryGetProperty("step", out var stepProp) ? stepProp.ToString() : "";
                                    var phaseInfo = GetStageStepInfo(stageStr, stepStr);
                                }
                                <div class="group relative flex items-center cursor-help">
                                    <span class="text-[11px] uppercase tracking-wide">@phaseInfo.Name</span>
                                    <span class="material-symbols-outlined text-[14px] text-slate-400 ml-1.5 group-hover:text-slate-700 transition-colors">info</span>
                                    
                                    <!-- Tooltip -->
                                    <div class="absolute bottom-full right-0 mb-2 w-64 p-3 bg-slate-800 text-white text-xs rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 pointer-events-none text-left leading-relaxed normal-case tracking-normal">
                                        @phaseInfo.Description
                                        <div class="absolute top-full right-4 -mt-1 border-4 border-transparent border-t-slate-800"></div>
                                    </div>
                                </div>
                            </dd>
                        </div>
                        <div class="flex justify-between items-center py-1">
                            <dt class="text-slate-500">Timestamp</dt>
                            <dd class="font-medium text-slate-700 font-mono text-[11px]">
                                @{
                                    string tsStr = "-";
                                    if (outputData.Value.TryGetProperty("timestamp", out var ts) && DateTime.TryParse(ts.GetString(), out var dt)) {
                                        tsStr = dt.ToString("MMM dd yyyy HH:mm:ss");
                                    }
                                }
                                @tsStr
                            </dd>
                        </div>
                    </dl>
                } else {
                    <div class="text-sm text-slate-400 italic">No output data available.</div>
                }
            </div>

            <!-- Column 3: Moderation Context -->
            <div class="p-6 bg-slate-50/50">
                <h4 class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-4">Moderation Context</h4>
                @if(outputData.HasValue) {
                    <dl class="flex flex-col gap-4 text-sm">
                        <div class="flex flex-col gap-1.5">
                            <dt class="text-xs font-medium text-slate-500">Flagged Fields</dt>
                            <dd class="text-slate-900 font-medium">
                                @{
                                    var ffList = new List<string>();
                                    if (outputData.Value.TryGetProperty("flagged_fields", out var ff)) {
                                        if (ff.ValueKind == JsonValueKind.Array) {
                                            foreach (var it in ff.EnumerateArray()) {
                                                if (it.ValueKind == JsonValueKind.String) ffList.Add(it.GetString());
                                            }
                                        } else if (ff.ValueKind == JsonValueKind.String) {
                                            try {
                                                var parsed = JsonSerializer.Deserialize<List<string>>(ff.GetString());
                                                if (parsed != null) ffList = parsed;
                                            } catch { }
                                        }
                                    }
                                }
                                @if(!ffList.Any()) {
                                    <span class="text-slate-400 italic font-normal text-xs">None</span>
                                } else {
                                    <div class="flex flex-col">
                                        @foreach(var item in ffList) {
                                            <a href="@GetItemHref(item, Model.CourseId)" target="_blank" class="block w-full py-0.5 text-indigo-600 hover:text-indigo-800 hover:underline transition-colors font-mono text-xs">@item</a>
                                        }
                                    </div>
                                }
                            </dd>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <dt class="text-xs font-medium text-slate-500">Manual Audit Fields</dt>
                            <dd class="text-slate-900 font-medium">
                                @{
                                    var mafList = new List<string>();
                                    if (outputData.Value.TryGetProperty("manual_audit_fields", out var maf)) {
                                        if (maf.ValueKind == JsonValueKind.Array) {
                                            foreach (var it in maf.EnumerateArray()) {
                                                if (it.ValueKind == JsonValueKind.String) mafList.Add(it.GetString());
                                            }
                                        } else if (maf.ValueKind == JsonValueKind.String) {
                                            try {
                                                var parsed = JsonSerializer.Deserialize<List<string>>(maf.GetString());
                                                if (parsed != null) mafList = parsed;
                                            } catch { }
                                        }
                                    }
                                }
                                @if(!mafList.Any()) {
                                    <span class="text-slate-400 italic font-normal text-xs">None</span>
                                } else {
                                    <div class="flex flex-col">
                                        @foreach(var item in mafList) {
                                            <a href="@GetItemHref(item, Model.CourseId)" target="_blank" class="block w-full py-0.5 text-amber-600 hover:text-amber-800 hover:underline transition-colors font-mono text-xs">@item</a>
                                        }
                                    </div>
                                }
                            </dd>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <dt class="text-xs font-medium text-slate-500">Reason</dt>
                            <dd class="text-slate-700 leading-relaxed">
                                @{
                                    string reaVal = outputData.Value.TryGetProperty("reason", out var rea) && !string.IsNullOrEmpty(rea.GetString()) ? rea.GetString()! : "";
                                }
                                @if(string.IsNullOrEmpty(reaVal)) {
                                    <span class="text-slate-400 italic text-xs">No reason provided.</span>
                                } else {
                                    @reaVal
                                }
                            </dd>
                        </div>
                    </dl>
                } else {
                    <div class="text-sm text-slate-400 italic">No details available.</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: RAW JSON DETAILS -->
<!-- ========================================================================= -->
<div id="rawDetailsModal" class="fixed inset-0 z-50 hidden bg-slate-950/40 backdrop-blur-sm flex items-center justify-center p-4 transition-all duration-300 ease-out opacity-0">
    <div class="bg-white border border-slate-200 rounded-2xl shadow-2xl w-full max-w-2xl overflow-hidden transform scale-95 transition-all duration-300 ease-out flex flex-col max-h-[85vh]">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between shrink-0 bg-slate-50/50">
            <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="material-symbols-outlined text-indigo-600 text-[20px]">data_object</span>
                Raw Output Details
            </h3>
            <button onclick="closeRawDetailsModal()" class="text-slate-400 hover:text-slate-600">
                <span class="material-symbols-outlined text-[20px]">close</span>
            </button>
        </div>
        <div class="p-6 overflow-y-auto custom-scrollbar flex-1 bg-slate-900">
            <pre><code id="rawDetailsContent" class="text-sm font-mono text-emerald-400 whitespace-pre-wrap break-all"></code></pre>
        </div>
        <div class="p-4 border-t border-slate-100 flex justify-end shrink-0 bg-white">
            <button onclick="closeRawDetailsModal()" class="px-4 py-2 text-sm font-semibold border border-slate-200 text-slate-600 hover:bg-slate-50 rounded-lg transition-colors">Close</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openRawDetailsModal(jsonString) {
            try {
                const jsonObj = JSON.parse(jsonString);
                const formattedJson = JSON.stringify(jsonObj, null, 4);
                document.getElementById('rawDetailsContent').textContent = formattedJson;
            } catch (e) {
                document.getElementById('rawDetailsContent').textContent = jsonString;
            }

            const modal = document.getElementById('rawDetailsModal');
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modal.firstElementChild.classList.remove('scale-95');
            }, 10);
        }

        function closeRawDetailsModal() {
            const modal = document.getElementById('rawDetailsModal');
            modal.classList.add('opacity-0');
            modal.firstElementChild.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }
    </script>
}
