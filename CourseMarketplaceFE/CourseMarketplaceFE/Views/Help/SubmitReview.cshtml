@{
    ViewData["Title"] = "Submitting course reviews - Help Center";
}

<section class="py-16 md:py-24 bg-slate-50 min-h-screen">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <a href="/Help" class="text-emerald-600 hover:text-emerald-700 font-medium inline-flex items-center transition-colors">
                <span class="material-symbols-outlined text-sm mr-1">arrow_back</span>
                Back to Help Center
            </a>
        </div>
        
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8 md:p-12">
            <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-8">Submitting course reviews</h1>
            
            <div class="prose prose-slate max-w-none text-slate-700 space-y-8">
                <div>
                    <h2 class="text-2xl font-bold text-slate-900 mb-4">How to Submit a Review</h2>
                    <p>Leaving a review helps other students decide if a course is right for them and provides valuable feedback to instructors.</p>
                    <ol class="list-decimal list-inside space-y-3">
                        <li><strong>Requirements:</strong> You must be enrolled in the course and have fully completed it (100% progress) to leave a general Course Review. Alternatively, you can leave Lesson Reviews directly in the Course Player if you have completed at least 1 lesson.</li>
                        <li>Navigate to the Course Details page (for a course review) or the Reviews tab inside the Course Player (for a lesson review).</li>
                        <li>Select a star rating from 1 to 5.</li>
                        <li>Write a helpful comment describing your experience.</li>
                        <li>Click <strong>Submit Review</strong>.</li>
                    </ol>
                </div>

                <div>
                    <h2 class="text-2xl font-bold text-slate-900 mb-4">Editing or Deleting a Review</h2>
                    <p>If you change your mind, you can update or remove your review:</p>
                    <ol class="list-decimal list-inside space-y-3">
                        <li>Navigate to the course details page where your review is posted.</li>
                        <li>To edit, click the <strong>Edit</strong> link on your review card, modify the rating or comment, and click <strong>Save</strong>.</li>
                        <li>To delete, click the <strong>Delete</strong> link and confirm the action.</li>
                    </ol>
                    <div class="bg-amber-50 border-l-4 border-amber-500 p-4 mt-4 rounded-r-lg">
                        <p class="text-amber-800 text-sm m-0"><strong>Note:</strong> If your review has been reported and is currently under moderation review by our team, you will not be able to edit or delete it until the moderation process concludes.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
