@{
    ViewData["Title"] = "Viewing transaction history - Help Center";
}

<section class="py-16 md:py-24 bg-slate-50 min-h-screen">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <a href="/Help" class="text-emerald-600 hover:text-emerald-700 font-medium inline-flex items-center transition-colors">
                <span class="material-symbols-outlined text-sm mr-1">arrow_back</span>
                Back to Help Center
            </a>
        </div>
        
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8 md:p-12">
            <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-8">Viewing transaction history</h1>
            
            <div class="prose prose-slate max-w-none text-slate-700 space-y-8">
                <div>
                    <h2 class="text-2xl font-bold text-slate-900 mb-4">Accessing Your Purchase History</h2>
                    <p>Keep track of all your course enrollments and payments in one place:</p>
                    <ol class="list-decimal list-inside space-y-3">
                        <li>Navigate to your dashboard and select <strong>Purchase History</strong> from the menu.</li>
                        <li>Here, you will find a paginated list of all your purchase transactions alongside a total purchases metric.</li>
                        <li>To find a specific purchase, enter a relevant keyword into the search input field and click <strong>Apply</strong>.</li>
                        <li>Click <strong>Reset</strong> to clear the search filter and view your full history again.</li>
                    </ol>
                </div>

                <div>
                    <h2 class="text-2xl font-bold text-slate-900 mb-4">Reviewing Transaction Details</h2>
                    <p>For a complete receipt of any purchase:</p>
                    <ol class="list-decimal list-inside space-y-3">
                        <li>From the Purchase History page, click the <strong>View Details</strong> button next to a transaction record.</li>
                        <li>The system will display a full receipt including the Transaction ID, Payment Date/Time, Buyer details, Course details, and a detailed Price breakdown (Subtotal, Discount, Total).</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
</section>
