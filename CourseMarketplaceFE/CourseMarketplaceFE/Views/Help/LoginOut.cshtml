@{
    ViewData["Title"] = "Logging in and out - Help Center";
}

<section class="py-16 md:py-24 bg-slate-50 min-h-screen">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <a href="/Help" class="text-emerald-600 hover:text-emerald-700 font-medium inline-flex items-center transition-colors">
                <span class="material-symbols-outlined text-sm mr-1">arrow_back</span>
                Back to Help Center
            </a>
        </div>
        
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8 md:p-12">
            <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-8">Logging in and out</h1>
            
            <div class="prose prose-slate max-w-none text-slate-700 space-y-8">
                <div>
                    <h2 class="text-2xl font-bold text-slate-900 mb-4">How to Log In</h2>
                    <p>Access your LinkedLearn account by following these steps:</p>
                    <ol class="list-decimal list-inside space-y-3">
                        <li>Access the login page via the navigation menu.</li>
                        <li>Enter your valid Username or Email, along with your Password.</li>
                        <li>Click the <strong>Sign In</strong> button.</li>
                    </ol>
                    <p class="mt-4"><strong>Alternative Login:</strong> You can also click the <strong>Sign in with Google</strong> button to quickly authenticate using your existing Google account. If it's your first time logging in with Google, an account will be automatically generated for you.</p>
                </div>

                <div>
                    <h2 class="text-2xl font-bold text-slate-900 mb-4">How to Log Out</h2>
                    <p>To securely end your session:</p>
                    <ol class="list-decimal list-inside space-y-3">
                        <li>Click on your profile avatar in the top right corner of the screen.</li>
                        <li>Select <strong>Logout</strong> from the dropdown menu.</li>
                        <li>You will be securely logged out and returned to the homepage.</li>
                    </ol>
                </div>

                <div class="bg-amber-50 border-l-4 border-amber-500 p-4 mt-8 rounded-r-lg">
                    <p class="text-amber-800 text-sm m-0"><strong>Troubleshooting:</strong> If you enter incorrect credentials, you will receive an error message. If you forgot your password, use the "Forgot Password" link on the login page to verify your email via OTP and reset your password.</p>
                </div>
            </div>
        </div>
    </div>
</section>
