@{
    ViewData["Title"] = "How to register a new account - Help Center";
}

<section class="py-16 md:py-24 bg-slate-50 min-h-screen">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <a href="/Help" class="text-emerald-600 hover:text-emerald-700 font-medium inline-flex items-center transition-colors">
                <span class="material-symbols-outlined text-sm mr-1">arrow_back</span>
                Back to Help Center
            </a>
        </div>
        
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8 md:p-12">
            <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-8">How to register a new account</h1>
            
            <div class="prose prose-slate max-w-none text-slate-700 space-y-6">
                <p>Welcome to LinkedLearn! Creating an account is quick and easy. Follow the steps below to get started:</p>
                
                <ol class="list-decimal list-inside space-y-4">
                    <li><strong>Access the registration page:</strong> Click on the "Sign Up" or "Register" button located at the top right of the homepage.</li>
                    <li><strong>Enter your details:</strong> Fill out the registration form with your valid details:
                        <ul class="list-disc list-inside ml-6 mt-2 text-slate-600">
                            <li><strong>Email:</strong> Must be a valid Gmail address.</li>
                            <li><strong>Username:</strong> Choose a unique username for your profile.</li>
                            <li><strong>Full Name:</strong> Enter your full name.</li>
                            <li><strong>Password & Confirm Password:</strong> Create a strong password and confirm it. Ensure both fields match.</li>
                        </ul>
                    </li>
                    <li><strong>Submit:</strong> Click the "Register" button.</li>
                    <li><strong>Verification:</strong> Upon successful registration, you will be redirected to the Verification Recommendation page displaying your registered email. From there, you can proceed to verify your email address to unlock all platform features.</li>
                </ol>

                <div class="bg-blue-50 border-l-4 border-blue-500 p-4 mt-8 rounded-r-lg">
                    <p class="text-blue-800 text-sm m-0"><strong>Note:</strong> You can also register instantly by clicking the "Sign in with Google" button on the login page.</p>
                </div>
            </div>
        </div>
    </div>
</section>
