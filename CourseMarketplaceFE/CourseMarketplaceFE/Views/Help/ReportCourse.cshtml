@{
    ViewData["Title"] = "Reporting a course - Help Center";
}

<section class="py-16 md:py-24 bg-slate-50 min-h-screen">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <a href="/Help" class="text-emerald-600 hover:text-emerald-700 font-medium inline-flex items-center transition-colors">
                <span class="material-symbols-outlined text-sm mr-1">arrow_back</span>
                Back to Help Center
            </a>
        </div>
        
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8 md:p-12">
            <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-8">Reporting a course</h1>
            
            <div class="prose prose-slate max-w-none text-slate-700 space-y-8">
                <p>If you believe a course on LinkedLearn violates our policies (e.g., copyright infringement, misleading content, inappropriate material), you can flag it directly to our moderation team.</p>

                <div>
                    <h2 class="text-2xl font-bold text-slate-900 mb-4">How to Report a Course</h2>
                    <ol class="list-decimal list-inside space-y-3">
                        <li>Ensure you are logged in and enrolled in the course you wish to report. Note: Instructors cannot report their own courses.</li>
                        <li>Navigate to the Course Details page.</li>
                        <li>Click the <strong>Report this course</strong> button.</li>
                        <li>Select a reason from the dropdown menu.</li>
                        <li>Provide a detailed description of the issue (minimum 20 characters required).</li>
                        <li>If there are multiple issues, you can click <strong>Add another reason</strong> to submit multiple violation claims in a single report.</li>
                        <li>Click <strong>Submit Report</strong>.</li>
                    </ol>
                </div>

                <div>
                    <h2 class="text-2xl font-bold text-slate-900 mb-4">Review Process</h2>
                    <p>Once submitted, your report enters a "Pending" status and is placed in the moderation queue for our Staff and Admin team.</p>
                    <ul class="list-disc list-inside space-y-3">
                        <li>A moderator will review the course content alongside your provided reasons and description.</li>
                        <li>If the report is validated, the moderator may remove the violating content or flag the course.</li>
                        <li>Duplicate reports for the exact same reason from the same user are prevented while a report is pending.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
