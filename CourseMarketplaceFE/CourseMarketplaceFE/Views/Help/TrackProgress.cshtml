@{
    ViewData["Title"] = "Tracking your learning progress - Help Center";
}

<section class="py-16 md:py-24 bg-slate-50 min-h-screen">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <a href="/Help" class="text-emerald-600 hover:text-emerald-700 font-medium inline-flex items-center transition-colors">
                <span class="material-symbols-outlined text-sm mr-1">arrow_back</span>
                Back to Help Center
            </a>
        </div>
        
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8 md:p-12">
            <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-8">Tracking your learning progress</h1>
            
            <div class="prose prose-slate max-w-none text-slate-700 space-y-8">
                <p>LinkedLearn automatically tracks your progress through each course, so you always know where you left off.</p>

                <div>
                    <h2 class="text-2xl font-bold text-slate-900 mb-4">How Progress is Tracked</h2>
                    <ul class="list-disc list-inside space-y-3">
                        <li><strong>Video Lectures:</strong> When you play a video material until it reaches the end, the system automatically saves it as completed.</li>
                        <li><strong>Text Documents:</strong> Reading a text-based material and scrolling through it will mark it as complete.</li>
                        <li><strong>Downloadable Resources:</strong> Clicking the "Download Resource" button for a material will mark that specific item as complete.</li>
                        <li><strong>Quizzes:</strong> Submitting a quiz attempt successfully counts towards your curriculum progress.</li>
                    </ul>
                </div>

                <div>
                    <h2 class="text-2xl font-bold text-slate-900 mb-4">Where to View Your Progress</h2>
                    <ol class="list-decimal list-inside space-y-3">
                        <li>Navigate to the <strong>My Enrolled Courses</strong> page from your dashboard. Here, you'll see a high-level progress percentage for each course you're taking.</li>
                        <li>Click <strong>Go to learning</strong> on any course to open the Course Player.</li>
                        <li>Inside the Course Player, the curriculum sidebar displays detailed progress checkmarks next to each completed lesson and an overall progress bar at the top.</li>
                    </ol>
                </div>
                
                <div class="bg-emerald-50 border-l-4 border-emerald-500 p-4 mt-8 rounded-r-lg">
                    <p class="text-emerald-800 text-sm m-0"><strong>Course Completion:</strong> Once you complete the final remaining material in a course, your enrollment status will automatically update to "Completed," and the completion date will be recorded.</p>
                </div>
            </div>
        </div>
    </div>
</section>
