@{
    ViewData["Title"] = "Reporting inappropriate reviews - Help Center";
}

<section class="py-16 md:py-24 bg-slate-50 min-h-screen">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <a href="/Help" class="text-emerald-600 hover:text-emerald-700 font-medium inline-flex items-center transition-colors">
                <span class="material-symbols-outlined text-sm mr-1">arrow_back</span>
                Back to Help Center
            </a>
        </div>
        
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8 md:p-12">
            <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-8">Reporting inappropriate reviews</h1>
            
            <div class="prose prose-slate max-w-none text-slate-700 space-y-8">
                <p>LinkedLearn is committed to maintaining a safe and respectful community. If you encounter a course review or lesson review that violates our community guidelines (e.g., spam, harassment, inappropriate content), you can report it to our moderation team.</p>

                <div>
                    <h2 class="text-2xl font-bold text-slate-900 mb-4">How to Report a Review</h2>
                    <ol class="list-decimal list-inside space-y-3">
                        <li>Ensure you are logged into your LinkedLearn account.</li>
                        <li>Navigate to the Course Details page (for course reviews) or the Course Player (for lesson reviews).</li>
                        <li>Locate the specific review you want to report.</li>
                        <li>Click the <strong>Report</strong> button located on the review card.</li>
                        <li>In the report modal, select the most accurate violation reason from the dropdown menu.</li>
                        <li>(Optional but recommended) Provide a description with more context about why you are reporting this review.</li>
                        <li>Click <strong>Submit Report</strong>.</li>
                    </ol>
                </div>

                <div>
                    <h2 class="text-2xl font-bold text-slate-900 mb-4">What Happens Next?</h2>
                    <ul class="list-disc list-inside space-y-3">
                        <li>Your report will be queued for manual review by our Staff or Admin team.</li>
                        <li>Moderators have the ability to view the report details, accept it (which may result in the review being removed and the author penalized), or dismiss it if no violation is found.</li>
                        <li>You cannot submit duplicate reports for the exact same reason while your initial report is still pending.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
