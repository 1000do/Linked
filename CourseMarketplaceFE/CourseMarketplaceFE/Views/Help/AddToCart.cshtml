@{
    ViewData["Title"] = "Adding courses to your cart - Help Center";
}

<section class="py-16 md:py-24 bg-slate-50 min-h-screen">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <a href="/Help" class="text-emerald-600 hover:text-emerald-700 font-medium inline-flex items-center transition-colors">
                <span class="material-symbols-outlined text-sm mr-1">arrow_back</span>
                Back to Help Center
            </a>
        </div>
        
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8 md:p-12">
            <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-8">Adding courses to your cart</h1>
            
            <div class="prose prose-slate max-w-none text-slate-700 space-y-8">
                <div>
                    <h2 class="text-2xl font-bold text-slate-900 mb-4">How to Add a Course to Your Cart</h2>
                    <p>Building your learning list is simple. Just follow these steps:</p>
                    <ol class="list-decimal list-inside space-y-3">
                        <li>Ensure your account email is verified.</li>
                        <li>Browse the catalog and access a course detail page.</li>
                        <li>Click the <strong>Add to Cart</strong> button.</li>
                        <li>A success notification will appear, and the cart icon in your navigation header will instantly update to reflect the new item.</li>
                    </ol>
                </div>

                <div>
                    <h2 class="text-2xl font-bold text-slate-900 mb-4">Managing Your Cart</h2>
                    <p>If you change your mind, you can easily remove items:</p>
                    <ol class="list-decimal list-inside space-y-3">
                        <li>Click the <strong>Cart</strong> icon on the top navigation header.</li>
                        <li>Find the course you wish to remove and click the <strong>Delete (Trash)</strong> icon next to it.</li>
                        <li>Confirm the removal action. Your cart subtotal and any applied discounts will recalculate automatically.</li>
                    </ol>
                    <div class="bg-blue-50 border-l-4 border-blue-500 p-4 mt-4 rounded-r-lg">
                        <p class="text-blue-800 text-sm m-0"><strong>Note:</strong> You cannot add courses that you already own, nor can instructors add their own published courses to the cart.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
