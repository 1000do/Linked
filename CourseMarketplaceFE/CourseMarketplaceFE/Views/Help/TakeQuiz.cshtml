@{
    ViewData["Title"] = "Taking quizzes - Help Center";
}

<section class="py-16 md:py-24 bg-slate-50 min-h-screen">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <a href="/Help" class="text-emerald-600 hover:text-emerald-700 font-medium inline-flex items-center transition-colors">
                <span class="material-symbols-outlined text-sm mr-1">arrow_back</span>
                Back to Help Center
            </a>
        </div>
        
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8 md:p-12">
            <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-8">Taking quizzes</h1>
            
            <div class="prose prose-slate max-w-none text-slate-700 space-y-8">
                <div>
                    <h2 class="text-2xl font-bold text-slate-900 mb-4">How to Take a Quiz</h2>
                    <p>Quizzes are integrated directly into the course curriculum to test your knowledge.</p>
                    <ol class="list-decimal list-inside space-y-3">
                        <li>Inside the Course Player, navigate to a Quiz material from the curriculum sidebar.</li>
                        <li>Click the <strong>Start Quiz</strong> button to create a new attempt.</li>
                        <li>The quiz questions interface will appear. Carefully read and answer all the questions.</li>
                        <li>Once finished, click the <strong>Submit</strong> button.</li>
                        <li>The system will instantly calculate your score, save the attempt, and display a detailed result summary.</li>
                    </ol>
                </div>

                <div>
                    <h2 class="text-2xl font-bold text-slate-900 mb-4">Reviewing Past Attempts</h2>
                    <p>You can always look back at your previous quiz attempts to see where you went wrong:</p>
                    <ol class="list-decimal list-inside space-y-3">
                        <li>Access the Quiz History page from the specific quiz view.</li>
                        <li>You will see a paginated list of all your past attempts, including their dates and scores.</li>
                        <li>Click on a specific attempt to view detailed results, which show the questions alongside your submitted answers and the correct answers.</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
</section>
