@{
    ViewData["Title"] = "Enrolling in a course - Help Center";
}

<section class="py-16 md:py-24 bg-slate-50 min-h-screen">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <a href="/Help" class="text-emerald-600 hover:text-emerald-700 font-medium inline-flex items-center transition-colors">
                <span class="material-symbols-outlined text-sm mr-1">arrow_back</span>
                Back to Help Center
            </a>
        </div>
        
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8 md:p-12">
            <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-8">Enrolling in a course</h1>
            
            <div class="prose prose-slate max-w-none text-slate-700 space-y-8">
                <div>
                    <h2 class="text-2xl font-bold text-slate-900 mb-4">Enrolling in Free Courses</h2>
                    <p>To start learning a free course instantly:</p>
                    <ol class="list-decimal list-inside space-y-3">
                        <li>Ensure you are logged into your account.</li>
                        <li>Navigate to the course details page of a free course you want to take.</li>
                        <li>Click the <strong>Enroll Now</strong> button.</li>
                        <li>You will be instantly enrolled! The button will change to <strong>Go to learning</strong>, allowing you to access all course lectures.</li>
                    </ol>
                </div>

                <div>
                    <h2 class="text-2xl font-bold text-slate-900 mb-4">Enrolling in Paid Courses</h2>
                    <p>To enroll in a paid course, you will need to complete the checkout process:</p>
                    <ol class="list-decimal list-inside space-y-3">
                        <li>Ensure you are logged into your account.</li>
                        <li>Navigate to the course details page and click the <strong>Add to cart</strong> button.</li>
                        <li>Proceed to your Shopping Cart and review your selected courses.</li>
                        <li>Click <strong>Checkout</strong> to be redirected to our secure Stripe payment gateway.</li>
                        <li>Enter your payment details and confirm the transaction.</li>
                        <li>Once the payment is successful, you will be enrolled and can begin learning immediately.</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
</section>
