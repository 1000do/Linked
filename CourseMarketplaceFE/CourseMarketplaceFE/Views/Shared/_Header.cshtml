@using Microsoft.AspNetCore.Http
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    bool isCourseDetails = string.Equals(currentController, "Course", StringComparison.OrdinalIgnoreCase) 
                           && string.Equals(currentAction, "Details", StringComparison.OrdinalIgnoreCase);
                           
    var userRoleForHeader = Context.Request.Cookies["UserRole"] ?? "User";
    bool isStaffOrAdmin = userRoleForHeader.Equals("admin", StringComparison.OrdinalIgnoreCase) 
                          || userRoleForHeader.Equals("staff", StringComparison.OrdinalIgnoreCase);
    bool isInstructor = userRoleForHeader.Equals("instructor", StringComparison.OrdinalIgnoreCase);
                          
    bool hideHeaderElements = isStaffOrAdmin;
}
<style>
    #header-search-results-list::-webkit-scrollbar {
        width: 6px;
    }
    #header-search-results-list::-webkit-scrollbar-track {
        background: transparent;
    }
    #header-search-results-list::-webkit-scrollbar-thumb {
        background: #cbd5e1; /* slate-300 */
        border-radius: 9999px;
    }
    #header-search-results-list::-webkit-scrollbar-thumb:hover {
        background: #94a3b8; /* slate-400 */
    }
</style>
<nav class="fixed top-0 w-full z-50 bg-[#f0fcfb]/40 border-b border-primary/10 glass-nav">
    <div class="flex items-center px-8 py-2 w-full">
        <div class="flex items-center gap-4 lg:gap-6 shrink-0">
            <button onclick="toggleMainSidebar()" class="lg:hidden p-2 -ml-2 text-slate-500 hover:text-primary transition-colors">
                <span class="material-symbols-outlined">menu</span>
            </button>
            
            <a href="/" class="text-xl lg:text-2xl font-headline font-extrabold tracking-tight text-primary shrink-0">LinkedLearn</a>
            
        </div>

        <!-- MOBILE HEADER ICONS (Login/Profile) -->
        <div class="flex items-center ml-auto gap-3 lg:hidden">
            @if (!string.IsNullOrEmpty(Context.Request.Cookies["AccessToken"]) && !string.IsNullOrEmpty(Context.Request.Cookies["UserName"]))
            {
                var mUserName = Context.Request.Cookies["UserName"];
                var mAvatarUrl = Context.Request.Cookies["AvatarUrl"];
                var mUserRole = Context.Request.Cookies["UserRole"] ?? "User";
                var mProfileHref = (mUserRole.Equals("admin", StringComparison.OrdinalIgnoreCase) || mUserRole.Equals("staff", StringComparison.OrdinalIgnoreCase)) ? "/AdminProfile" : "/Account/Profile";
                <a href="@mProfileHref" class="hover:scale-105 transition-all">
                    @await Html.PartialAsync("_UserAvatar", new { Url = mAvatarUrl, Role = mUserRole, Name = mUserName, Size = "sm" })
                </a>
                <form id="global-logout-form-mobile" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="text-slate-500 hover:text-red-500 transition-colors bg-transparent border-none p-1 cursor-pointer flex items-center justify-center">
                        <span class="material-symbols-outlined text-[20px]">logout</span>
                    </button>
                </form>
            }
            else
            {
                <a href="/Account/Login" class="text-xs font-semibold text-primary px-3 py-1.5 bg-primary/10 rounded-lg">Login</a>
                <a href="/Account/Register" class="text-xs font-semibold text-white px-3 py-1.5 bg-primary rounded-lg">Register</a>
            }
        </div>

        <!-- OVERLAY -->
        <div id="mainSidebarOverlay" class="fixed top-0 left-0 w-screen h-[100dvh] bg-slate-900/40 backdrop-blur-sm z-[90] hidden lg:hidden transition-opacity opacity-0 duration-300" onclick="toggleMainSidebar()"></div>

        <!-- RIGHT SIDEBAR / DESKTOP NAV -->
        <aside id="mainMobileSidebar" class="fixed top-0 left-0 h-[100dvh] w-[280px] bg-white z-[100] transform -translate-x-full transition-transform duration-300 lg:static lg:transform-none lg:flex-1 lg:h-auto lg:bg-transparent lg:z-auto flex flex-col lg:flex-row lg:items-center gap-6 lg:gap-2 lg:ml-6 shrink-0 p-6 lg:p-0 overflow-y-auto lg:overflow-visible shadow-2xl lg:shadow-none">
            
            <div class="flex items-center justify-between lg:hidden mb-2 border-b border-slate-100 pb-4">
                <span class="text-xl font-headline font-extrabold tracking-tight text-primary">Menu</span>
                <button onclick="toggleMainSidebar()" class="text-slate-400 hover:text-slate-600 p-1 bg-slate-50 rounded-full">
                    <span class="material-symbols-outlined text-[20px]">close</span>
                </button>
            </div>

            @if (!hideHeaderElements)
            {
                <div class="relative w-full lg:w-auto shrink-0 mb-4 lg:mb-0" id="categories-dropdown">
                    <button onclick="toggleCategories()" 
                            class="px-4 py-2.5 lg:py-2 w-full lg:w-auto text-left lg:text-center text-sm font-bold text-slate-700 hover:text-primary transition-colors flex items-center justify-between lg:justify-center gap-1 bg-slate-50 lg:bg-transparent rounded-xl lg:rounded-none">
                        Explore Topics
                        <span class="material-symbols-outlined text-[18px]">keyboard_arrow_down</span>
                    </button>
                    <div id="categories-box" 
                         class="hidden lg:absolute left-0 mt-2 lg:mt-3 w-full lg:w-64 bg-white lg:rounded-xl lg:shadow-xl border border-slate-100 overflow-hidden z-[60] py-2">
                        <div id="categories-items-container" class="max-h-64 lg:max-h-96 overflow-y-auto">
                            <div class="px-4 py-3 text-xs text-slate-400">Loading categories...</div>
                        </div>
                    </div>
                </div>

                @* 🔍 GLOBAL SEARCH BAR (Moved to Sidebar for mobile, middle for desktop) *@
                <div class="flex items-center w-full lg:flex-1 lg:max-w-2xl lg:px-4 group relative mb-4 lg:mb-0" id="header-search-container">
                    <div class="relative w-full">
                        <span class="material-symbols-outlined absolute left-3 lg:left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-primary transition-colors text-[18px] lg:text-[20px]">search</span>
                        <form action="/Course" method="get" id="header-search-form">
                            <input type="text" name="query" autocomplete="off" id="header-search-input"
                                   class="w-full h-10 pl-10 lg:pl-12 pr-4 bg-slate-100 border border-slate-200 rounded-full text-sm placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:bg-white transition-all"
                                   placeholder="Search..." />
                        </form>
                        
                        <div id="header-search-results" 
                             class="hidden absolute left-0 right-0 mt-2 lg:mt-3 bg-white/95 backdrop-blur-md border border-slate-100 rounded-xl lg:rounded-2xl shadow-2xl overflow-hidden z-[100] transition-all duration-300">
                            <div class="p-3 lg:p-4 border-b border-slate-100 bg-slate-50/50">
                                <span class="text-[10px] lg:text-xs font-bold text-slate-500">SEARCH RESULTS: <span id="search-keyword-highlight" class="text-[#a435f0] font-extrabold uppercase"></span></span>
                            </div>
                            <div id="header-search-results-list" class="max-h-[250px] lg:max-h-[350px] overflow-y-auto divide-y divide-slate-100">
                                <!-- Items populated dynamically via JS -->
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="flex flex-col lg:flex-row lg:items-center gap-4 lg:gap-2 w-full lg:w-auto mt-4 lg:mt-0 lg:ml-auto">
            @{
                var accessTokenExists = !string.IsNullOrEmpty(Context.Request.Cookies["AccessToken"]);
                var userName = Context.Request.Cookies["UserName"];
                var avatarUrl = Context.Request.Cookies["AvatarUrl"];
                var isLoggedIn = accessTokenExists && !string.IsNullOrEmpty(userName);
            }

            @if (!isLoggedIn)
            {
                <a href="/Account/Login" class="hidden lg:flex px-6 py-2.5 text-sm font-semibold text-primary rounded-xl lg:rounded-full bg-primary/5 hover:bg-primary/10 transition-colors text-center w-full lg:w-auto">Login</a>
                <a href="/Account/Register" class="hidden lg:flex px-6 py-2.5 text-sm font-semibold bg-primary text-white rounded-xl lg:rounded-full shadow-md shadow-primary/20 hover:opacity-90 transition-all text-center w-full lg:w-auto">Register</a>
            }
            else
            {
                var userRole = Context.Request.Cookies["UserRole"] ?? "User";
                <div class="flex flex-col lg:flex-row lg:items-center gap-4 lg:gap-3 lg:pl-4 lg:border-l border-slate-200 w-full lg:w-auto">
                    
                    @if (userRole.Equals("instructor", StringComparison.OrdinalIgnoreCase))
                    {
                        var currentPath = Context.Request.Path.ToString().ToLower();
                        var isInstructorView = currentPath.StartsWith("/instructorcourse") || currentPath.StartsWith("/lesson");
                        
                        if (isInstructorView)
                        {
                            <a href="/" class="text-sm font-semibold text-slate-600 hover:text-primary transition-colors lg:mr-2 flex items-center gap-2 p-2 lg:p-0 rounded-lg hover:bg-slate-50 lg:hover:bg-transparent">
                                <span class="material-symbols-outlined text-[18px]">person</span>
                                Switch to Learner
                            </a>
                        }
                        else
                        {
                            <a href="/InstructorCourse" class="text-sm font-semibold text-primary hover:text-primary/80 transition-colors lg:mr-2 flex items-center gap-2 p-2 lg:p-0 rounded-lg hover:bg-slate-50 lg:hover:bg-transparent">
                                <span class="material-symbols-outlined text-[18px]">school</span>
                                Switch to Instructor
                            </a>
                        }
                        <div class="hidden lg:block w-px h-6 bg-slate-200 mx-2"></div>
                        <div class="lg:hidden h-px w-full bg-slate-100 my-1"></div>
                    }
                    else if (!userRole.Equals("admin", StringComparison.OrdinalIgnoreCase) && !userRole.Equals("staff", StringComparison.OrdinalIgnoreCase))
                    {
                        @* 🎓 Become Instructor Button — only show for Learner (role = User) *@
                        <a href="/Instructor/Apply"
                           class="inline-flex items-center justify-center lg:justify-start gap-1.5 px-4 py-2.5 lg:py-2 text-xs font-bold text-white bg-gradient-to-r from-primary to-secondary rounded-xl lg:rounded-full shadow-md shadow-primary/20 hover:shadow-lg hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 w-full lg:w-auto">
                            <span class="material-symbols-outlined text-[16px]" style='font-variation-settings: "FILL" 1;'>school</span>
                            Become an Instructor
                        </a>
                        <div class="hidden lg:block w-px h-6 bg-slate-200 mx-2"></div>
                        <div class="lg:hidden h-px w-full bg-slate-100 my-1"></div>
                    }

                    @if (!userRole.Equals("admin", StringComparison.OrdinalIgnoreCase) && !userRole.Equals("staff", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-start gap-2 w-full lg:w-auto">
                            @* 🛒 SHOPPING CART mini-dropdown *@
                            <div class="relative flex-1 lg:flex-none" id="cart-dropdown">
                                <button onclick="toggleCart()"
                                        class="w-full lg:w-auto p-2.5 lg:p-2 text-slate-600 hover:bg-slate-100 bg-slate-50 lg:bg-transparent rounded-xl lg:rounded-full transition-colors relative flex justify-start lg:justify-center items-center">
                                    <span class="material-symbols-outlined text-[24px]" style='font-variation-settings:"FILL" 1;'>shopping_cart</span>
                                    <span class="lg:hidden ml-3 font-semibold text-sm">Cart</span>
                                    <span id="cart-badge"
                                          class="hidden absolute top-1 right-1 lg:right-1 lg:top-1 ml-4 lg:ml-0 min-w-[18px] h-[18px] px-1 bg-red-500 text-white text-[10px] font-bold flex items-center justify-center rounded-full border-2 border-white">
                                    </span>
                                </button>
    
                                <div id="cart-box"
                                     class="hidden lg:absolute right-0 mt-2 lg:mt-3 w-full lg:w-80 bg-white rounded-xl lg:rounded-2xl shadow-xl border border-slate-100 overflow-hidden z-[60]">
                                    <div class="p-4 border-b border-slate-50 flex justify-between items-center bg-slate-50/50">
                                        <span class="font-bold text-slate-800 text-sm">Shopping Cart</span>
                                        <a href="/Cart" class="text-[11px] text-primary font-bold hover:underline">View All</a>
                                    </div>
    
                                    <div id="cart-items-container" class="max-h-64 lg:max-h-72 overflow-y-auto">
                                        <div class="p-4 text-center text-slate-400 text-xs">Loading...</div>
                                    </div>
    
                                    <div class="p-3 border-t border-slate-100">
                                        <a href="/Cart"
                                           class="flex items-center justify-center gap-2 w-full py-2.5 bg-gradient-to-r from-primary to-secondary text-white text-xs font-bold rounded-xl hover:shadow-md transition-all">
                                            <span class="material-symbols-outlined text-sm">shopping_cart_checkout</span>
                                            Go to Cart
                                        </a>
                                    </div>
                                </div>
                            </div>
    
                            @* 📚 MY COURSES ICON *@
                            <a href="/Course/MyCourses" class="flex-1 lg:flex-none p-2.5 lg:p-2 flex justify-start lg:justify-center items-center text-slate-600 hover:bg-slate-100 bg-slate-50 lg:bg-transparent rounded-xl lg:rounded-full transition-colors relative group" title="My Learning">
                                <span class="material-symbols-outlined text-[24px]">school</span>
                                <span class="lg:hidden ml-3 font-semibold text-sm">My Learning</span>
                            </a>
    
                            @* ❤️ WISHLIST ICON *@
                            <a href="/Wishlist" class="flex-1 lg:flex-none p-2.5 lg:p-2 flex justify-start lg:justify-center items-center text-slate-600 hover:bg-slate-100 bg-slate-50 lg:bg-transparent rounded-xl lg:rounded-full transition-colors relative group" title="My Wishlist">
                                <span class="material-symbols-outlined text-[24px]">favorite</span>
                                <span class="lg:hidden ml-3 font-semibold text-sm">Wishlist</span>
                                <span id="wishlist-badge"
                                      class="hidden absolute top-1 right-1 lg:right-1 lg:top-1 ml-4 lg:ml-0 min-w-[18px] h-[18px] px-1 bg-red-500 text-white text-[10px] font-bold flex items-center justify-center rounded-full border-2 border-white">
                                </span>
                            </a>
    
                            @* 💬 CHAT ICON *@
                            <a href="/Chat/Learner" class="flex-1 lg:flex-none p-2.5 lg:p-2 flex justify-start lg:justify-center items-center text-slate-600 hover:bg-slate-100 bg-slate-50 lg:bg-transparent rounded-xl lg:rounded-full transition-colors relative group" title="Messages">
                                <span class="material-symbols-outlined text-[24px]">chat_bubble</span>
                                <span class="lg:hidden ml-3 font-semibold text-sm">Messages</span>
                                <span class="absolute top-2 right-1/4 lg:right-2 w-2 h-2 bg-indigo-500 rounded-full border-2 border-white"></span>
                            </a>
                        </div>
                    }

                    @if (!hideHeaderElements)
                    {
                        <div class="relative w-full lg:w-auto mt-2 lg:mt-0" id="notification-dropdown">
                            <button onclick="toggleNoti()" class="w-full lg:w-auto p-2.5 lg:p-2 flex justify-start lg:justify-center items-center text-slate-600 hover:bg-slate-100 bg-slate-50 lg:bg-transparent rounded-xl lg:rounded-full transition-colors relative">
                                <span class="material-symbols-outlined text-[24px]">notifications</span>
                                <span class="lg:hidden ml-3 font-semibold text-sm">Notifications</span>
                                <span id="noti-badge" class="hidden absolute top-2 right-1/2 -mr-3 lg:mr-0 lg:right-2 w-2.5 h-2.5 bg-red-500 rounded-full border-2 border-white"></span>
                            </button>

                            <div id="noti-box" class="hidden lg:absolute right-0 mt-2 lg:mt-3 w-full lg:w-80 bg-white rounded-xl lg:rounded-2xl shadow-xl border border-slate-100 overflow-hidden z-[60]">
                                <div class="p-4 border-b border-slate-50 flex justify-between items-center bg-slate-50/50">
                                    <span class="font-bold text-slate-800 text-sm">Notifications</span>
                                    <a href="/Notification" class="text-[11px] text-primary font-bold hover:underline">View All</a>
                                </div>
                                <div id="notification-items-container" class="max-h-64 lg:max-h-80 overflow-y-auto">
                                    <div class="p-4 text-center text-slate-400 text-xs">Loading...</div>
                                </div>
                            </div>
                        </div>
                    }
                    
                    <div class="lg:hidden h-px w-full bg-slate-100 my-2"></div>

                    @{
                        var profileHref = isStaffOrAdmin ? "/AdminProfile" : "/Account/Profile";
                    }
                    <div class="hidden lg:flex items-center justify-between lg:justify-end gap-3 w-full lg:w-auto px-2 lg:px-0 mt-2 lg:mt-0">
                        <a href="@profileHref" class="hover:scale-105 transition-all order-1 lg:order-2" title="Profile">
                            @await Html.PartialAsync("_UserAvatar", new { 
                                Url = avatarUrl, 
                                Role = userRole, 
                                Name = userName, 
                                Size = "md"
                            })
                        </a>
                        <div class="flex flex-col items-start lg:items-end order-2 lg:order-1">
                            <span class="text-sm lg:text-xs font-bold text-slate-700">Hi, @userName</span>
                            @* POST logout to revoke refresh token on BE (more secure than GET) *@
                            <form id="global-logout-form-desktop" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="text-xs lg:text-[10px] text-red-500 hover:underline font-medium bg-transparent border-none p-0 cursor-pointer">Logout</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
            </div>
        </aside>
    </div>
</nav>

<script>
    function toggleMainSidebar() {
        const sidebar = document.getElementById('mainMobileSidebar');
        const overlay = document.getElementById('mainSidebarOverlay');
        
        if (sidebar.classList.contains('-translate-x-full')) {
            // Open
            sidebar.classList.remove('-translate-x-full');
            overlay.classList.remove('hidden');
            setTimeout(() => overlay.classList.remove('opacity-0'), 10);
        } else {
            // Close
            sidebar.classList.add('-translate-x-full');
            overlay.classList.add('opacity-0');
            setTimeout(() => overlay.classList.add('hidden'), 300);
        }
    }

    // ─── DROPDOWNS MANAGEMENT ───
    function toggleCategories() {
        const box = document.getElementById('categories-box');
        const isHidden = box.classList.contains('hidden');
        closeAllDropdowns();
        if (isHidden) {
            box.classList.remove('hidden');
            loadCategories();
        }
    }

    function toggleCart() {
        if (window.innerWidth < 1024) {
            window.location.href = '/Cart';
            return;
        }
        const box = document.getElementById('cart-box');
        const isHidden = box.classList.contains('hidden');
        closeAllDropdowns();
        if (isHidden) {
            box.classList.remove('hidden');
            loadCartPreview();
        }
    }

    function toggleNoti() {
        if (window.innerWidth < 1024) {
            window.location.href = '/Notification';
            return;
        }
        const box = document.getElementById('noti-box');
        const isHidden = box.classList.contains('hidden');
        closeAllDropdowns();
        if (isHidden) {
            box.classList.remove('hidden');
            document.getElementById('noti-badge').classList.add('hidden');
        }
    }

    function closeAllDropdowns() {
        document.getElementById('categories-box')?.classList.add('hidden');
        document.getElementById('cart-box')?.classList.add('hidden');
        document.getElementById('noti-box')?.classList.add('hidden');
    }

    window.addEventListener('click', function(e) {
        if (!document.getElementById('categories-dropdown')?.contains(e.target)) 
            document.getElementById('categories-box')?.classList.add('hidden');
        if (!document.getElementById('cart-dropdown')?.contains(e.target)) 
            document.getElementById('cart-box')?.classList.add('hidden');
        if (!document.getElementById('notification-dropdown')?.contains(e.target)) 
            document.getElementById('noti-box')?.classList.add('hidden');
    });

    // ─── DATA LOADING ───
    const cartApiUrl = "/Cart/GetSummaryAjax";
    const headerToken = `@Html.Raw(Context.Request.Cookies["AccessToken"] ?? "")`;

    async function loadCartPreview() {
        const container = document.getElementById('cart-items-container');
        const badge    = document.getElementById('cart-badge');
        if (!container || !headerToken) return;

        try {
            const res = await fetch(cartApiUrl, {
                headers: { 'Authorization': `Bearer ${headerToken}` }
            });
            if (!res.ok) return;
            const result = await res.json();
            const items  = result?.data?.items ?? [];

            if (items.length > 0) {
                badge.textContent = items.length > 9 ? '9+' : items.length;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }

            if (items.length === 0) {
                container.innerHTML = `
                    <div class="py-8 flex flex-col items-center gap-2 text-slate-400">
                        <span class="material-symbols-outlined text-4xl text-slate-200">shopping_cart</span>
                        <p class="text-xs">Your cart is empty</p>
                    </div>`;
                return;
            }

            container.innerHTML = items.map(item => `
                <a href="/Course/Details/${item.courseId}"
                   class="flex items-center gap-3 px-4 py-3 hover:bg-emerald-50/50 transition-colors border-b border-slate-50 last:border-0">
                    ${ item.thumbnailUrl
                        ? `<img src="${item.thumbnailUrl}" onerror="this.onerror=null; this.src='/img/default-course.png';" alt="${item.title}"
                               class="w-14 h-10 object-cover rounded-lg shrink-0 bg-slate-100" loading="lazy" />`
                        : `<img src="/img/default-course.png" alt="${item.title}"
                               class="w-14 h-10 object-cover rounded-lg shrink-0 bg-slate-100" loading="lazy" />`
                    }
                    <div class="flex-1 min-w-0">
                        <p class="text-xs font-semibold text-slate-800 line-clamp-2 leading-snug">${item.title}</p>
                        <p class="text-xs font-bold text-primary mt-1">$ ${item.price.toLocaleString('en-US')}</p>
                    </div>
                </a>`).join('');
        } catch (err) { }
    }

    async function initCartBadge() {
        const badge = document.getElementById('cart-badge');
        if (!badge || !headerToken) return;
        try {
            const res = await fetch(cartApiUrl, { headers: { 'Authorization': `Bearer ${headerToken}` } });
            if (res.ok) {
                const result = await res.json();
                const count  = result?.data?.items?.length ?? 0;
                if (count > 0) {
                    badge.textContent = count > 9 ? '9+' : count;
                    badge.classList.remove('hidden');
                } else {
                    badge.classList.add('hidden');
                }
            }
        } catch { }
    }

    async function loadCategories() {
        const container = document.getElementById('categories-items-container');
        if (!container) return;
        try {
            const res = await fetch("/api/public/courses/categories");
            if (!res.ok) return;
            const result = await res.json();
            const categories = result?.data ?? [];
            if (categories.length === 0) {
                container.innerHTML = `<div class="px-4 py-3 text-xs text-slate-400">No categories found</div>`;
                return;
            }
            container.innerHTML = categories.map(cat => `
                <a href="/Course?category=${encodeURIComponent(cat.categoriesName)}" 
                   class="flex items-center justify-between px-6 py-3 hover:bg-slate-50 transition-colors group">
                    <span class="text-sm font-medium text-slate-700 group-hover:text-primary transition-colors">${cat.categoriesName}</span>
                    <span class="material-symbols-outlined text-[18px] text-slate-300 group-hover:text-primary transition-transform group-hover:translate-x-1">chevron_right</span>
                </a>
            `).join('');
        } catch (err) { }
    }

    async function updateWishlistBadge() {
        const badge = document.getElementById('wishlist-badge');
        if (!badge || !headerToken) return;
        try {
            const res = await fetch("/api/Wishlist/count", {
                headers: { 'Authorization': `Bearer ${headerToken}` }
            });
            if (!res.ok) return;
            const data = await res.json();
            if (data.count > 0) {
                badge.textContent = data.count > 9 ? '9+' : data.count;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }
        } catch { }
    }

    // ─── REAL-TIME GLOBAL SEARCH BAR DROP-DOWN ───
    const searchInput = document.getElementById('header-search-input');
    const searchResults = document.getElementById('header-search-results');
    const resultsList = document.getElementById('header-search-results-list');
    const keywordHighlight = document.getElementById('search-keyword-highlight');
    let searchDebounceTimer;

    if (searchInput) {
        searchInput.addEventListener('input', (e) => {
            clearTimeout(searchDebounceTimer);
            const query = e.target.value.trim();

            if (query.length < 2) {
                searchResults.classList.add('hidden');
                return;
            }

            keywordHighlight.textContent = query;

            searchDebounceTimer = setTimeout(async () => {
                try {
                    const res = await fetch(`/Course/SearchCoursesJson?query=${encodeURIComponent(query)}`);
                    const result = await res.json();
                    
                    if (result.success && result.data && result.data.length > 0) {
                        searchResults.classList.remove('hidden');
                        
                        resultsList.innerHTML = result.data.map(c => {
                            // Highlight keyword
                            const regex = new RegExp(`(${query})`, 'gi');
                            const highlightedTitle = c.title.replace(regex, '<span class="text-[#a435f0] font-extrabold">$1</span>');
                            
                            const priceDisplay = c.price === 0 
                                ? '<span class="text-emerald-700 font-bold uppercase text-[11px] bg-emerald-50 border border-emerald-100 px-2.5 py-1 rounded-full shrink-0">Free</span>' 
                                : `<span class="text-[#a435f0] font-extrabold text-[11px] bg-[#a435f0]/5 border border-[#a435f0]/10 px-2.5 py-1 rounded-full shrink-0">$${c.price.toFixed(2)}</span>`;
                            
                            return `
                                <a href="/Course/Details/${c.courseId}" 
                                   class="flex items-center gap-4 px-5 py-3.5 hover:bg-slate-50/80 hover:pl-6 transition-all duration-300 group">
                                    <img src="${c.courseThumbnailUrl || '/img/default-course.png'}" 
                                         onerror="this.onerror=null; this.src='/img/default-course.png';"
                                         class="w-14 h-10 object-cover rounded-lg border border-slate-100 group-hover:scale-105 transition-all duration-300 shrink-0" />
                                    <div class="flex-1 min-w-0">
                                        <h4 class="text-sm font-bold text-slate-800 line-clamp-1 group-hover:text-[#a435f0] transition-colors leading-snug">${highlightedTitle}</h4>
                                        <p class="text-xs text-slate-500 mt-0.5 flex items-center gap-1.5">
                                            <span class="font-medium text-slate-600 truncate">${c.instructorName}</span>
                                            <span class="text-slate-300">•</span>
                                            <span class="flex items-center text-amber-500 gap-0.5">
                                                <span class="material-symbols-outlined text-[12px] fill-1">star</span>
                                                <span class="font-bold text-[11px]">${c.ratingAverage.toFixed(1)}</span>
                                            </span>
                                        </p>
                                    </div>
                                    <div class="text-right shrink-0">
                                        ${priceDisplay}
                                    </div>
                                </a>
                            `;
                        }).join('');
                    } else {
                        searchResults.classList.remove('hidden');
                        resultsList.innerHTML = `
                            <div class="p-8 text-center text-slate-400 flex flex-col items-center gap-2">
                                <span class="material-symbols-outlined text-3xl opacity-30">search_off</span>
                                <p class="text-xs">No matching courses found</p>
                            </div>
                        `;
                    }
                } catch (err) {
                    console.error("Error searching courses:", err);
                }
            }, 300);
        });

        // Close dropdown when clicking outside
        window.addEventListener('click', (e) => {
            if (!document.getElementById('header-search-container')?.contains(e.target)) {
                searchResults.classList.add('hidden');
            }
        });

        // Show again on focus if query has length
        searchInput.addEventListener('focus', () => {
            if (searchInput.value.trim().length >= 2) {
                searchResults.classList.remove('hidden');
            }
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        initCartBadge();
        updateWishlistBadge();
    });

    document.addEventListener('cartUpdated', () => {
        initCartBadge();
        loadCartPreview();
    });
</script>