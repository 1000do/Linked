@{
    ViewData["Title"] = "Contact Us - LinkedLearn";
}

<section class="py-16 md:py-24 bg-slate-50 min-h-[60vh]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">Contact Us</h1>
            <p class="text-lg text-slate-600">Get in touch with the LinkedLearn Project Team.</p>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8 md:p-12 text-center">
            <div class="w-16 h-16 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center mx-auto mb-6">
                <span class="material-symbols-outlined text-3xl">mail</span>
            </div>
            <h2 class="text-2xl font-bold text-slate-900 mb-4">Email Us</h2>
            <p class="text-slate-600 mb-8">If you have any questions, feedback, or need support, please reach out to our official email address.</p>
            <a href="mailto:coursemarketplace.official@gmail.com" class="text-xl font-bold text-emerald-600 hover:text-emerald-700 hover:underline transition-colors">
                coursemarketplace.official@gmail.com
            </a>
        </div>
    </div>
</section>
