@{
    ViewData["Title"] = "About Us - LinkedLearn";
}

<section class="py-16 md:py-24 bg-slate-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-6">About Us</h1>
        <div class="prose prose-slate lg:prose-lg max-w-none text-slate-700">
            <p class="lead text-xl text-slate-600 mb-8">
                LinkedLearn is a centralized platform connecting course creators and users, enabling seamless course creation, enrollment, and learning progress management.
            </p>

            <h2 class="text-2xl font-bold text-slate-900 mt-12 mb-4">Our Mission</h2>
            <p>
                The rapid growth of online learning has created a strong demand for flexible platforms where instructors can easily publish courses and users can conveniently access high-quality educational content. LinkedLearn was created to address this demand. We aim to provide an integrated environment where instructors can manage their courses effectively, and users can browse, purchase, and study courses seamlessly.
            </p>

            <h2 class="text-2xl font-bold text-slate-900 mt-12 mb-4">Our Vision</h2>
            <p>
                We empower independent instructors, training centers, and individuals to commercialize educational content while giving self-learners and professionals the tools they need to improve their knowledge and skills through a trustworthy, modern online learning environment.
            </p>
        </div>
    </div>
</section>
