@model CourseMarketplaceFE.Models.PagedResult<CourseMarketplaceFE.Models.ReviewModerationRecordViewModel>
@using CourseMarketplaceFE.Models

@if (Model != null && Model.Items != null && Model.Items.Any())
{
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 border-b border-slate-100">
                    <th class="py-3 px-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Author</th>
                    <th class="py-3 px-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Review Comment</th>
                    <th class="py-3 px-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Rating</th>
                    <th class="py-3 px-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Course</th>
                    <th class="py-3 px-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Last Modified</th>
                    <th class="py-3 px-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Threat Level</th>
                    <th class="py-3 px-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Status</th>
                    <th class="py-3 px-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Action</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var record in Model.Items)
                {
                    <tr class="hover:bg-slate-50/50 transition-colors group cursor-pointer" onclick="openDetailsModal(@System.Text.Json.JsonSerializer.Serialize(record))">
                        <td class="py-4 px-4 align-top">
                            <p class="font-bold text-slate-900 text-sm">@record.Username</p>
                            <p class="text-xs text-slate-500">@record.Email</p>
                        </td>
                        <td class="py-4 px-4 align-top max-w-[200px]">
                            @if(record.IsUpdate) {
                                <p class="text-xs font-semibold text-indigo-600 mb-1">Update Edit</p>
                            } else {
                                <p class="text-xs font-semibold text-emerald-600 mb-1">New Review</p>
                            }
                            <p class="text-sm text-slate-800 truncate" title="@record.TempComment">New: @record.TempComment</p>
                            @if (record.IsUpdate)
                            {
                                <p class="text-xs text-slate-500 truncate mt-1 line-through" title="@record.OriginalComment">Cur: @record.OriginalComment</p>
                            }
                        </td>
                        <td class="py-4 px-4 align-top">
                            <div class="flex items-center gap-1 text-amber-500 mb-1 text-xs">
                                <span class="font-semibold text-slate-800 mr-1">New:</span>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span class="material-symbols-outlined text-[12px] @(i <= record.TempRating ? "fill-current" : "text-slate-300")">star</span>
                                }
                            </div>
                            @if (record.IsUpdate && record.OriginalRating.HasValue)
                            {
                                <div class="flex items-center gap-1 text-slate-400 text-xs">
                                    <span class="font-semibold text-slate-500 mr-1">Cur:</span>
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="material-symbols-outlined text-[12px] @(i <= record.OriginalRating.Value ? "fill-current" : "text-slate-300")">star</span>
                                    }
                                </div>
                            }
                        </td>
                        <td class="py-4 px-4 align-top max-w-[150px]">
                            <p class="text-sm font-semibold text-slate-800 truncate" title="@record.CourseTitle">@record.CourseTitle</p>
                        </td>
                        <td class="py-4 px-4 align-top">
                            <p class="text-sm font-medium text-slate-700">@record.UpdatedAt.ToString("dd/MM/yyyy")</p>
                            <p class="text-xs text-slate-500">@record.UpdatedAt.ToString("HH:mm")</p>
                        </td>
                        <td class="py-4 px-4 align-top">
                            @{
                                string aiBadgeClass = "bg-slate-100 text-slate-600";
                                string aiStatusStr = record.AiModerationStatus?.ToLower();
                                string aiDisplayLabel = "PENDING";
                                if (aiStatusStr == "flagged") { aiBadgeClass = "bg-rose-100 text-rose-700"; aiDisplayLabel = "SEVERE"; }
                                else if (aiStatusStr == "manual_audit") { aiBadgeClass = "bg-amber-100 text-amber-700"; aiDisplayLabel = "MODERATE"; }
                                else if (aiStatusStr == "approved") { aiBadgeClass = "bg-emerald-100 text-emerald-700"; aiDisplayLabel = "CLEAN"; }
                            }
                            <span class="inline-flex px-2 py-1 rounded-md text-xs font-bold @aiBadgeClass">
                                @aiDisplayLabel
                            </span>
                        </td>
                        <td class="py-4 px-4 align-top">
                            @{
                                string modStatusStr = record.ModerationStatus?.ToLower();
                                string modBadgeClass = "bg-slate-100 text-slate-600";
                                if (modStatusStr == "rejected") { modBadgeClass = "bg-rose-100 text-rose-700"; }
                                else if (modStatusStr == "approved") { modBadgeClass = "bg-emerald-100 text-emerald-700"; }
                                else if (modStatusStr == "pending") { modBadgeClass = "bg-amber-100 text-amber-700"; }
                            }
                            <span class="inline-flex px-2 py-1 rounded-md text-xs font-bold @modBadgeClass">
                                @record.ModerationStatus?.ToUpper()
                            </span>
                        </td>
                        <td class="py-4 px-4 align-top">
                            <div class="flex flex-col gap-2" onclick="event.stopPropagation()">
                                @if (record.ModerationStatus?.ToLower() == "pending")
                                {
                                    <button type="button" onclick="confirmResolve(@record.RecordId, 'course', 'approve')" class="bg-emerald-500 text-white hover:bg-emerald-600 py-1.5 px-3 rounded-lg text-xs font-bold transition-colors flex items-center justify-center gap-1">
                                        <span class="material-symbols-outlined text-[14px]">check</span> Approve
                                    </button>
                                    <button type="button" onclick="confirmResolve(@record.RecordId, 'course', 'reject')" class="bg-rose-500 text-white hover:bg-rose-600 py-1.5 px-3 rounded-lg text-xs font-bold transition-colors flex items-center justify-center gap-1">
                                        <span class="material-symbols-outlined text-[14px]">close</span> Reject
                                    </button>
                                }
                                else
                                {
                                    <button type="button" onclick="openDetailsModal(@System.Text.Json.JsonSerializer.Serialize(record))" class="bg-slate-100 text-slate-600 hover:bg-slate-200 hover:text-slate-900 py-1.5 px-3 rounded-lg text-xs font-bold transition-colors flex items-center justify-center gap-1">
                                        <span class="material-symbols-outlined text-[14px]">visibility</span> View
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="mt-6 flex flex-col sm:flex-row justify-between items-center px-4">
        <span class="text-sm font-medium text-slate-600 mb-4 sm:mb-0">
            Showing @(((Model.Page - 1) * Model.PageSize) + 1) to @(Math.Min(Model.Page * Model.PageSize, Model.TotalCount)) items of @Model.TotalCount
        </span>
        <nav class="flex items-center gap-2">
            @if (Model.Page > 1)
            {
                <button type="button" onclick="changePage(@(Model.Page - 1))" class="w-8 h-8 rounded-full border border-slate-200 flex items-center justify-center text-slate-600 hover:bg-slate-50 transition-colors">
                    <span class="material-symbols-outlined text-sm">chevron_left</span>
                </button>
            }
            <span class="text-sm font-bold text-indigo-700 bg-indigo-50 w-8 h-8 rounded-full flex items-center justify-center">
                @Model.Page
            </span>
            @if (Model.Page * Model.PageSize < Model.TotalCount)
            {
                <button type="button" onclick="changePage(@(Model.Page + 1))" class="w-8 h-8 rounded-full border border-slate-200 flex items-center justify-center text-slate-600 hover:bg-slate-50 transition-colors">
                    <span class="material-symbols-outlined text-sm">chevron_right</span>
                </button>
            }
        </nav>
    </div>
}
else
{
    <div class="py-12 text-center">
        <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-3">
            <span class="material-symbols-outlined text-slate-300 text-3xl">inbox</span>
        </div>
        <h3 class="text-lg font-bold text-slate-800 mb-1">No Records Found</h3>
        <p class="text-sm text-slate-500">There are no course review records matching your filters.</p>
    </div>
}
